      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#15",
      "node_id": 600016,
      "source": "Oliver Caldwynne\n\"His victories surpassed his years.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#16",
      "node_id": 600017,
      "source": "\"The battle of Sar Sargoth was fought here.  Let all who visit this place remember the strength and courage of our ancestors. May their legacy stand forever. \"\u0000",
      "tokens": [
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#17",
      "node_id": 600018,
      "source": "Gorath of the Greenheart Clan\n\"His death was slow and torturous.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#18",
      "node_id": 600019,
      "source": "Owyn Belleforte\n\"His luck finally ran out.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#19",
      "node_id": 600020,
      "source": "Gorath of the Greenheart Clan\n\"A traitor to his people.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#20",
      "node_id": 600021,
      "source": "Gorath of the Greenheart Clan\n\"He died on his knees.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#21",
      "node_id": 600022,
      "source": "Owyn Belleforte\n\"Called himself a magician.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#22",
      "node_id": 600023,
      "source": "Gorath of the Greenheart Clan\n\"Betrayed his people. Choked to death on his own blood.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#23",
      "node_id": 600024,
      "source": "Owyn Belleforte\n\"Merely a pawn in a grand game.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#24",
      "node_id": 600025,
      "source": "Gorath of the Greenheart Clan\n\"Delekhan ran him through.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {
      "id": "DIAL_Z06.DDX#25",
      "node_id": 600026,
      "source": "Gorath of the Greenheart Clan\n\"His human blood made him weak.\"\u0000",
      "tokens": [
        "\\x0a",
        "\\x00"
      ],
      "translation": "",
      "status": "untranslated",
      "notes": ""
    },
    {

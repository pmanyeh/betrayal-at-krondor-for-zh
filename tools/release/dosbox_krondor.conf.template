[dosbox]
# Krondor consumes raw keyboard scancodes. Host IME composition can swallow
# ENTER/key-up and mouse events until the DOSBox-X window loses focus.
ime=false

[sdl]
windowresolution=1280x800
output=opengl
# Lock after the first click so FPS mouse-look keeps receiving relative motion
# at the edge of the rendered 4:3 image. Ctrl+F10 releases the host pointer.
autolock=true
autolock_feedback=none
mouse_emulation=locked

[render]
aspect=true
scaler=none

[cpu]
core=normal
# DOSBox-X 2026.08.02 dropped the older "486_slow" cputype name that
# dist/dosbox_zh_test.conf was originally tested against; 486_prefetch is the
# closest still-supported equivalent (486-class timing, not the fastest core).
cputype=486_prefetch
cycles=12000

[sblaster]
sbtype=sbpro2
sbbase=220
irq=7
dma=1

[dos]
dos=high,umb

[autoexec]
@mount c ../game_data
@c:
@krondor.exe

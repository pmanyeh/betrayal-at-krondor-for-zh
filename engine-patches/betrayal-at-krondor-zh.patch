+/* Corner brackets stay legible over both bright and dark scenery while
+   obscuring much less of the original 320x200 artwork than solid boxes. */
+void uiwidget_hotspot_outline_draw(int x, int y, int w, int h, int color) {
+    int x2;
+    int y2;
+    int arm;
+    unsigned char savedClip;
+    ClipRect savedClipRect;
+    unsigned char savedOutlineColor;
+
+    if (w <= 0 || h <= 0)
+        return;
+    x2 = x + w - 1;
+    y2 = y + h - 1;
+    if (x2 < 0 || y2 < 0 || x >= (int)g_wScreen_width || y >= (int)g_wScreen_height)
+        return;
+    if (x < 0)
+        x = 0;
+    if (y < 0)
+        y = 0;
+    if (x2 >= (int)g_wScreen_width)
+        x2 = g_wScreen_width - 1;
+    if (y2 >= (int)g_wScreen_height)
+        y2 = g_wScreen_height - 1;
+    arm = 5;
+    if (x2 - x < arm * 2)
+        arm = (x2 - x + 1) / 2;
+    if (y2 - y < arm * 2 && (y2 - y + 1) / 2 < arm)
+        arm = (y2 - y + 1) / 2;
+    if (arm < 1)
+        arm = 1;
+
+    savedClip = g_graphics_context.bClip_enabled;
+    savedClipRect = g_graphics_context.clip;
+    savedOutlineColor = g_graphics_context.bGfx_outline_color;
+    g_graphics_context.bClip_enabled = 1;
+    g_graphics_context.clip.xmin = 0;
+    g_graphics_context.clip.ymin = 0;
+    g_graphics_context.clip.xmax = g_wScreen_width - 1;
+    g_graphics_context.clip.ymax = g_wScreen_height - 1;
+
+    g_graphics_context.bGfx_outline_color = 0;
+    draw_line(x + 1, y + 1, x + arm + 1, y + 1);
+    draw_line(x + 1, y + 1, x + 1, y + arm + 1);
+    draw_line(x2 - arm + 1, y + 1, x2, y + 1);
+    draw_line(x2, y + 1, x2, y + arm + 1);
+    draw_line(x + 1, y2, x + arm + 1, y2);
+    draw_line(x + 1, y2 - arm + 1, x + 1, y2);
+    draw_line(x2 - arm + 1, y2, x2, y2);
+    draw_line(x2, y2 - arm + 1, x2, y2);
+
+    g_graphics_context.bGfx_outline_color = (unsigned char)color;
+    draw_line(x, y, x + arm, y);
+    draw_line(x, y, x, y + arm);
+    draw_line(x2 - arm, y, x2, y);
+    draw_line(x2, y, x2, y + arm);
+    draw_line(x, y2, x + arm, y2);
+    draw_line(x, y2 - arm, x, y2);
+    draw_line(x2 - arm, y2, x2, y2);
+    draw_line(x2, y2 - arm, x2, y2);
+
+    g_graphics_context.bGfx_outline_color = savedOutlineColor;
+    g_graphics_context.clip = savedClipRect;
+    g_graphics_context.bClip_enabled = savedClip;
+}

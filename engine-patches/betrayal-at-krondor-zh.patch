--- a/bak/INCLUDE/gfx169d.h
+++ b/bak/INCLUDE/gfx169d.h
@@ -1,16 +1,21 @@
 #ifndef GFX169D_H
 #define GFX169D_H
 
+#include <dos.h>
+
 extern unsigned char far g_abCursorPaletteLut[256];
 
 extern unsigned char far g_abFogRemapTable[2560];
 
-#ifdef V102CD
-#define FOG_REMAP_TAB_OFF 0x66
-#define CURSOR_REMAP_TAB_OFF 0xa66
-#else
-#define FOG_REMAP_TAB_OFF 0x5c
-#define CURSOR_REMAP_TAB_OFF 0xa5c
-#endif
+/*
+ * POLYRAST.ASM indexes these CS-resident tables with a near offset.  Their
+ * offsets were historically constant in the shipped 1.00/1.02 link layouts,
+ * but TLINK is free to choose a different paragraph frame after any resident
+ * code-size change.  Use the linker's far-symbol fixup instead of baking the
+ * original offsets into every caller; FP_OFF still folds to the original
+ * constants in byte-identical builds.
+ */
+#define FOG_REMAP_TAB_OFF FP_OFF(&g_abFogRemapTable[0])
+#define CURSOR_REMAP_TAB_OFF FP_OFF(&g_abCursorPaletteLut[0])
 
 #endif

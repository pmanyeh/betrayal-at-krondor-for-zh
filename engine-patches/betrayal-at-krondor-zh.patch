diff --git a/bak/SRC/DIALOG/MSGLOG.C b/bak/SRC/DIALOG/MSGLOG.C
new file mode 100644
index 0000000000000000000000000000000000000000..f56faa22dbdcd163d85fbecf2c22c6054e9cb484
--- /dev/null
+++ b/bak/SRC/DIALOG/MSGLOG.C
@@ -0,0 +1,1527 @@
+/**
+ * @file  MSGLOG.C
+ * @brief Message-log (.MLG) v1 data core. See MSGLOG.H for the contract and
+ *        docs/research/message-log-format.md (main repo) for the byte layout.
+ *
+ * Implementation notes
+ * --------------------
+ *  * Every integer goes to disk field by field through put_u16/put_u32 into a
+ *    byte array. No C struct is ever written, so 16-bit packing and pointer
+ *    size never leak into the format.
+ *  * Resident cost is deliberately tiny: a handful of scalars plus the 64-byte
+ *    CRC nibble table. There is no persistent buffer -- the append path streams
+ *    the caller's strings straight to the file handle, and the two block
+ *    operations (snapshot copy, whole-history CRC) borrow a caller-owned
+ *    scratch block that the caller can free again the moment they return.
+ *  * Far/huge string walks use huge pointers so a span that starts near the top
+ *    of a segment cannot wrap its offset.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <io.h>
+
+#include "SRC/DIALOG/MSGLOG.H"
+#include "SRC/IO/DOSRW.H"
+
+/* Borland open() flags: O_RDONLY 1, O_WRONLY 2, O_RDWR 4, O_CREAT 0x100,
+   O_TRUNC 0x200, O_BINARY 0x8000 (the same literals SAVEGAME.C uses). */
+#define MSGLOG_O_RDONLY 0x8001
+#define MSGLOG_O_RDWR 0x8004
+#define MSGLOG_O_CREATE 0x8304
+#define MSGLOG_S_RW 0x0180
+
+#define MSGLOG_SEEK_SET 0
+#define MSGLOG_SEEK_END 2
+
+/* ------------------------------------------------------------------ */
+/* Module state (the whole resident footprint)                         */
+/* ------------------------------------------------------------------ */
+
+static int g_mlgBaseState = MSGLOG_STATE_INACTIVE;
+static int g_mlgTransitionDepth = 0;
+static int g_mlgViewerDepth = 0;
+static int g_mlgConvDepth = 0;
+static int g_mlgLastError = MSGLOG_OK;
+
+static int g_mlgWorkFd = -1;
+static int g_mlgCandFd = -1;
+
+static unsigned short g_mlgFlags = 0;
+static long g_mlgCommitted = MSGLOG_HEADER_SIZE;
+static unsigned long g_mlgEventCount = 0;
+static unsigned long g_mlgNextSeq = 1;
+static long g_mlgLastOffset = 0;
+static unsigned long g_mlgConvId = 0;
+static MsgLogTime g_mlgCreated;
+
+/* Candidate metadata, filled by msglog_load_candidate(). */
+static long g_mlgCandCommitted = 0;
+static unsigned long g_mlgCandEvents = 0;
+static unsigned long g_mlgCandNextSeq = 1;
+static long g_mlgCandLastOffset = 0;
+static unsigned short g_mlgCandFlags = 0;
+static MsgLogTime g_mlgCandCreated;
+
+static unsigned char far *g_mlgScratch = NULL;
+static unsigned int g_mlgScratchLen = 0;
+
+/* CRC-32/ISO-HDLC, nibble-wise: 64 bytes of table instead of 1 KiB. */
+static unsigned long g_mlgCrcNibble[16] = {
+    0x00000000UL, 0x1DB71064UL, 0x3B6E20C8UL, 0x26D930ACUL,
+    0x76DC4190UL, 0x6B6B51F4UL, 0x4DB26158UL, 0x5005713CUL,
+    0xEDB88320UL, 0xF00F9344UL, 0xD6D6A3E8UL, 0xCB61B38CUL,
+    0x9B64C2B0UL, 0x86D3D2D4UL, 0xA00AE278UL, 0xBDBDF21CUL};
+
+/* ------------------------------------------------------------------ */
+/* Little-endian field primitives                                      */
+/* ------------------------------------------------------------------ */
+
+static void msglog_put_u16(unsigned char *p, unsigned int off, unsigned int v) {
+    p[off] = (unsigned char)(v & 0xff);
+    p[off + 1] = (unsigned char)((v >> 8) & 0xff);
+}
+
+static void msglog_put_u32(unsigned char *p, unsigned int off, unsigned long v) {
+    p[off] = (unsigned char)(v & 0xffUL);
+    p[off + 1] = (unsigned char)((v >> 8) & 0xffUL);
+    p[off + 2] = (unsigned char)((v >> 16) & 0xffUL);
+    p[off + 3] = (unsigned char)((v >> 24) & 0xffUL);
+}
+
+static unsigned int msglog_get_u16(const unsigned char *p, unsigned int off) {
+    return (unsigned int)p[off] | ((unsigned int)p[off + 1] << 8);
+}
+
+static unsigned long msglog_get_u32(const unsigned char *p, unsigned int off) {
+    return (unsigned long)p[off] | ((unsigned long)p[off + 1] << 8) |
+           ((unsigned long)p[off + 2] << 16) | ((unsigned long)p[off + 3] << 24);
+}
+
+unsigned long far msglog_crc32_update(unsigned long crc, const unsigned char huge *data,
+                                      unsigned int len) {
+    unsigned int i;
+    for (i = 0; i < len; i++) {
+        crc ^= (unsigned long)data[i];
+        crc = (crc >> 4) ^ g_mlgCrcNibble[(unsigned int)(crc & 0x0fUL)];
+        crc = (crc >> 4) ^ g_mlgCrcNibble[(unsigned int)(crc & 0x0fUL)];
+    }
+    return crc;
+}
+
+/** Same CRC over a DS-relative buffer -- avoids any near->huge pointer cast. */
+static unsigned long msglog_crc32_near(unsigned long crc, const unsigned char *data,
+                                       unsigned int len) {
+    unsigned int i;
+    for (i = 0; i < len; i++) {
+        crc ^= (unsigned long)data[i];
+        crc = (crc >> 4) ^ g_mlgCrcNibble[(unsigned int)(crc & 0x0fUL)];
+        crc = (crc >> 4) ^ g_mlgCrcNibble[(unsigned int)(crc & 0x0fUL)];
+    }
+    return crc;
+}
+
+/* ------------------------------------------------------------------ */
+/* State machine                                                       */
+/* ------------------------------------------------------------------ */
+
+void far msglog_init(void) {
+    g_mlgBaseState = MSGLOG_STATE_INACTIVE;
+    g_mlgTransitionDepth = 0;
+    g_mlgViewerDepth = 0;
+    g_mlgConvDepth = 0;
+    g_mlgLastError = MSGLOG_OK;
+    g_mlgWorkFd = -1;
+    g_mlgCandFd = -1;
+    g_mlgFlags = 0;
+    g_mlgCommitted = MSGLOG_HEADER_SIZE;
+    g_mlgEventCount = 0;
+    g_mlgNextSeq = 1;
+    g_mlgLastOffset = 0;
+    g_mlgConvId = 0;
+    g_mlgScratch = NULL;
+    g_mlgScratchLen = 0;
+    memset(&g_mlgCreated, 0, sizeof(g_mlgCreated));
+}
+
+int far msglog_set_scratch(unsigned char far *buf, unsigned int size) {
+    if (buf != NULL && size < MSGLOG_MIN_SCRATCH)
+        return MSGLOG_E_PARAM;
+    g_mlgScratch = buf;
+    g_mlgScratchLen = (buf != NULL) ? size : 0;
+    return MSGLOG_OK;
+}
+
+int far msglog_base_state(void) { return g_mlgBaseState; }
+
+int far msglog_state(void) {
+    /* FAILED outranks the suppression counters on purpose: a timeline that can
+       no longer record is a condition the player must be told about, and
+       leaving a viewer must never look like a return to healthy recording. */
+    if (g_mlgBaseState == MSGLOG_STATE_FAILED)
+        return MSGLOG_STATE_FAILED;
+    if (g_mlgViewerDepth > 0)
+        return MSGLOG_STATE_VIEWER;
+    if (g_mlgTransitionDepth > 0)
+        return MSGLOG_STATE_TRANSITION;
+    return g_mlgBaseState;
+}
+
+int far msglog_recording_enabled(void) {
+    return (g_mlgBaseState == MSGLOG_STATE_ACTIVE && g_mlgTransitionDepth == 0 &&
+            g_mlgViewerDepth == 0 && g_mlgWorkFd >= 0)
+               ? 1
+               : 0;
+}
+
+int far msglog_last_error(void) { return g_mlgLastError; }
+
+void far msglog_enter_transition(void) { g_mlgTransitionDepth++; }
+
+void far msglog_leave_transition(void) {
+    if (g_mlgTransitionDepth > 0)
+        g_mlgTransitionDepth--;
+}
+
+void far msglog_enter_viewer(void) { g_mlgViewerDepth++; }
+
+void far msglog_leave_viewer(void) {
+    if (g_mlgViewerDepth > 0)
+        g_mlgViewerDepth--;
+}
+
+unsigned long far msglog_conversation_id(void) { return g_mlgConvId; }
+
+unsigned long far msglog_event_count(void) { return g_mlgEventCount; }
+
+unsigned short far msglog_header_flags(void) { return g_mlgFlags; }
+
+static int msglog_fail(int code) {
+    g_mlgLastError = code;
+    g_mlgBaseState = MSGLOG_STATE_FAILED;
+    return code;
+}
+
+/* ------------------------------------------------------------------ */
+/* Header I/O                                                          */
+/* ------------------------------------------------------------------ */
+
+static void msglog_build_header(unsigned char *hdr, unsigned short flags, unsigned long gam_len,
+                                unsigned long gam_crc, long committed, unsigned long events,
+                                unsigned long next_seq, long last_off, unsigned long data_crc,
+                                const MsgLogTime *created) {
+    unsigned long crc;
+
+    memset(hdr, 0, MSGLOG_HEADER_SIZE);
+    hdr[0] = MSGLOG_MAGIC0;
+    hdr[1] = MSGLOG_MAGIC1;
+    hdr[2] = MSGLOG_MAGIC2;
+    hdr[3] = MSGLOG_MAGIC3;
+    msglog_put_u16(hdr, 4, MSGLOG_FORMAT_VERSION);
+    msglog_put_u16(hdr, 6, MSGLOG_HEADER_SIZE);
+    msglog_put_u16(hdr, 8, flags);
+    msglog_put_u16(hdr, 10, MSGLOG_ENCODING_BAKZH_V1);
+    msglog_put_u32(hdr, 12, MSGLOG_MAPPING_FINGERPRINT);
+    msglog_put_u32(hdr, 16, gam_len);
+    msglog_put_u32(hdr, 20, gam_crc);
+    msglog_put_u32(hdr, 24, (unsigned long)committed);
+    msglog_put_u32(hdr, 28, events);
+    msglog_put_u32(hdr, 32, next_seq);
+    msglog_put_u32(hdr, 36, (unsigned long)last_off);
+    msglog_put_u32(hdr, 40, data_crc);
+    msglog_put_u16(hdr, 44, created->year);
+    hdr[46] = created->month;
+    hdr[47] = created->day;
+    hdr[48] = created->hour;
+    hdr[49] = created->minute;
+    hdr[50] = created->second;
+    hdr[51] = created->hundredth;
+    /* 52..59 reserved, already zero */
+    crc = msglog_crc32_near(MSGLOG_CRC32_INIT, hdr, 60);
+    msglog_put_u32(hdr, 60, MSGLOG_CRC32_FINAL(crc));
+}
+
+/** Rewrite the 64-byte header of the open working file from module state. */
+static int msglog_flush_header(unsigned short extra_flags) {
+    unsigned char hdr[MSGLOG_HEADER_SIZE];
+
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    msglog_build_header(hdr, (unsigned short)((g_mlgFlags | extra_flags) & ~MSGLOG_HF_SNAPSHOT), 0UL,
+                        0UL, g_mlgCommitted, g_mlgEventCount, g_mlgNextSeq, g_mlgLastOffset, 0UL,
+                        &g_mlgCreated);
+    if (lseek(g_mlgWorkFd, 0L, MSGLOG_SEEK_SET) != 0L)
+        return MSGLOG_E_IO;
+    if (write(g_mlgWorkFd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE)
+        return MSGLOG_E_IO;
+    return MSGLOG_OK;
+}
+
+/**
+ * Parse and validate a 64-byte header image.
+ * @param check_binding non-zero to enforce the bound-GAM fingerprint.
+ */
+static int msglog_parse_header(const unsigned char *hdr, long file_len, unsigned long gam_len,
+                               unsigned long gam_crc, int check_binding, unsigned short *flags_out,
+                               long *committed_out, unsigned long *events_out,
+                               unsigned long *next_seq_out, long *last_off_out,
+                               unsigned long *data_crc_out) {
+    unsigned long stored;
+    unsigned long computed;
+    unsigned short flags;
+    unsigned long committed;
+    long last_off;
+
+    if (hdr[0] != MSGLOG_MAGIC0 || hdr[1] != MSGLOG_MAGIC1 || hdr[2] != MSGLOG_MAGIC2 ||
+        hdr[3] != MSGLOG_MAGIC3)
+        return MSGLOG_E_MAGIC;
+    if (msglog_get_u16(hdr, 4) != MSGLOG_FORMAT_VERSION)
+        return MSGLOG_E_VERSION;
+    if (msglog_get_u16(hdr, 6) != MSGLOG_HEADER_SIZE)
+        return MSGLOG_E_HEADER;
+    stored = msglog_get_u32(hdr, 60);
+    computed = MSGLOG_CRC32_FINAL(msglog_crc32_near(MSGLOG_CRC32_INIT, hdr, 60));
+    if (stored != computed)
+        return MSGLOG_E_HEADER;
+    if (msglog_get_u16(hdr, 10) != MSGLOG_ENCODING_BAKZH_V1)
+        return MSGLOG_E_ENCODING;
+    if (msglog_get_u32(hdr, 12) != MSGLOG_MAPPING_FINGERPRINT)
+        return MSGLOG_E_ENCODING;
+
+    flags = (unsigned short)msglog_get_u16(hdr, 8);
+    committed = msglog_get_u32(hdr, 24);
+    if (committed < (unsigned long)MSGLOG_HEADER_SIZE)
+        return MSGLOG_E_RANGE;
+    if (committed > (unsigned long)MSGLOG_MAX_FILE)
+        return MSGLOG_E_RANGE;
+    if ((long)committed > file_len)
+        return MSGLOG_E_TRUNC;
+    last_off = (long)msglog_get_u32(hdr, 36);
+    if (last_off != 0 &&
+        (last_off < MSGLOG_HEADER_SIZE || (unsigned long)last_off >= committed))
+        return MSGLOG_E_RANGE;
+    if (check_binding) {
+        if (!(flags & MSGLOG_HF_GAM_BOUND))
+            return MSGLOG_E_BINDING;
+        if (msglog_get_u32(hdr, 16) != gam_len || msglog_get_u32(hdr, 20) != gam_crc)
+            return MSGLOG_E_BINDING;
+    }
+
+    *flags_out = flags;
+    *committed_out = (long)committed;
+    *events_out = msglog_get_u32(hdr, 28);
+    *next_seq_out = msglog_get_u32(hdr, 32);
+    *last_off_out = last_off;
+    *data_crc_out = msglog_get_u32(hdr, 40);
+    return MSGLOG_OK;
+}
+
+/* ------------------------------------------------------------------ */
+/* Record verification / scanning                                      */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Read the record at @p off and verify its length bounds and CRC32.
+ * @param head_out optional 52-byte destination for the record head.
+ * @return MSGLOG_OK, or MSGLOG_E_TRUNC / _RANGE / _CRC / _IO.
+ */
+static int msglog_verify_record(int fd, long off, long committed, unsigned char *head_out,
+                                unsigned long *len_out) {
+    unsigned char head[MSGLOG_EVENT_HEAD_SIZE];
+    unsigned char chunk[64];
+    unsigned long total;
+    unsigned long crc;
+    unsigned long remaining;
+    unsigned long stored;
+    unsigned int s_len;
+    unsigned int l_len;
+    unsigned int b_len;
+    int n;
+
+    if (off < MSGLOG_HEADER_SIZE || off >= committed)
+        return MSGLOG_E_RANGE;
+    if (lseek(fd, off, MSGLOG_SEEK_SET) != off)
+        return MSGLOG_E_IO;
+    if (read(fd, head, MSGLOG_EVENT_HEAD_SIZE) != MSGLOG_EVENT_HEAD_SIZE)
+        return MSGLOG_E_TRUNC;
+    total = msglog_get_u32(head, 0);
+    if (total < (unsigned long)MSGLOG_EVENT_MIN_RECORD || total > (unsigned long)MSGLOG_MAX_RECORD)
+        return MSGLOG_E_RANGE;
+    /* No overflow possible: total <= MSGLOG_MAX_RECORD and committed <= MSGLOG_MAX_FILE. */
+    if ((unsigned long)off + total > (unsigned long)committed)
+        return MSGLOG_E_TRUNC;
+    s_len = msglog_get_u16(head, 44);
+    l_len = msglog_get_u16(head, 46);
+    b_len = msglog_get_u16(head, 48);
+    if (s_len > MSGLOG_MAX_SPEAKER || l_len > MSGLOG_MAX_LOCATION || b_len > MSGLOG_MAX_BODY)
+        return MSGLOG_E_RANGE;
+    if ((unsigned long)MSGLOG_EVENT_HEAD_SIZE + s_len + l_len + b_len + 4UL != total)
+        return MSGLOG_E_RANGE;
+
+    crc = msglog_crc32_near(MSGLOG_CRC32_INIT, head, MSGLOG_EVENT_HEAD_SIZE);
+    remaining = total - MSGLOG_EVENT_HEAD_SIZE - 4UL;
+    while (remaining != 0) {
+        n = (remaining > sizeof(chunk)) ? (int)sizeof(chunk) : (int)remaining;
+        if (read(fd, chunk, n) != n)
+            return MSGLOG_E_TRUNC;
+        crc = msglog_crc32_near(crc, chunk, (unsigned int)n);
+        remaining -= (unsigned long)n;
+    }
+    if (read(fd, chunk, 4) != 4)
+        return MSGLOG_E_TRUNC;
+    stored = msglog_get_u32(chunk, 0);
+    if (stored != MSGLOG_CRC32_FINAL(crc))
+        return MSGLOG_E_CRC;
+
+    if (head_out != NULL)
+        memcpy(head_out, head, MSGLOG_EVENT_HEAD_SIZE);
+    if (len_out != NULL)
+        *len_out = total;
+    return MSGLOG_OK;
+}
+
+/**
+ * Walk records forward from the header, keeping the longest prefix in which
+ * every record verifies. Used when the header cannot be trusted.
+ */
+static void msglog_rescan(int fd, long file_len, long *committed, unsigned long *events,
+                          unsigned long *next_seq, long *last_off) {
+    unsigned char head[MSGLOG_EVENT_HEAD_SIZE];
+    unsigned long total;
+    unsigned long seq;
+    unsigned long high;
+    long off;
+
+    off = MSGLOG_HEADER_SIZE;
+    *events = 0;
+    *last_off = 0;
+    high = 0;
+    for (;;) {
+        if (msglog_verify_record(fd, off, file_len, head, &total) != MSGLOG_OK)
+            break;
+        seq = msglog_get_u32(head, 8);
+        if (seq > high)
+            high = seq;
+        *last_off = off;
+        (*events)++;
+        off += (long)total;
+    }
+    *committed = off;
+    *next_seq = high + 1UL;
+}
+
+/* ------------------------------------------------------------------ */
+/* Timeline creation / reopen / close                                  */
+/* ------------------------------------------------------------------ */
+
+int far msglog_new_timeline(const char *path, const MsgLogTime far *now) {
+    unsigned char hdr[MSGLOG_HEADER_SIZE];
+    int fd;
+
+    if (path == NULL || now == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd >= 0) {
+        close(g_mlgWorkFd);
+        g_mlgWorkFd = -1;
+    }
+    fd = open((char *)path, MSGLOG_O_CREATE, MSGLOG_S_RW);
+    if (fd < 0)
+        return msglog_fail(MSGLOG_E_OPEN);
+    g_mlgFlags = 0;
+    g_mlgCommitted = MSGLOG_HEADER_SIZE;
+    g_mlgEventCount = 0;
+    g_mlgNextSeq = 1;
+    g_mlgLastOffset = 0;
+    g_mlgConvId = 0;
+    g_mlgConvDepth = 0;
+    g_mlgCreated.year = now->year;
+    g_mlgCreated.month = now->month;
+    g_mlgCreated.day = now->day;
+    g_mlgCreated.hour = now->hour;
+    g_mlgCreated.minute = now->minute;
+    g_mlgCreated.second = now->second;
+    g_mlgCreated.hundredth = now->hundredth;
+
+    msglog_build_header(hdr, 0, 0UL, 0UL, g_mlgCommitted, 0UL, 1UL, 0L, 0UL, &g_mlgCreated);
+    if (write(fd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE) {
+        close(fd);
+        return msglog_fail(MSGLOG_E_IO);
+    }
+    g_mlgWorkFd = fd;
+    g_mlgBaseState = MSGLOG_STATE_ACTIVE;
+    g_mlgLastError = MSGLOG_OK;
+    return MSGLOG_OK;
+}
+
+int far msglog_open_working(const char *path) {
+    unsigned char hdr[MSGLOG_HEADER_SIZE];
+    long file_len;
+    unsigned short flags;
+    long committed;
+    unsigned long events;
+    unsigned long next_seq;
+    long last_off;
+    unsigned long data_crc;
+    int fd;
+    int rc;
+
+    if (path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd >= 0) {
+        close(g_mlgWorkFd);
+        g_mlgWorkFd = -1;
+    }
+    fd = open((char *)path, MSGLOG_O_RDWR);
+    if (fd < 0) {
+        g_mlgLastError = MSGLOG_E_OPEN;
+        return MSGLOG_E_OPEN;
+    }
+    file_len = filelength(fd);
+    if (file_len < MSGLOG_HEADER_SIZE) {
+        close(fd);
+        g_mlgLastError = MSGLOG_E_TRUNC;
+        return MSGLOG_E_TRUNC;
+    }
+    if (read(fd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE) {
+        close(fd);
+        g_mlgLastError = MSGLOG_E_IO;
+        return MSGLOG_E_IO;
+    }
+    rc = msglog_parse_header(hdr, file_len, 0UL, 0UL, 0, &flags, &committed, &events, &next_seq,
+                             &last_off, &data_crc);
+    if (rc == MSGLOG_E_MAGIC || rc == MSGLOG_E_VERSION || rc == MSGLOG_E_ENCODING) {
+        /* Not ours, or a mapping/format we must refuse rather than misread. */
+        close(fd);
+        g_mlgLastError = rc;
+        return rc;
+    }
+    if (rc != MSGLOG_OK) {
+        /* Header itself is untrustworthy: fall back to the verifiable prefix. */
+        flags = (unsigned short)msglog_get_u16(hdr, 8);
+        msglog_rescan(fd, file_len, &committed, &events, &next_seq, &last_off);
+    } else if (last_off != 0 &&
+               msglog_verify_record(fd, last_off, committed, NULL, NULL) != MSGLOG_OK) {
+        msglog_rescan(fd, file_len, &committed, &events, &next_seq, &last_off);
+    }
+    g_mlgFlags = (unsigned short)(flags & ~(MSGLOG_HF_SNAPSHOT | MSGLOG_HF_SEALED |
+                                            MSGLOG_HF_DATA_CRC | MSGLOG_HF_GAM_BOUND));
+    /* The timeline keeps the creation stamp it was born with. Without this the
+       next header flush would write zeros over it and quietly rewrite history's
+       start time to "never". */
+    g_mlgCreated.year = (unsigned short)msglog_get_u16(hdr, 44);
+    g_mlgCreated.month = hdr[46];
+    g_mlgCreated.day = hdr[47];
+    g_mlgCreated.hour = hdr[48];
+    g_mlgCreated.minute = hdr[49];
+    g_mlgCreated.second = hdr[50];
+    g_mlgCreated.hundredth = hdr[51];
+    g_mlgCommitted = committed;
+    g_mlgEventCount = events;
+    g_mlgNextSeq = next_seq;
+    g_mlgLastOffset = last_off;
+    g_mlgConvId = 0;
+    g_mlgConvDepth = 0;
+    g_mlgWorkFd = fd;
+    g_mlgBaseState = MSGLOG_STATE_ACTIVE;
+    g_mlgLastError = MSGLOG_OK;
+    return MSGLOG_OK;
+}
+
+int far msglog_shutdown(void) {
+    int rc;
+
+    rc = MSGLOG_OK;
+    if (g_mlgCandFd >= 0) {
+        close(g_mlgCandFd);
+        g_mlgCandFd = -1;
+    }
+    if (g_mlgWorkFd >= 0) {
+        if (g_mlgBaseState != MSGLOG_STATE_FAILED)
+            rc = msglog_flush_header(MSGLOG_HF_SEALED);
+        if (close(g_mlgWorkFd) != 0 && rc == MSGLOG_OK)
+            rc = MSGLOG_E_IO;
+        g_mlgWorkFd = -1;
+    }
+    g_mlgBaseState = MSGLOG_STATE_INACTIVE;
+    g_mlgTransitionDepth = 0;
+    g_mlgViewerDepth = 0;
+    g_mlgConvDepth = 0;
+    g_mlgConvId = 0;
+    return rc;
+}
+
+/* ------------------------------------------------------------------ */
+/* Appending                                                           */
+/* ------------------------------------------------------------------ */
+
+unsigned int far msglog_split_point(const unsigned char huge *body, unsigned int len,
+                                    unsigned int limit) {
+    unsigned int i;
+    unsigned int last_safe;
+    unsigned int step;
+    unsigned char b;
+
+    if (limit == 0)
+        return 0;
+    if (len <= limit)
+        return len;
+    i = 0;
+    last_safe = 0;
+    while (i < len) {
+        b = body[i];
+        step = (b >= 0x80 && b <= 0xdf && (i + 1) < len) ? 2 : 1;
+        if (i + step > limit)
+            break;
+        i += step;
+        last_safe = i;
+    }
+    return last_safe;
+}
+
+/**
+ * Write one complete record. All fields already validated by the caller.
+ * On any I/O failure the module goes FAILED and the committed tail is untouched,
+ * so the verifiable prefix survives.
+ */
+static int msglog_write_record(unsigned short kind, unsigned short flags,
+                               const MsgLogContext far *ctx, const MsgLogTime far *now,
+                               unsigned short fragment_index, const unsigned char huge *body,
+                               unsigned int body_len) {
+    unsigned char head[MSGLOG_EVENT_HEAD_SIZE];
+    unsigned char tail[4];
+    unsigned long total;
+    unsigned long crc;
+    unsigned int s_len;
+    unsigned int l_len;
+
+    s_len = (ctx->speaker != NULL) ? ctx->speaker_len : 0;
+    l_len = (ctx->location != NULL) ? ctx->location_len : 0;
+    if (s_len > MSGLOG_MAX_SPEAKER || l_len > MSGLOG_MAX_LOCATION || body_len > MSGLOG_MAX_BODY)
+        return MSGLOG_E_RANGE;
+    total = (unsigned long)MSGLOG_EVENT_HEAD_SIZE + s_len + l_len + body_len + 4UL;
+    if ((unsigned long)g_mlgCommitted + total > (unsigned long)MSGLOG_MAX_FILE)
+        return MSGLOG_E_FULL;
+
+    memset(head, 0, MSGLOG_EVENT_HEAD_SIZE);
+    msglog_put_u32(head, 0, total);
+    msglog_put_u16(head, 4, kind);
+    msglog_put_u16(head, 6, flags);
+    msglog_put_u32(head, 8, g_mlgNextSeq);
+    msglog_put_u32(head, 12, g_mlgConvId);
+    msglog_put_u32(head, 16, (unsigned long)g_mlgLastOffset);
+    msglog_put_u16(head, 20, now->year);
+    head[22] = now->month;
+    head[23] = now->day;
+    head[24] = now->hour;
+    head[25] = now->minute;
+    head[26] = now->second;
+    head[27] = now->hundredth;
+    msglog_put_u16(head, 28, ctx->chapter);
+    msglog_put_u16(head, 30, ctx->zone_id);
+    msglog_put_u16(head, 32, ctx->scene_id);
+    msglog_put_u16(head, 34, ctx->speaker_id);
+    msglog_put_u32(head, 36, ctx->source_key);
+    msglog_put_u16(head, 40, ctx->source_file);
+    msglog_put_u16(head, 42, fragment_index);
+    msglog_put_u16(head, 44, s_len);
+    msglog_put_u16(head, 46, l_len);
+    msglog_put_u16(head, 48, body_len);
+    msglog_put_u16(head, 50, 0);
+
+    /* Drop any partial record left behind by an interrupted append. */
+    if (chsize(g_mlgWorkFd, g_mlgCommitted) != 0)
+        return MSGLOG_E_IO;
+    if (lseek(g_mlgWorkFd, g_mlgCommitted, MSGLOG_SEEK_SET) != g_mlgCommitted)
+        return MSGLOG_E_IO;
+
+    crc = msglog_crc32_near(MSGLOG_CRC32_INIT, head, MSGLOG_EVENT_HEAD_SIZE);
+    if (write(g_mlgWorkFd, head, MSGLOG_EVENT_HEAD_SIZE) != MSGLOG_EVENT_HEAD_SIZE)
+        return MSGLOG_E_IO;
+    if (s_len != 0) {
+        crc = msglog_crc32_update(crc, (const unsigned char huge *)ctx->speaker, s_len);
+        if (dos_write((unsigned char far *)ctx->speaker, (long)s_len, g_mlgWorkFd) != (long)s_len)
+            return MSGLOG_E_IO;
+    }
+    if (l_len != 0) {
+        crc = msglog_crc32_update(crc, (const unsigned char huge *)ctx->location, l_len);
+        if (dos_write((unsigned char far *)ctx->location, (long)l_len, g_mlgWorkFd) != (long)l_len)
+            return MSGLOG_E_IO;
+    }
+    if (body_len != 0) {
+        crc = msglog_crc32_update(crc, body, body_len);
+        if (dos_write((unsigned char far *)body, (long)body_len, g_mlgWorkFd) != (long)body_len)
+            return MSGLOG_E_IO;
+    }
+    msglog_put_u32(tail, 0, MSGLOG_CRC32_FINAL(crc));
+    if (write(g_mlgWorkFd, tail, 4) != 4)
+        return MSGLOG_E_IO;
+
+    g_mlgLastOffset = g_mlgCommitted;
+    g_mlgCommitted += (long)total;
+    g_mlgEventCount++;
+    g_mlgNextSeq++;
+    return msglog_flush_header(0);
+}
+
+/** Common entry gate: returns MSGLOG_OK when the caller may write. */
+static int msglog_append_gate(const MsgLogContext far *ctx, const MsgLogTime far *now) {
+    if (ctx == NULL || now == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgBaseState == MSGLOG_STATE_FAILED)
+        return MSGLOG_E_STATE;
+    if (g_mlgBaseState != MSGLOG_STATE_ACTIVE || g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    if (g_mlgTransitionDepth > 0 || g_mlgViewerDepth > 0)
+        return MSGLOG_E_SUPPRESSED;
+    return MSGLOG_OK;
+}
+
+static int msglog_append_fragments(unsigned short kind, const MsgLogContext far *ctx,
+                                   const MsgLogTime far *now, const unsigned char huge *body,
+                                   unsigned int body_len) {
+    unsigned int done;
+    unsigned int cut;
+    unsigned short frag;
+    unsigned short flags;
+    int rc;
+
+    rc = msglog_append_gate(ctx, now);
+    if (rc != MSGLOG_OK)
+        return rc;
+    if (body == NULL && body_len != 0)
+        return MSGLOG_E_PARAM;
+
+    if (body == NULL || body_len == 0) {
+        flags = (unsigned short)(ctx->flags & ~(MSGLOG_EV_CONTINUED | MSGLOG_EV_MORE));
+        rc = msglog_write_record(kind, flags, ctx, now, 0, NULL, 0);
+        if (rc != MSGLOG_OK)
+            return msglog_fail(rc);
+        return MSGLOG_OK;
+    }
+
+    done = 0;
+    frag = 0;
+    for (;;) {
+        cut = msglog_split_point(body + done, body_len - done, MSGLOG_MAX_BODY);
+        if (cut == 0) {
+            /* A lone lead byte with no trail: emit it rather than loop forever. */
+            cut = 1;
+        }
+        flags = (unsigned short)(ctx->flags & ~(MSGLOG_EV_CONTINUED | MSGLOG_EV_MORE));
+        if (frag != 0)
+            flags |= MSGLOG_EV_CONTINUED;
+        if (done + cut < body_len)
+            flags |= MSGLOG_EV_MORE;
+        rc = msglog_write_record(kind, flags, ctx, now, frag, body + done, cut);
+        if (rc != MSGLOG_OK)
+            return msglog_fail(rc);
+        done += cut;
+        frag++;
+        if (done >= body_len)
+            break;
+    }
+    return MSGLOG_OK;
+}
+
+int far msglog_conv_begin(const MsgLogContext far *ctx, const MsgLogTime far *now) {
+    int rc;
+
+    rc = msglog_append_gate(ctx, now);
+    if (rc != MSGLOG_OK)
+        return rc;
+    if (g_mlgConvDepth > 0) {
+        g_mlgConvDepth++;
+        return MSGLOG_OK;
+    }
+    /* A conversation is identified by the sequence number of its own begin
+       record -- no extra header field, and it is reconstructible from the
+       stream alone. */
+    g_mlgConvId = g_mlgNextSeq;
+    rc = msglog_write_record(MSGLOG_KIND_CONV_BEGIN, ctx->flags, ctx, now, 0, NULL, 0);
+    if (rc != MSGLOG_OK) {
+        g_mlgConvId = 0;
+        return msglog_fail(rc);
+    }
+    g_mlgConvDepth = 1;
+    return MSGLOG_OK;
+}
+
+int far msglog_conv_end(const MsgLogTime far *now) {
+    MsgLogContext ctx;
+    int rc;
+
+    if (now == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgConvDepth <= 0)
+        return MSGLOG_E_STATE;
+    if (g_mlgConvDepth > 1) {
+        g_mlgConvDepth--;
+        return MSGLOG_OK;
+    }
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.scene_id = 0xffff;
+    ctx.source_file = 0xffff;
+    rc = msglog_append_gate((const MsgLogContext far *)&ctx, now);
+    if (rc != MSGLOG_OK) {
+        /* Still close the scope: an unbalanced depth would leak the previous
+           NPC's conversation id into the next one. */
+        g_mlgConvDepth = 0;
+        g_mlgConvId = 0;
+        return rc;
+    }
+    rc = msglog_write_record(MSGLOG_KIND_CONV_END, 0, (const MsgLogContext far *)&ctx, now, 0,
+                             NULL, 0);
+    g_mlgConvDepth = 0;
+    g_mlgConvId = 0;
+    if (rc != MSGLOG_OK)
+        return msglog_fail(rc);
+    return MSGLOG_OK;
+}
+
+int far msglog_append_span(const MsgLogContext far *ctx, const MsgLogTime far *now,
+                           const unsigned char huge *body, unsigned int body_len) {
+    return msglog_append_fragments(MSGLOG_KIND_TEXT, ctx, now, body, body_len);
+}
+
+int far msglog_append_choice(const MsgLogContext far *ctx, const MsgLogTime far *now,
+                             const unsigned char huge *label, unsigned int label_len) {
+    return msglog_append_fragments(MSGLOG_KIND_CHOICE, ctx, now, label, label_len);
+}
+
+int far msglog_append_scene(const MsgLogContext far *ctx, const MsgLogTime far *now,
+                            const unsigned char huge *body, unsigned int body_len) {
+    return msglog_append_fragments(MSGLOG_KIND_SCENE, ctx, now, body, body_len);
+}
+
+int far msglog_append_gap(const MsgLogTime far *now) {
+    MsgLogContext ctx;
+    int rc;
+
+    if (now == NULL)
+        return MSGLOG_E_PARAM;
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.scene_id = 0xffff;
+    ctx.source_file = 0xffff;
+    rc = msglog_append_gate((const MsgLogContext far *)&ctx, now);
+    if (rc != MSGLOG_OK)
+        return rc;
+    g_mlgFlags |= MSGLOG_HF_HAS_GAP;
+    rc = msglog_write_record(MSGLOG_KIND_GAP, 0, (const MsgLogContext far *)&ctx, now, 0, NULL, 0);
+    if (rc != MSGLOG_OK)
+        return msglog_fail(rc);
+    return MSGLOG_OK;
+}
+
+/* ------------------------------------------------------------------ */
+/* Reading                                                             */
+/* ------------------------------------------------------------------ */
+
+int far msglog_first_offset(long far *out) {
+    if (out == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    if (g_mlgEventCount == 0 || g_mlgCommitted <= MSGLOG_HEADER_SIZE)
+        return MSGLOG_E_EMPTY;
+    *out = MSGLOG_HEADER_SIZE;
+    return MSGLOG_OK;
+}
+
+int far msglog_last_offset(long far *out) {
+    if (out == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    if (g_mlgEventCount == 0 || g_mlgLastOffset == 0)
+        return MSGLOG_E_EMPTY;
+    *out = g_mlgLastOffset;
+    return MSGLOG_OK;
+}
+
+int far msglog_next_offset(long cur, long far *out) {
+    unsigned long total;
+    int rc;
+
+    if (out == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    rc = msglog_verify_record(g_mlgWorkFd, cur, g_mlgCommitted, NULL, &total);
+    if (rc != MSGLOG_OK)
+        return rc;
+    if (cur + (long)total >= g_mlgCommitted)
+        return MSGLOG_E_EMPTY;
+    *out = cur + (long)total;
+    return MSGLOG_OK;
+}
+
+int far msglog_prev_offset(long cur, long far *out) {
+    unsigned char head[MSGLOG_EVENT_HEAD_SIZE];
+    unsigned long prev;
+    int rc;
+
+    if (out == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    rc = msglog_verify_record(g_mlgWorkFd, cur, g_mlgCommitted, head, NULL);
+    if (rc != MSGLOG_OK)
+        return rc;
+    prev = msglog_get_u32(head, 16);
+    if (prev == 0)
+        return MSGLOG_E_EMPTY;
+    if (prev < (unsigned long)MSGLOG_HEADER_SIZE || prev >= (unsigned long)g_mlgCommitted)
+        return MSGLOG_E_RANGE;
+    *out = (long)prev;
+    return MSGLOG_OK;
+}
+
+int far msglog_page_start(long from, int count, long far *out) {
+    long cur;
+    long prev;
+    int rc;
+
+    if (out == NULL || count < 0)
+        return MSGLOG_E_PARAM;
+    cur = from;
+    while (count > 0) {
+        rc = msglog_prev_offset(cur, &prev);
+        if (rc == MSGLOG_E_EMPTY)
+            break;
+        if (rc != MSGLOG_OK)
+            return rc;
+        cur = prev;
+        count--;
+    }
+    *out = cur;
+    return MSGLOG_OK;
+}
+
+int far msglog_read_event(long offset, MsgLogEvent far *ev, unsigned char far *speaker,
+                          unsigned int speaker_cap, unsigned char far *location,
+                          unsigned int location_cap, unsigned char far *body,
+                          unsigned int body_cap) {
+    unsigned char head[MSGLOG_EVENT_HEAD_SIZE];
+    unsigned long total;
+    unsigned int s_len;
+    unsigned int l_len;
+    unsigned int b_len;
+    long p;
+    int rc;
+
+    if (ev == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    rc = msglog_verify_record(g_mlgWorkFd, offset, g_mlgCommitted, head, &total);
+    if (rc != MSGLOG_OK)
+        return rc;
+    s_len = msglog_get_u16(head, 44);
+    l_len = msglog_get_u16(head, 46);
+    b_len = msglog_get_u16(head, 48);
+    if (speaker != NULL && s_len > speaker_cap)
+        return MSGLOG_E_RANGE;
+    if (location != NULL && l_len > location_cap)
+        return MSGLOG_E_RANGE;
+    if (body != NULL && b_len > body_cap)
+        return MSGLOG_E_RANGE;
+
+    ev->kind = (unsigned short)msglog_get_u16(head, 4);
+    ev->flags = (unsigned short)msglog_get_u16(head, 6);
+    ev->sequence = msglog_get_u32(head, 8);
+    ev->conversation = msglog_get_u32(head, 12);
+    ev->prev_offset = msglog_get_u32(head, 16);
+    ev->when.year = (unsigned short)msglog_get_u16(head, 20);
+    ev->when.month = head[22];
+    ev->when.day = head[23];
+    ev->when.hour = head[24];
+    ev->when.minute = head[25];
+    ev->when.second = head[26];
+    ev->when.hundredth = head[27];
+    ev->chapter = (unsigned short)msglog_get_u16(head, 28);
+    ev->zone_id = (unsigned short)msglog_get_u16(head, 30);
+    ev->scene_id = (unsigned short)msglog_get_u16(head, 32);
+    ev->speaker_id = (unsigned short)msglog_get_u16(head, 34);
+    ev->source_key = msglog_get_u32(head, 36);
+    ev->source_file = (unsigned short)msglog_get_u16(head, 40);
+    ev->fragment_index = (unsigned short)msglog_get_u16(head, 42);
+    ev->speaker_len = (unsigned short)s_len;
+    ev->location_len = (unsigned short)l_len;
+    ev->body_len = (unsigned short)b_len;
+    ev->offset = offset;
+    ev->record_length = total;
+
+    p = offset + MSGLOG_EVENT_HEAD_SIZE;
+    if (s_len != 0) {
+        if (speaker != NULL) {
+            if (lseek(g_mlgWorkFd, p, MSGLOG_SEEK_SET) != p)
+                return MSGLOG_E_IO;
+            if (dos_read(speaker, (long)s_len, g_mlgWorkFd) != (long)s_len)
+                return MSGLOG_E_IO;
+        }
+        p += (long)s_len;
+    }
+    if (l_len != 0) {
+        if (location != NULL) {
+            if (lseek(g_mlgWorkFd, p, MSGLOG_SEEK_SET) != p)
+                return MSGLOG_E_IO;
+            if (dos_read(location, (long)l_len, g_mlgWorkFd) != (long)l_len)
+                return MSGLOG_E_IO;
+        }
+        p += (long)l_len;
+    }
+    if (b_len != 0 && body != NULL) {
+        if (lseek(g_mlgWorkFd, p, MSGLOG_SEEK_SET) != p)
+            return MSGLOG_E_IO;
+        if (dos_read(body, (long)b_len, g_mlgWorkFd) != (long)b_len)
+            return MSGLOG_E_IO;
+    }
+    return MSGLOG_OK;
+}
+
+/* ------------------------------------------------------------------ */
+/* Snapshot / candidate                                                */
+/* ------------------------------------------------------------------ */
+
+int far msglog_crc32_file(const char *path, unsigned long far *length_out,
+                          unsigned long far *crc_out) {
+    unsigned long crc;
+    long remaining;
+    long total;
+    int chunk;
+    int fd;
+
+    if (path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgScratch == NULL)
+        return MSGLOG_E_NOMEM;
+    fd = open((char *)path, MSGLOG_O_RDONLY);
+    if (fd < 0)
+        return MSGLOG_E_OPEN;
+    total = filelength(fd);
+    remaining = total;
+    crc = MSGLOG_CRC32_INIT;
+    while (remaining > 0) {
+        chunk = (remaining > (long)g_mlgScratchLen) ? (int)g_mlgScratchLen : (int)remaining;
+        if (dos_read(g_mlgScratch, (long)chunk, fd) != (long)chunk) {
+            close(fd);
+            return MSGLOG_E_IO;
+        }
+        crc = msglog_crc32_update(crc, (const unsigned char huge *)g_mlgScratch,
+                                  (unsigned int)chunk);
+        remaining -= (long)chunk;
+    }
+    if (close(fd) != 0)
+        return MSGLOG_E_IO;
+    if (length_out != NULL)
+        *length_out = (unsigned long)total;
+    if (crc_out != NULL)
+        *crc_out = MSGLOG_CRC32_FINAL(crc);
+    return MSGLOG_OK;
+}
+
+int far msglog_prepare_snapshot(const char *path, unsigned long gam_length,
+                                unsigned long gam_crc32) {
+    unsigned char hdr[MSGLOG_HEADER_SIZE];
+    unsigned long crc;
+    long remaining;
+    int chunk;
+    int fd;
+    int rc;
+
+    if (path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    if (g_mlgScratch == NULL)
+        return MSGLOG_E_NOMEM;
+
+    fd = open((char *)path, MSGLOG_O_CREATE, MSGLOG_S_RW);
+    if (fd < 0)
+        return MSGLOG_E_OPEN;
+    /* Placeholder header: rewritten once the data CRC is known. */
+    memset(hdr, 0, MSGLOG_HEADER_SIZE);
+    rc = MSGLOG_OK;
+    if (write(fd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE)
+        rc = MSGLOG_E_IO;
+    if (rc == MSGLOG_OK && lseek(g_mlgWorkFd, (long)MSGLOG_HEADER_SIZE, MSGLOG_SEEK_SET) !=
+                               (long)MSGLOG_HEADER_SIZE)
+        rc = MSGLOG_E_IO;
+
+    crc = MSGLOG_CRC32_INIT;
+    remaining = g_mlgCommitted - MSGLOG_HEADER_SIZE;
+    while (rc == MSGLOG_OK && remaining > 0) {
+        chunk = (remaining > (long)g_mlgScratchLen) ? (int)g_mlgScratchLen : (int)remaining;
+        if (dos_read(g_mlgScratch, (long)chunk, g_mlgWorkFd) != (long)chunk) {
+            rc = MSGLOG_E_IO;
+            break;
+        }
+        crc = msglog_crc32_update(crc, (const unsigned char huge *)g_mlgScratch,
+                                  (unsigned int)chunk);
+        if (dos_write(g_mlgScratch, (long)chunk, fd) != (long)chunk) {
+            rc = MSGLOG_E_IO;
+            break;
+        }
+        remaining -= (long)chunk;
+    }
+    if (rc == MSGLOG_OK) {
+        msglog_build_header(hdr,
+                            (unsigned short)((g_mlgFlags & MSGLOG_HF_HAS_GAP) |
+                                             MSGLOG_HF_SNAPSHOT | MSGLOG_HF_SEALED |
+                                             MSGLOG_HF_DATA_CRC | MSGLOG_HF_GAM_BOUND),
+                            gam_length, gam_crc32, g_mlgCommitted, g_mlgEventCount, g_mlgNextSeq,
+                            g_mlgLastOffset, MSGLOG_CRC32_FINAL(crc), &g_mlgCreated);
+        if (lseek(fd, 0L, MSGLOG_SEEK_SET) != 0L)
+            rc = MSGLOG_E_IO;
+        else if (write(fd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE)
+            rc = MSGLOG_E_IO;
+    }
+    if (close(fd) != 0 && rc == MSGLOG_OK)
+        rc = MSGLOG_E_IO;
+    if (rc != MSGLOG_OK)
+        remove((char *)path);
+    /* Leave the working handle where the next append expects it. */
+    lseek(g_mlgWorkFd, g_mlgCommitted, MSGLOG_SEEK_SET);
+    return rc;
+}
+
+int far msglog_snapshot_extends_working(const char *path, unsigned char far *old_header64) {
+    unsigned char hdr[MSGLOG_HEADER_SIZE];
+    unsigned short flags;
+    unsigned long events;
+    unsigned long next_seq;
+    unsigned long data_crc;
+    long committed;
+    long last_off;
+    long file_len;
+    int fd;
+    int rc;
+    int i;
+
+    if (path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    fd = open((char *)path, MSGLOG_O_RDONLY);
+    if (fd < 0)
+        return MSGLOG_E_OPEN;
+    file_len = filelength(fd);
+    if (file_len < MSGLOG_HEADER_SIZE ||
+        read(fd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE) {
+        close(fd);
+        return MSGLOG_E_TRUNC;
+    }
+    if (close(fd) != 0)
+        return MSGLOG_E_IO;
+    rc = msglog_parse_header(hdr, file_len, 0UL, 0UL, 0, &flags, &committed, &events, &next_seq,
+                             &last_off, &data_crc);
+    if (rc != MSGLOG_OK)
+        return rc;
+    if (!(flags & MSGLOG_HF_SNAPSHOT) || !(flags & MSGLOG_HF_DATA_CRC))
+        return MSGLOG_E_HEADER;
+    if (committed != file_len)
+        return MSGLOG_E_TRUNC;
+    if (msglog_get_u16(hdr, 44) != g_mlgCreated.year || hdr[46] != g_mlgCreated.month ||
+        hdr[47] != g_mlgCreated.day || hdr[48] != g_mlgCreated.hour ||
+        hdr[49] != g_mlgCreated.minute || hdr[50] != g_mlgCreated.second ||
+        hdr[51] != g_mlgCreated.hundredth)
+        return MSGLOG_E_BINDING;
+    if (committed > g_mlgCommitted || events > g_mlgEventCount || next_seq > g_mlgNextSeq ||
+        last_off > g_mlgLastOffset)
+        return MSGLOG_E_RANGE;
+    if (old_header64 != NULL)
+        for (i = 0; i < MSGLOG_HEADER_SIZE; i++)
+            old_header64[i] = hdr[i];
+    return MSGLOG_OK;
+}
+
+int far msglog_extend_snapshot(const char *path, unsigned long gam_length,
+                               unsigned long gam_crc32) {
+    unsigned char old_hdr[MSGLOG_HEADER_SIZE];
+    unsigned char new_hdr[MSGLOG_HEADER_SIZE];
+    unsigned long crc;
+    unsigned long old_data_crc;
+    long old_committed;
+    long tail;
+    long remaining;
+    int chunk;
+    int fd;
+    int rc;
+
+    if (path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgWorkFd < 0)
+        return MSGLOG_E_STATE;
+    if (g_mlgScratch == NULL)
+        return MSGLOG_E_NOMEM;
+
+    rc = msglog_snapshot_extends_working(path, old_hdr);
+    if (rc != MSGLOG_OK)
+        return rc;
+    old_committed = (long)msglog_get_u32(old_hdr, 24);
+    old_data_crc = msglog_get_u32(old_hdr, 40);
+    tail = g_mlgCommitted - old_committed;
+
+    fd = open((char *)path, MSGLOG_O_RDWR);
+    if (fd < 0)
+        return MSGLOG_E_OPEN;
+
+    /* CRC32/ISO-HDLC final xor is self-inverse, so the stored data_crc32 of the
+       already-committed prefix is exactly the running state to resume from. */
+    rc = MSGLOG_OK;
+    crc = MSGLOG_CRC32_FINAL(old_data_crc);
+    if (tail > 0) {
+        if (lseek(g_mlgWorkFd, old_committed, MSGLOG_SEEK_SET) != old_committed ||
+            lseek(fd, old_committed, MSGLOG_SEEK_SET) != old_committed)
+            rc = MSGLOG_E_IO;
+        remaining = tail;
+        while (rc == MSGLOG_OK && remaining > 0) {
+            chunk = (remaining > (long)g_mlgScratchLen) ? (int)g_mlgScratchLen : (int)remaining;
+            if (dos_read(g_mlgScratch, (long)chunk, g_mlgWorkFd) != (long)chunk) {
+                rc = MSGLOG_E_IO;
+                break;
+            }
+            crc = msglog_crc32_update(crc, (const unsigned char huge *)g_mlgScratch,
+                                      (unsigned int)chunk);
+            if (dos_write(g_mlgScratch, (long)chunk, fd) != (long)chunk) {
+                rc = MSGLOG_E_IO;
+                break;
+            }
+            remaining -= (long)chunk;
+        }
+    }
+    if (rc == MSGLOG_OK) {
+        msglog_build_header(new_hdr,
+                            (unsigned short)((g_mlgFlags & MSGLOG_HF_HAS_GAP) |
+                                             MSGLOG_HF_SNAPSHOT | MSGLOG_HF_SEALED |
+                                             MSGLOG_HF_DATA_CRC | MSGLOG_HF_GAM_BOUND),
+                            gam_length, gam_crc32, g_mlgCommitted, g_mlgEventCount, g_mlgNextSeq,
+                            g_mlgLastOffset, MSGLOG_CRC32_FINAL(crc), &g_mlgCreated);
+        if (lseek(fd, 0L, MSGLOG_SEEK_SET) != 0L ||
+            write(fd, new_hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE)
+            rc = MSGLOG_E_IO;
+    }
+    if (rc != MSGLOG_OK) {
+        /* Restore the snapshot to exactly what it was. Idempotent on re-run. */
+        chsize(fd, old_committed);
+        if (lseek(fd, 0L, MSGLOG_SEEK_SET) == 0L)
+            write(fd, old_hdr, MSGLOG_HEADER_SIZE);
+    }
+    if (close(fd) != 0 && rc == MSGLOG_OK)
+        rc = MSGLOG_E_IO;
+    lseek(g_mlgWorkFd, g_mlgCommitted, MSGLOG_SEEK_SET);
+    return rc;
+}
+
+int far msglog_validate_snapshot_tail(const char *path, long tail_from, unsigned long gam_length,
+                                      unsigned long gam_crc32, unsigned long prev_data_crc,
+                                      long prev_last_off, unsigned long prev_events) {
+    unsigned char hdr[MSGLOG_HEADER_SIZE];
+    unsigned char head[MSGLOG_EVENT_HEAD_SIZE];
+    unsigned long crc;
+    unsigned long data_crc;
+    unsigned long events;
+    unsigned long next_seq;
+    unsigned long total;
+    unsigned long scanned;
+    unsigned short flags;
+    long committed;
+    long last_off;
+    long file_len;
+    long off;
+    long prev;
+    long remaining;
+    int chunk;
+    int fd;
+    int rc;
+
+    if (path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgScratch == NULL)
+        return MSGLOG_E_NOMEM;
+    fd = open((char *)path, MSGLOG_O_RDONLY);
+    if (fd < 0)
+        return MSGLOG_E_OPEN;
+    file_len = filelength(fd);
+    if (file_len < MSGLOG_HEADER_SIZE ||
+        read(fd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE) {
+        close(fd);
+        return MSGLOG_E_TRUNC;
+    }
+    rc = msglog_parse_header(hdr, file_len, gam_length, gam_crc32,
+                             (gam_length != 0UL || gam_crc32 != 0UL) ? 1 : 0, &flags, &committed,
+                             &events, &next_seq, &last_off, &data_crc);
+    if (rc != MSGLOG_OK) {
+        close(fd);
+        return rc;
+    }
+    if (!(flags & MSGLOG_HF_SNAPSHOT) || !(flags & MSGLOG_HF_DATA_CRC)) {
+        close(fd);
+        return MSGLOG_E_HEADER;
+    }
+    if (committed != file_len) {
+        close(fd);
+        return MSGLOG_E_TRUNC;
+    }
+    if (tail_from < MSGLOG_HEADER_SIZE || tail_from > committed) {
+        close(fd);
+        return MSGLOG_E_RANGE;
+    }
+
+    crc = MSGLOG_CRC32_FINAL(prev_data_crc);
+    if (lseek(fd, tail_from, MSGLOG_SEEK_SET) != tail_from) {
+        close(fd);
+        return MSGLOG_E_IO;
+    }
+    remaining = committed - tail_from;
+    while (remaining > 0) {
+        chunk = (remaining > (long)g_mlgScratchLen) ? (int)g_mlgScratchLen : (int)remaining;
+        if (dos_read(g_mlgScratch, (long)chunk, fd) != (long)chunk) {
+            close(fd);
+            return MSGLOG_E_IO;
+        }
+        crc = msglog_crc32_update(crc, (const unsigned char huge *)g_mlgScratch,
+                                  (unsigned int)chunk);
+        remaining -= (long)chunk;
+    }
+    if (MSGLOG_CRC32_FINAL(crc) != data_crc) {
+        close(fd);
+        return MSGLOG_E_CRC;
+    }
+
+    off = tail_from;
+    scanned = 0;
+    prev = prev_last_off;
+    while (off < committed) {
+        rc = msglog_verify_record(fd, off, committed, head, &total);
+        if (rc != MSGLOG_OK) {
+            close(fd);
+            return rc;
+        }
+        if (msglog_get_u32(head, 16) != (unsigned long)prev) {
+            close(fd);
+            return MSGLOG_E_RANGE;
+        }
+        prev = off;
+        scanned++;
+        off += (long)total;
+    }
+    if (off != committed) {
+        close(fd);
+        return MSGLOG_E_TRUNC;
+    }
+    if (scanned + prev_events != events) {
+        close(fd);
+        return MSGLOG_E_RANGE;
+    }
+    if ((unsigned long)prev != (unsigned long)last_off) {
+        close(fd);
+        return MSGLOG_E_RANGE;
+    }
+    if (close(fd) != 0)
+        return MSGLOG_E_IO;
+    return MSGLOG_OK;
+}
+
+int far msglog_load_candidate(const char *path, unsigned long gam_length,
+                              unsigned long gam_crc32) {
+    unsigned char hdr[MSGLOG_HEADER_SIZE];
+    unsigned char head[MSGLOG_EVENT_HEAD_SIZE];
+    unsigned long crc;
+    unsigned long data_crc;
+    unsigned long events;
+    unsigned long next_seq;
+    unsigned long scanned;
+    unsigned long total;
+    unsigned short flags;
+    long committed;
+    long last_off;
+    long file_len;
+    long off;
+    long prev;
+    long remaining;
+    int chunk;
+    int fd;
+    int rc;
+
+    if (path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgScratch == NULL)
+        return MSGLOG_E_NOMEM;
+    msglog_discard_candidate();
+
+    fd = open((char *)path, MSGLOG_O_RDONLY);
+    if (fd < 0)
+        return MSGLOG_E_OPEN;
+    file_len = filelength(fd);
+    if (file_len < MSGLOG_HEADER_SIZE) {
+        close(fd);
+        return MSGLOG_E_TRUNC;
+    }
+    if (read(fd, hdr, MSGLOG_HEADER_SIZE) != MSGLOG_HEADER_SIZE) {
+        close(fd);
+        return MSGLOG_E_IO;
+    }
+    rc = msglog_parse_header(hdr, file_len, gam_length, gam_crc32,
+                             (gam_length != 0UL || gam_crc32 != 0UL) ? 1 : 0, &flags, &committed,
+                             &events, &next_seq, &last_off, &data_crc);
+    if (rc != MSGLOG_OK) {
+        close(fd);
+        return rc;
+    }
+    if (!(flags & MSGLOG_HF_SNAPSHOT)) {
+        close(fd);
+        return MSGLOG_E_HEADER;
+    }
+
+    /* Whole-history CRC, chunked. This is the one place the full history is
+       hashed -- appends never redo it. */
+    if (flags & MSGLOG_HF_DATA_CRC) {
+        crc = MSGLOG_CRC32_INIT;
+        remaining = committed - MSGLOG_HEADER_SIZE;
+        while (remaining > 0) {
+            chunk = (remaining > (long)g_mlgScratchLen) ? (int)g_mlgScratchLen : (int)remaining;
+            if (dos_read(g_mlgScratch, (long)chunk, fd) != (long)chunk) {
+                close(fd);
+                return MSGLOG_E_IO;
+            }
+            crc = msglog_crc32_update(crc, (const unsigned char huge *)g_mlgScratch,
+                                      (unsigned int)chunk);
+            remaining -= (long)chunk;
+        }
+        if (MSGLOG_CRC32_FINAL(crc) != data_crc) {
+            close(fd);
+            return MSGLOG_E_CRC;
+        }
+    }
+
+    /* Structural pass: every record must verify, its prev_offset must chain,
+       and the last one must land exactly on committed_length. */
+    off = MSGLOG_HEADER_SIZE;
+    scanned = 0;
+    prev = 0L;
+    while (off < committed) {
+        rc = msglog_verify_record(fd, off, committed, head, &total);
+        if (rc != MSGLOG_OK) {
+            close(fd);
+            return rc;
+        }
+        if (msglog_get_u32(head, 16) != (unsigned long)prev) {
+            close(fd);
+            return MSGLOG_E_RANGE;
+        }
+        prev = off;
+        scanned++;
+        off += (long)total;
+    }
+    if (off != committed) {
+        close(fd);
+        return MSGLOG_E_TRUNC;
+    }
+    if (scanned != events) {
+        close(fd);
+        return MSGLOG_E_RANGE;
+    }
+    if ((unsigned long)prev != (unsigned long)last_off) {
+        close(fd);
+        return MSGLOG_E_RANGE;
+    }
+
+    g_mlgCandFd = fd;
+    g_mlgCandCommitted = committed;
+    g_mlgCandEvents = events;
+    g_mlgCandNextSeq = next_seq;
+    g_mlgCandLastOffset = prev;
+    g_mlgCandFlags = flags;
+    g_mlgCandCreated.year = (unsigned short)msglog_get_u16(hdr, 44);
+    g_mlgCandCreated.month = hdr[46];
+    g_mlgCandCreated.day = hdr[47];
+    g_mlgCandCreated.hour = hdr[48];
+    g_mlgCandCreated.minute = hdr[49];
+    g_mlgCandCreated.second = hdr[50];
+    g_mlgCandCreated.hundredth = hdr[51];
+    return MSGLOG_OK;
+}
+
+void far msglog_discard_candidate(void) {
+    if (g_mlgCandFd >= 0) {
+        close(g_mlgCandFd);
+        g_mlgCandFd = -1;
+    }
+    g_mlgCandCommitted = 0;
+    g_mlgCandEvents = 0;
+    g_mlgCandNextSeq = 1;
+    g_mlgCandLastOffset = 0;
+    g_mlgCandFlags = 0;
+}
+
+int far msglog_activate_candidate(const char *work_path) {
+    long remaining;
+    int chunk;
+    int fd;
+    int rc;
+
+    if (work_path == NULL)
+        return MSGLOG_E_PARAM;
+    if (g_mlgCandFd < 0)
+        return MSGLOG_E_STATE;
+    if (g_mlgScratch == NULL)
+        return MSGLOG_E_NOMEM;
+
+    /* The old working timeline is gone the moment we truncate: the caller must
+       treat a failure here as "history unavailable", never as "keep the old". */
+    if (g_mlgWorkFd >= 0) {
+        close(g_mlgWorkFd);
+        g_mlgWorkFd = -1;
+    }
+    g_mlgBaseState = MSGLOG_STATE_INACTIVE;
+
+    fd = open((char *)work_path, MSGLOG_O_CREATE, MSGLOG_S_RW);
+    if (fd < 0) {
+        msglog_discard_candidate();
+        return msglog_fail(MSGLOG_E_OPEN);
+    }
+    rc = MSGLOG_OK;
+    if (lseek(g_mlgCandFd, 0L, MSGLOG_SEEK_SET) != 0L)
+        rc = MSGLOG_E_IO;
+    remaining = g_mlgCandCommitted;
+    while (rc == MSGLOG_OK && remaining > 0) {
+        chunk = (remaining > (long)g_mlgScratchLen) ? (int)g_mlgScratchLen : (int)remaining;
+        if (dos_read(g_mlgScratch, (long)chunk, g_mlgCandFd) != (long)chunk) {
+            rc = MSGLOG_E_IO;
+            break;
+        }
+        if (dos_write(g_mlgScratch, (long)chunk, fd) != (long)chunk) {
+            rc = MSGLOG_E_IO;
+            break;
+        }
+        remaining -= (long)chunk;
+    }
+    if (rc == MSGLOG_OK) {
+        /* Re-stamp as a working file: not a snapshot, no GAM binding, and the
+           stale data CRC dropped so a later append cannot contradict it. The
+           timeline keeps the snapshot's creation stamp, not today's. */
+        g_mlgCreated = g_mlgCandCreated;
+        g_mlgFlags = (unsigned short)(g_mlgCandFlags & MSGLOG_HF_HAS_GAP);
+        g_mlgCommitted = g_mlgCandCommitted;
+        g_mlgEventCount = g_mlgCandEvents;
+        g_mlgNextSeq = g_mlgCandNextSeq;
+        g_mlgLastOffset = g_mlgCandLastOffset;
+        g_mlgConvId = 0;
+        g_mlgConvDepth = 0;
+        g_mlgWorkFd = fd;
+        rc = msglog_flush_header(0);
+        if (rc != MSGLOG_OK) {
+            close(fd);
+            g_mlgWorkFd = -1;
+        }
+    } else {
+        close(fd);
+    }
+    msglog_discard_candidate();
+    if (rc != MSGLOG_OK)
+        return msglog_fail(rc);
+    g_mlgBaseState = MSGLOG_STATE_ACTIVE;
+    g_mlgLastError = MSGLOG_OK;
+    return MSGLOG_OK;
+}
diff --git a/bak/SRC/DIALOG/MSGLOG.H b/bak/SRC/DIALOG/MSGLOG.H
new file mode 100644
index 0000000000000000000000000000000000000000..9136ddbdeb60b8b066f452892ae929d747eed45a
--- /dev/null
+++ b/bak/SRC/DIALOG/MSGLOG.H
@@ -0,0 +1,409 @@
+#ifndef BAK_MSGLOG_H
+#define BAK_MSGLOG_H
+
+/**
+ * @file  MSGLOG.H
+ * @brief Message-log (.MLG) v1 data core -- pure file/format layer.
+ *
+ * @details The in-game message log lets the player re-read NPC conversations,
+ *          quest hints and story text they have already seen.  This module is
+ *          the *data* half only: it owns the on-disk MLG v1 container, the
+ *          append/scan protocol and the recording state machine.  It knows
+ *          nothing about the dialog VM, the renderer, the save-game slots or
+ *          the UI -- callers hand it already-resolved bytes.
+ *
+ *          Deliberate dependency floor (keeps it linkable and testable on its
+ *          own, and keeps the resident cost near zero): the C runtime plus
+ *          @c SRC/IO/DOSRW.H.  No allocator: the two operations that need a
+ *          block buffer (snapshot copy, whole-history CRC) borrow one the
+ *          caller installs with @ref msglog_set_scratch and may take back
+ *          afterwards.  Nothing in this module ever touches
+ *          @c g_pMainScratchBuf, which savegame_write() is using at exactly
+ *          the moment a snapshot is taken.
+ *
+ *          Byte layout, endianness, checksum ranges and worked golden fixtures
+ *          are frozen in docs/research/message-log-format.md (main repo).
+ *          Every integer is written field by field, little endian; no C struct
+ *          is ever handed to write().
+ */
+
+/* ------------------------------------------------------------------ */
+/* Format constants -- keep in lock-step with tools/text/message_log.py */
+/* ------------------------------------------------------------------ */
+
+#define MSGLOG_MAGIC0 'B'
+#define MSGLOG_MAGIC1 'K'
+#define MSGLOG_MAGIC2 'M'
+#define MSGLOG_MAGIC3 'L'
+
+#define MSGLOG_FORMAT_VERSION 1
+#define MSGLOG_HEADER_SIZE 64
+#define MSGLOG_EVENT_HEAD_SIZE 52
+#define MSGLOG_EVENT_MIN_RECORD (MSGLOG_EVENT_HEAD_SIZE + 4)
+
+/** Encoding id 1 = the BAK-ZH compact 2-byte game encoding (see ADR-001). */
+#define MSGLOG_ENCODING_BAKZH_V1 1
+
+/**
+ * CRC32 of the canonical serialization of localization/generated/zh_mapping.json.
+ * Generated by `python -m tools.text.message_log fingerprint --c-define`; a
+ * mapping change that would turn stored history into mojibake makes an old file
+ * fail to load instead of rendering garbage.
+ */
+#define MSGLOG_MAPPING_FINGERPRINT 0x9659C961UL
+
+/* Per-field caps. A record therefore never exceeds MSGLOG_MAX_RECORD bytes,
+   which is what lets the reader bound-check before it indexes. */
+#define MSGLOG_MAX_SPEAKER 64
+#define MSGLOG_MAX_LOCATION 64
+#define MSGLOG_MAX_BODY 512
+#define MSGLOG_MAX_RECORD (MSGLOG_EVENT_HEAD_SIZE + MSGLOG_MAX_SPEAKER + \
+                           MSGLOG_MAX_LOCATION + MSGLOG_MAX_BODY + 4)
+
+/** Hard ceiling on a .MLG file: keeps every offset + length sum inside lseek's
+ *  signed long, with three orders of magnitude to spare. */
+#define MSGLOG_MAX_FILE 0x3FFFFFFFL
+
+/* --- header flags --- */
+#define MSGLOG_HF_SNAPSHOT 0x0001  /**< save-slot snapshot (else: live working file) */
+#define MSGLOG_HF_HAS_GAP 0x0002   /**< timeline contains a recording gap */
+#define MSGLOG_HF_SEALED 0x0004    /**< header last written by a clean close */
+#define MSGLOG_HF_DATA_CRC 0x0008  /**< data_crc32 covers [64, committed_length) */
+#define MSGLOG_HF_GAM_BOUND 0x0010 /**< bound_gam_length/crc32 are meaningful */
+
+/* --- event kinds --- */
+#define MSGLOG_KIND_NONE 0
+#define MSGLOG_KIND_CONV_BEGIN 1
+#define MSGLOG_KIND_TEXT 2
+#define MSGLOG_KIND_CHOICE 3
+#define MSGLOG_KIND_CONV_END 4
+#define MSGLOG_KIND_GAP 5
+#define MSGLOG_KIND_SCENE 6
+
+/* --- event flags --- */
+#define MSGLOG_EV_CONTINUED 0x0001 /**< body continues the previous record's body */
+#define MSGLOG_EV_MORE 0x0002      /**< a further fragment follows */
+#define MSGLOG_EV_NARRATION 0x0004 /**< no speaker (narration / unknown) */
+#define MSGLOG_EV_TRUNCATED 0x0008 /**< body was cut short at the source */
+
+/* --- result codes: every failure is distinguishable --- */
+#define MSGLOG_OK 0
+#define MSGLOG_E_STATE -1      /**< call is not legal in the current state */
+#define MSGLOG_E_PARAM -2      /**< bad argument */
+#define MSGLOG_E_NOMEM -3      /**< no scratch buffer installed / too small */
+#define MSGLOG_E_OPEN -4       /**< open()/creat() failed */
+#define MSGLOG_E_IO -5         /**< read/write/seek/close failed */
+#define MSGLOG_E_MAGIC -6      /**< not an MLG file */
+#define MSGLOG_E_VERSION -7    /**< unsupported format_version */
+#define MSGLOG_E_HEADER -8     /**< header_length or header CRC32 bad */
+#define MSGLOG_E_ENCODING -9   /**< encoding id or mapping fingerprint mismatch */
+#define MSGLOG_E_CRC -10       /**< data or event CRC32 mismatch */
+#define MSGLOG_E_TRUNC -11     /**< file shorter than it declares */
+#define MSGLOG_E_RANGE -12     /**< length/offset out of range or would overflow */
+#define MSGLOG_E_BINDING -13   /**< bound GAM length/CRC does not match the save */
+#define MSGLOG_E_FULL -14      /**< MSGLOG_MAX_FILE reached; recording stops */
+#define MSGLOG_E_EMPTY -15     /**< no events / no such event */
+#define MSGLOG_E_SUPPRESSED -16 /**< ignored on purpose (transition/viewer) */
+
+/* --- states --- */
+#define MSGLOG_STATE_INACTIVE 0
+#define MSGLOG_STATE_ACTIVE 1
+#define MSGLOG_STATE_TRANSITION 2
+#define MSGLOG_STATE_VIEWER 3
+#define MSGLOG_STATE_FAILED 4
+
+/** CRC-32/ISO-HDLC running value before the final xor. */
+#define MSGLOG_CRC32_INIT 0xFFFFFFFFUL
+#define MSGLOG_CRC32_FINAL(c) ((c) ^ 0xFFFFFFFFUL)
+
+/** Minimum scratch block @ref msglog_set_scratch accepts. */
+#define MSGLOG_MIN_SCRATCH 512
+
+/**
+ * @brief Wall-clock stamp, as read straight from DOS (getdate/gettime).
+ *
+ * Stored as a plain 8-byte field group, not a packed FAT datetime: the feature
+ * spec asks for second resolution and a literal `YYYY-MM-DD HH:MM:SS` display,
+ * which the 2-second FAT encoding cannot express.
+ */
+typedef struct {
+    unsigned short year;
+    unsigned char month;
+    unsigned char day;
+    unsigned char hour;
+    unsigned char minute;
+    unsigned char second;
+    unsigned char hundredth;
+} MsgLogTime;
+
+/**
+ * @brief Everything about "who/where/when" that the caller has already resolved.
+ *
+ * @details The speaker and location strings are a *snapshot*: the caller must
+ *          pass bytes it owns right now.  Never hand over a pointer into the
+ *          keyword table or a DDX record -- both are freed when the dialog
+ *          ends (askabout_keyword_table_free / dialog_freemem_if_not_null).
+ *          This module copies straight to disk before returning.
+ */
+typedef struct {
+    unsigned short chapter;
+    unsigned short zone_id;
+    unsigned short scene_id;   /**< 0xFFFF when not in a town/interior scene */
+    unsigned short speaker_id; /**< DDXRecord.wSpeaker_id; 0 = narration */
+    unsigned long source_key;  /**< DDX record key */
+    unsigned short source_file; /**< record_key/100000; 0xFFFF when unknown */
+    unsigned short flags;      /**< MSGLOG_EV_NARRATION etc.; frag bits are set here */
+    const unsigned char far *speaker;  /**< may be 0 */
+    unsigned short speaker_len;
+    const unsigned char far *location; /**< may be 0 */
+    unsigned short location_len;
+} MsgLogContext;
+
+/** @brief One decoded event record head (in-memory only; never serialized). */
+typedef struct {
+    unsigned short kind;
+    unsigned short flags;
+    unsigned long sequence;
+    unsigned long conversation;
+    unsigned long prev_offset;
+    MsgLogTime when;
+    unsigned short chapter;
+    unsigned short zone_id;
+    unsigned short scene_id;
+    unsigned short speaker_id;
+    unsigned long source_key;
+    unsigned short source_file;
+    unsigned short fragment_index;
+    unsigned short speaker_len;
+    unsigned short location_len;
+    unsigned short body_len;
+    long offset;                /**< where this record starts */
+    unsigned long record_length; /**< total bytes of the record */
+} MsgLogEvent;
+
+/* ------------------------------------------------------------------ */
+/* Lifecycle + state                                                   */
+/* ------------------------------------------------------------------ */
+
+/** @brief Reset all module state to MSGLOG_STATE_INACTIVE. Call once at boot. */
+extern void far msglog_init(void);
+
+/**
+ * @brief Install (or remove, with @p buf == 0) the block buffer used by the
+ *        snapshot copy, the whole-history CRC pass and crash recovery.
+ * @return MSGLOG_OK, or MSGLOG_E_PARAM when a non-null buffer is smaller than
+ *         MSGLOG_MIN_SCRATCH.
+ * @note   Nothing else in the module allocates, so the caller decides exactly
+ *         when conventional memory is spent.
+ */
+extern int far msglog_set_scratch(unsigned char far *buf, unsigned int size);
+
+/** @brief Composite state for the UI: FAILED wins, then VIEWER, then TRANSITION. */
+extern int far msglog_state(void);
+
+/** @brief The underlying state, ignoring viewer/transition suppression. */
+extern int far msglog_base_state(void);
+
+/** @brief Non-zero when an append would actually be recorded right now. */
+extern int far msglog_recording_enabled(void);
+
+/** @brief The result code of the call that put the module into FAILED. */
+extern int far msglog_last_error(void);
+
+/* Suppression is a *counter*, layered over the base state. Leaving a viewer or
+   a transition therefore restores whatever the base state was -- a timeline
+   that had already failed stays failed and never silently becomes active. */
+extern void far msglog_enter_transition(void);
+extern void far msglog_leave_transition(void);
+extern void far msglog_enter_viewer(void);
+extern void far msglog_leave_viewer(void);
+
+/* ------------------------------------------------------------------ */
+/* Timeline files                                                      */
+/* ------------------------------------------------------------------ */
+
+/**
+ * @brief Create (truncating) a fresh, empty working timeline at @p path.
+ * @param now Creation stamp recorded in the header.
+ * @return MSGLOG_OK -> state becomes ACTIVE; otherwise MSGLOG_E_OPEN / _IO.
+ */
+extern int far msglog_new_timeline(const char *path, const MsgLogTime far *now);
+
+/**
+ * @brief Reopen an existing working timeline and determine its committed tail.
+ *
+ * @details Trusts the header when its CRC32 validates, the declared committed
+ *          length fits the file and the last record verifies.  Otherwise it
+ *          rescans forward from the header, keeping the longest prefix whose
+ *          records all pass their own CRC32 -- an interrupted append loses only
+ *          the partial record, never the history before it.  Anything past the
+ *          committed tail is truncated away on the first append.
+ */
+extern int far msglog_open_working(const char *path);
+
+/** @brief Flush the header with SEALED set and close. Safe to call when inactive. */
+extern int far msglog_shutdown(void);
+
+/** @brief Record a "history has a hole here" marker and set the HAS_GAP flag. */
+extern int far msglog_append_gap(const MsgLogTime far *now);
+
+/* ------------------------------------------------------------------ */
+/* Recording                                                           */
+/* ------------------------------------------------------------------ */
+
+/**
+ * @brief Open a conversation scope. Nested calls only deepen the scope.
+ * @return MSGLOG_OK, or MSGLOG_E_SUPPRESSED when recording is suppressed.
+ */
+extern int far msglog_conv_begin(const MsgLogContext far *ctx, const MsgLogTime far *now);
+
+/** @brief Close the outermost conversation scope. Balanced with conv_begin. */
+extern int far msglog_conv_end(const MsgLogTime far *now);
+
+/** @brief The id of the conversation currently open, or 0. */
+extern unsigned long far msglog_conversation_id(void);
+
+/**
+ * @brief Append one visible text span.
+ *
+ * @details Bodies longer than MSGLOG_MAX_BODY are split into consecutive
+ *          fragments at a boundary that never cuts a BAK-ZH double-byte glyph;
+ *          continuation fragments carry MSGLOG_EV_CONTINUED and every fragment
+ *          but the last carries MSGLOG_EV_MORE.
+ * @param body May be 0 only when @p body_len is 0.
+ */
+extern int far msglog_append_span(const MsgLogContext far *ctx, const MsgLogTime far *now,
+                                  const unsigned char huge *body, unsigned int body_len);
+
+/** @brief Append the topic/answer the player actually confirmed (never a candidate). */
+extern int far msglog_append_choice(const MsgLogContext far *ctx, const MsgLogTime far *now,
+                                    const unsigned char huge *label, unsigned int label_len);
+
+/** @brief Append a town/interior caption span (display path 4, not a conversation). */
+extern int far msglog_append_scene(const MsgLogContext far *ctx, const MsgLogTime far *now,
+                                   const unsigned char huge *body, unsigned int body_len);
+
+/* ------------------------------------------------------------------ */
+/* Snapshots (save) and candidates (load)                              */
+/* ------------------------------------------------------------------ */
+
+/**
+ * @brief Stream the committed prefix of the working timeline into a sealed
+ *        snapshot at @p path, bound to a game file's length and CRC32.
+ * @note  Needs the scratch buffer. The working file is left untouched and open.
+ */
+extern int far msglog_prepare_snapshot(const char *path, unsigned long gam_length,
+                                       unsigned long gam_crc32);
+
+/**
+ * @brief Non-mutating test: is the snapshot at @p path a committed prefix of the
+ *        live working timeline, so it can be grown in place instead of recopied?
+ * @param old_header64 optional 64-byte destination for the snapshot's current
+ *        header image (phase 2 stashes it in the transaction marker as the
+ *        rollback point).
+ * @return MSGLOG_OK when extensible; a distinguishable code otherwise (the
+ *         caller then falls back to a full msglog_prepare_snapshot()).
+ */
+extern int far msglog_snapshot_extends_working(const char *path,
+                                               unsigned char far *old_header64);
+
+/**
+ * @brief Append only the records committed since the snapshot at @p path was
+ *        last written, and re-seal its header, bound to @p gam_length/@p gam_crc32.
+ *
+ * @details The whole-history @c data_crc32 is resumed from the snapshot's own
+ *          stored value (CRC32/ISO-HDLC's final xor is self-inverse), so the
+ *          existing prefix is never re-read. On any failure the snapshot is
+ *          restored byte-for-byte to its previous state before returning.
+ * @pre   Working file open; scratch installed; @ref msglog_snapshot_extends_working
+ *        would return MSGLOG_OK for @p path (re-checked internally).
+ */
+extern int far msglog_extend_snapshot(const char *path, unsigned long gam_length,
+                                      unsigned long gam_crc32);
+
+/**
+ * @brief Validate a snapshot that was just grown by @ref msglog_extend_snapshot:
+ *        header + GAM binding, the resumed whole-history CRC32, and a structural
+ *        walk of the records at/after @p tail_from only.
+ * @param prev_data_crc,prev_last_off,prev_events the snapshot's pre-extend
+ *        header values (from the transaction marker). Pass @p tail_from equal to
+ *        the pre-extend committed length.
+ */
+extern int far msglog_validate_snapshot_tail(const char *path, long tail_from,
+                                             unsigned long gam_length, unsigned long gam_crc32,
+                                             unsigned long prev_data_crc, long prev_last_off,
+                                             unsigned long prev_events);
+
+/**
+ * @brief Fully validate a snapshot before anything is replaced.
+ * @param gam_length,gam_crc32 the *actual* save file being loaded; pass 0/0 to
+ *        skip the binding check.
+ * @return MSGLOG_OK when the candidate is usable; a distinguishable code
+ *         (MSGLOG_E_MAGIC / _VERSION / _HEADER / _ENCODING / _CRC / _TRUNC /
+ *         _RANGE / _BINDING) otherwise. Never mutates the active timeline.
+ */
+extern int far msglog_load_candidate(const char *path, unsigned long gam_length,
+                                     unsigned long gam_crc32);
+
+/**
+ * @brief Replace the working timeline with the verified candidate.
+ * @pre   msglog_load_candidate() returned MSGLOG_OK.
+ * @note  Needs the scratch buffer. On failure the previous working file is
+ *        already closed, so the caller must treat it as "history unavailable"
+ *        and start a new timeline -- it must never fall back to the old one.
+ */
+extern int far msglog_activate_candidate(const char *work_path);
+
+/** @brief Drop a loaded candidate without activating it. */
+extern void far msglog_discard_candidate(void);
+
+/* ------------------------------------------------------------------ */
+/* Read-only access (the viewer path; never re-runs a DDX record)      */
+/* ------------------------------------------------------------------ */
+
+extern unsigned long far msglog_event_count(void);
+extern unsigned short far msglog_header_flags(void);
+
+/** @brief Offset of the first / last committed event. MSGLOG_E_EMPTY if none. */
+extern int far msglog_first_offset(long far *out);
+extern int far msglog_last_offset(long far *out);
+
+/** @brief Offset of the record after / before @p cur. MSGLOG_E_EMPTY at the ends. */
+extern int far msglog_next_offset(long cur, long far *out);
+extern int far msglog_prev_offset(long cur, long far *out);
+
+/** @brief Walk @p count events backwards from @p from -- the paging primitive. */
+extern int far msglog_page_start(long from, int count, long far *out);
+
+/**
+ * @brief Read one event. Any of the three destination buffers may be 0, in
+ *        which case that string is skipped; a buffer smaller than the stored
+ *        length is a MSGLOG_E_RANGE failure, never a silent truncation.
+ */
+extern int far msglog_read_event(long offset, MsgLogEvent far *ev,
+                                 unsigned char far *speaker, unsigned int speaker_cap,
+                                 unsigned char far *location, unsigned int location_cap,
+                                 unsigned char far *body, unsigned int body_cap);
+
+/* ------------------------------------------------------------------ */
+/* Shared helpers (phase 2 uses these to fingerprint the .GAM)         */
+/* ------------------------------------------------------------------ */
+
+extern unsigned long far msglog_crc32_update(unsigned long crc, const unsigned char huge *data,
+                                             unsigned int len);
+
+/** @brief Length + CRC32 of a whole file, read in scratch-sized chunks. */
+extern int far msglog_crc32_file(const char *path, unsigned long far *length_out,
+                                 unsigned long far *crc_out);
+
+/**
+ * @brief Longest prefix of @p len bytes that is <= @p limit and does not cut a
+ *        BAK-ZH double-byte glyph.
+ * @note  Scans forward tracking lead bytes (0x80..0xDF). A trail byte may
+ *        legitimately be '#' (0x23) or '@' (0x40), so a backward search for an
+ *        ASCII character would be wrong.
+ */
+extern unsigned int far msglog_split_point(const unsigned char huge *body, unsigned int len,
+                                           unsigned int limit);
+
+#endif
diff --git a/bak/SRC/DIALOG/MSGSAVE.C b/bak/SRC/DIALOG/MSGSAVE.C
new file mode 100644
index 0000000000000000000000000000000000000000..43822adceeb907e62a7b4a9bc595bf12e763a957
--- /dev/null
+++ b/bak/SRC/DIALOG/MSGSAVE.C
@@ -0,0 +1,541 @@
+#include <stdio.h>
+#include <string.h>
+#include <io.h>
+#include <dos.h>
+
+#include "SRC/DIALOG/MSGLOG.H"
+#include "SRC/DIALOG/MSGCAP.H"
+#include "SRC/DIALOG/MSGSAVE.H"
+#include "SRC/GAME/STATE/SAVEGAME.H"
+#include "SRC/GAME/STATE/GSTATE.H"
+#include "SRC/SYS/CFGPARSE.H"
+#include "SRC/SYS/DOSMEM.H"
+
+#define MSGSAVE_PATH_MAX 64
+#define MSGSAVE_SCRATCH 4096
+#define MSGSAVE_O_CREATE 0x8302
+#define MSGSAVE_O_RDONLY 0x8001
+#define MSGSAVE_O_RDWR 0x8002
+#define MSGSAVE_S_RW 0x0180
+/* Transaction marker. v1 (18 bytes) is still read so a save interrupted by an
+   older build can still be recovered; new markers are v2 (88 bytes) and carry
+   the MLG mode plus, for an in-place extend, the pre-extend 64-byte MLG header
+   as the rollback point. */
+#define MSGSAVE_MARK_V1_SIZE 18
+#define MSGSAVE_MARK_SIZE 88
+#define MSGSAVE_MLG_FULL 0
+#define MSGSAVE_MLG_EXTEND 1
+
+static int g_msgsaveCandidate = 0;
+#ifdef MSGSAVE_TEST
+int g_msgsaveTestStage = 0;
+int g_msgsaveTestCrashAfter = 0;
+#define MSGSAVE_CAPTURE_INIT()
+#define MSGSAVE_STAGE(n) (g_msgsaveTestStage = (n))
+#define MSGSAVE_CRASH(n) if (g_msgsaveTestCrashAfter == (n)) return 0
+#else
+#define MSGSAVE_CAPTURE_INIT() msgcap_init()
+#define MSGSAVE_STAGE(n)
+#define MSGSAVE_CRASH(n)
+#endif
+
+static void msgsave_now(MsgLogTime *t) {
+    struct date d;
+    struct time ti;
+    getdate(&d);
+    gettime(&ti);
+    t->year = d.da_year;
+    t->month = d.da_mon;
+    t->day = d.da_day;
+    t->hour = ti.ti_hour;
+    t->minute = ti.ti_min;
+    t->second = ti.ti_sec;
+    t->hundredth = ti.ti_hund;
+}
+
+static void msgsave_work_path(char *p) {
+    if (g_cfgTempDrive != 0)
+        sprintf(p, "%c:MSGWORK.MLG", g_cfgTempDrive);
+    else
+        strcpy(p, "MSGWORK.MLG");
+}
+
+static int msgsave_parts(const char *gam, char *dir, int *id) {
+    const char *base;
+    const char *slash;
+    int n;
+    slash = strrchr(gam, '\\');
+    base = slash == NULL ? gam : slash + 1;
+    if (strlen(base) != 10 || strnicmp(base, "SAVE", 4) != 0 ||
+        base[4] < '0' || base[4] > '9' || base[5] < '0' || base[5] > '9' ||
+        stricmp(base + 6, ".GAM") != 0)
+        return 0;
+    n = slash == NULL ? 0 : (int)(slash - gam);
+    if (n >= MSGSAVE_PATH_MAX - 14)
+        return 0;
+    if (n != 0)
+        memcpy(dir, gam, n);
+    dir[n] = '\0';
+    *id = (base[4] - '0') * 10 + base[5] - '0';
+    return 1;
+}
+
+static void msgsave_path(char *out, const char *dir, const char *name) {
+    if (*dir != '\0')
+        sprintf(out, "%s\\%s", dir, name);
+    else
+        strcpy(out, name);
+}
+
+static void msgsave_target(char *out, const char *dir, int id, const char *ext) {
+    char name[13];
+    sprintf(name, "SAVE%02d.%s", id, ext);
+    msgsave_path(out, dir, name);
+}
+
+static unsigned int msgsave_mark_sum(const unsigned char *p, int n) {
+    unsigned int s;
+    int i;
+    s = 0x4d53;
+    for (i = 0; i < n; i++)
+        s = (unsigned int)((s << 1) | (s >> 15)) ^ p[i];
+    return s;
+}
+
+static void msgsave_put32(unsigned char *p, unsigned long v) {
+    p[0] = (unsigned char)v;
+    p[1] = (unsigned char)(v >> 8);
+    p[2] = (unsigned char)(v >> 16);
+    p[3] = (unsigned char)(v >> 24);
+}
+
+static unsigned long msgsave_get32(const unsigned char *p) {
+    return (unsigned long)p[0] | ((unsigned long)p[1] << 8) |
+           ((unsigned long)p[2] << 16) | ((unsigned long)p[3] << 24);
+}
+
+static int msgsave_write_mark(const char *path, int id, int old_gam, int old_mlg, int mlg_mode,
+                              const unsigned char *mlg_old_hdr, unsigned long len,
+                              unsigned long crc) {
+    unsigned char b[MSGSAVE_MARK_SIZE];
+    int fd;
+    int i;
+    unsigned int sum;
+    memset(b, 0, sizeof(b));
+    b[0] = 'B'; b[1] = 'K'; b[2] = 'T'; b[3] = 'X'; b[4] = 2;
+    b[5] = (unsigned char)id; b[6] = (unsigned char)old_gam; b[7] = (unsigned char)old_mlg;
+    msgsave_put32(b + 8, len);
+    msgsave_put32(b + 12, crc);
+    b[16] = (unsigned char)mlg_mode;
+    if (mlg_mode == MSGSAVE_MLG_EXTEND && mlg_old_hdr != NULL)
+        for (i = 0; i < MSGLOG_HEADER_SIZE; i++)
+            b[18 + i] = mlg_old_hdr[i];
+    sum = msgsave_mark_sum(b, MSGSAVE_MARK_SIZE - 2);
+    b[MSGSAVE_MARK_SIZE - 2] = (unsigned char)sum;
+    b[MSGSAVE_MARK_SIZE - 1] = (unsigned char)(sum >> 8);
+    fd = open((char *)path, MSGSAVE_O_CREATE, MSGSAVE_S_RW);
+    if (fd < 0)
+        return 0;
+    if (write(fd, b, sizeof(b)) != sizeof(b)) {
+        close(fd); remove((char *)path); return 0;
+    }
+    if (close(fd) != 0) {
+        remove((char *)path); return 0;
+    }
+    return 1;
+}
+
+static int msgsave_read_mark(const char *path, int *id, int *old_gam, int *old_mlg, int *mlg_mode,
+                             unsigned char *mlg_old_hdr, unsigned long *len, unsigned long *crc) {
+    unsigned char b[MSGSAVE_MARK_SIZE];
+    long flen;
+    int fd;
+    int i;
+    unsigned int sum;
+    fd = open((char *)path, MSGSAVE_O_RDONLY);
+    if (fd < 0)
+        return access((char *)path, 0) == 0 ? -1 : 0;
+    flen = filelength(fd);
+    if ((flen != MSGSAVE_MARK_SIZE && flen != MSGSAVE_MARK_V1_SIZE) ||
+        read(fd, b, (unsigned)flen) != (int)flen) {
+        close(fd); return -1;
+    }
+    if (close(fd) != 0)
+        return -1;
+    if (b[0] != 'B' || b[1] != 'K' || b[2] != 'T' || b[3] != 'X' || b[5] > 99)
+        return -1;
+    if (b[4] == 1 && flen == MSGSAVE_MARK_V1_SIZE) {
+        sum = (unsigned int)b[16] | ((unsigned int)b[17] << 8);
+        if (sum != msgsave_mark_sum(b, 16))
+            return -1;
+        *mlg_mode = MSGSAVE_MLG_FULL;
+    } else if (b[4] == 2 && flen == MSGSAVE_MARK_SIZE) {
+        sum = (unsigned int)b[MSGSAVE_MARK_SIZE - 2] |
+              ((unsigned int)b[MSGSAVE_MARK_SIZE - 1] << 8);
+        if (sum != msgsave_mark_sum(b, MSGSAVE_MARK_SIZE - 2))
+            return -1;
+        *mlg_mode = b[16] == MSGSAVE_MLG_EXTEND ? MSGSAVE_MLG_EXTEND : MSGSAVE_MLG_FULL;
+        if (mlg_old_hdr != NULL)
+            for (i = 0; i < MSGLOG_HEADER_SIZE; i++)
+                mlg_old_hdr[i] = b[18 + i];
+    } else
+        return -1;
+    *id = b[5]; *old_gam = b[6] != 0; *old_mlg = b[7] != 0;
+    *len = msgsave_get32(b + 8); *crc = msgsave_get32(b + 12);
+    return 1;
+}
+
+static int msgsave_mlg_valid(const char *mlg, unsigned long gam_len,
+                             unsigned long gam_crc) {
+    int rc;
+    rc = msglog_load_candidate(mlg, gam_len, gam_crc);
+    msglog_discard_candidate();
+    return rc == MSGLOG_OK;
+}
+
+static int msgsave_pair_valid(const char *gam, const char *mlg,
+                              unsigned long expect_len, unsigned long expect_crc) {
+    unsigned long len;
+    unsigned long crc;
+    if (msglog_crc32_file(gam, &len, &crc) != MSGLOG_OK ||
+        len != expect_len || crc != expect_crc)
+        return 0;
+    return msgsave_mlg_valid(mlg, len, crc);
+}
+
+static int msgsave_gam_valid(const char *path) {
+    unsigned char h[GAM_SAVE_FILE_HEADER_SIZE];
+    long n;
+    int fd;
+    fd = open((char *)path, MSGSAVE_O_RDONLY);
+    if (fd < 0)
+        return 0;
+    n = filelength(fd);
+    if (n < GAM_SAVE_FILE_BASE_SIZE || n > GAM_SAVE_FILE_MAX_SIZE ||
+        read(fd, h, sizeof(h)) != sizeof(h)) {
+        close(fd); return 0;
+    }
+    if (close(fd) != 0)
+        return 0;
+    return h[98] == 0x16 && h[99] == 0;
+}
+
+static int msgsave_remove(const char *path) {
+    return access((char *)path, 0) != 0 || remove((char *)path) == 0;
+}
+
+static int msgsave_gam_crc_is(const char *gam, unsigned long expect_len, unsigned long expect_crc) {
+    unsigned long len;
+    unsigned long crc;
+    return msglog_crc32_file(gam, &len, &crc) == MSGLOG_OK && len == expect_len &&
+           crc == expect_crc;
+}
+
+/* Validate an extended snapshot without re-hashing its already-committed prefix:
+   the pre-extend header (from the marker) supplies the resume point. */
+static int msgsave_tail_valid(const char *mlg, const unsigned char *old_hdr, unsigned long gam_len,
+                              unsigned long gam_crc) {
+    return msglog_validate_snapshot_tail(mlg, (long)msgsave_get32(old_hdr + 24), gam_len, gam_crc,
+                                         msgsave_get32(old_hdr + 40),
+                                         (long)msgsave_get32(old_hdr + 36),
+                                         msgsave_get32(old_hdr + 28)) == MSGLOG_OK;
+}
+
+/* Roll an in-place-extended snapshot back to its pre-save bytes. Idempotent. */
+static int msgsave_mlg_restore(const char *mlg, long old_len, const unsigned char *old_hdr) {
+    int fd;
+    int ok;
+    fd = open((char *)mlg, MSGSAVE_O_RDWR);
+    if (fd < 0)
+        return 0;
+    ok = chsize(fd, old_len) == 0 && lseek(fd, 0L, 0) == 0L &&
+         write(fd, (char *)old_hdr, MSGLOG_HEADER_SIZE) == MSGLOG_HEADER_SIZE;
+    if (close(fd) != 0)
+        ok = 0;
+    return ok;
+}
+
+static int msgsave_mlg_rollback(const char *target_mlg, const char *new_mlg, int had_mlg,
+                                const char *old_mlg_path, int mlg_mode, long mlg_old_len,
+                                const unsigned char *mlg_old_hdr) {
+    if (mlg_mode == MSGSAVE_MLG_EXTEND) {
+        if (access((char *)target_mlg, 0) != 0) {
+            if (access((char *)new_mlg, 0) != 0 ||
+                rename((char *)new_mlg, (char *)target_mlg) != 0)
+                return 0;
+        }
+        return msgsave_mlg_restore(target_mlg, mlg_old_len, mlg_old_hdr);
+    }
+    if (had_mlg) {
+        if (access((char *)old_mlg_path, 0) == 0) {
+            remove((char *)target_mlg);
+            return rename((char *)old_mlg_path, (char *)target_mlg) == 0;
+        }
+        return access((char *)target_mlg, 0) == 0;
+    }
+    return msgsave_remove(target_mlg);
+}
+
+static int msgsave_recover_inner(const char *dir) {
+    char mark[MSGSAVE_PATH_MAX], target_gam[MSGSAVE_PATH_MAX], target_mlg[MSGSAVE_PATH_MAX];
+    char new_gam[MSGSAVE_PATH_MAX], new_mlg[MSGSAVE_PATH_MAX];
+    char old_gam_path[MSGSAVE_PATH_MAX], old_mlg_path[MSGSAVE_PATH_MAX];
+    unsigned char mlg_old_hdr[MSGLOG_HEADER_SIZE];
+    unsigned long len, crc;
+    long mlg_old_len;
+    int id, old_gam, old_mlg, mlg_mode, rc;
+
+    memset(mlg_old_hdr, 0, sizeof(mlg_old_hdr));
+    msgsave_path(mark, dir, "MLGTXN.DAT");
+    rc = msgsave_read_mark(mark, &id, &old_gam, &old_mlg, &mlg_mode, mlg_old_hdr, &len, &crc);
+    if (rc == 0)
+        return 1;
+    if (rc < 0)
+        return 0;
+    msgsave_target(target_gam, dir, id, "GAM");
+    msgsave_target(target_mlg, dir, id, "MLG");
+    msgsave_path(new_gam, dir, "MLGNEW.GAM"); msgsave_path(new_mlg, dir, "MLGNEW.MLG");
+    msgsave_path(old_gam_path, dir, "MLGOLD.GAM"); msgsave_path(old_mlg_path, dir, "MLGOLD.MLG");
+    mlg_old_len = (long)msgsave_get32(mlg_old_hdr + 24);
+
+    if (mlg_mode == MSGSAVE_MLG_EXTEND
+            ? (msgsave_gam_crc_is(target_gam, len, crc) &&
+               msgsave_tail_valid(target_mlg, mlg_old_hdr, len, crc))
+            : msgsave_pair_valid(target_gam, target_mlg, len, crc)) {
+        return msgsave_remove(old_gam_path) && msgsave_remove(old_mlg_path) &&
+               msgsave_remove(new_gam) && msgsave_remove(new_mlg) && msgsave_remove(mark);
+    }
+
+    if (old_gam) {
+        if (access(old_gam_path, 0) == 0) {
+            remove(target_gam);
+            if (rename(old_gam_path, target_gam) != 0)
+                return 0;
+        } else if (access(target_gam, 0) != 0)
+            return 0;
+    } else if (!msgsave_remove(target_gam))
+        return 0;
+
+    if (!msgsave_mlg_rollback(target_mlg, new_mlg, old_mlg, old_mlg_path, mlg_mode, mlg_old_len,
+                              mlg_old_hdr))
+        return 0;
+    return msgsave_remove(new_gam) && msgsave_remove(new_mlg) && msgsave_remove(mark);
+}
+
+static unsigned char far *msgsave_scratch_begin(void) {
+    unsigned char far *p;
+    p = (unsigned char far *)alloc_far_umb(MSGSAVE_SCRATCH);
+    if (p != NULL)
+        msglog_set_scratch(p, MSGSAVE_SCRATCH);
+    return p;
+}
+
+static void msgsave_scratch_end(unsigned char far *p) {
+    msglog_set_scratch(NULL, 0);
+    if (p != NULL)
+        _freemem(p);
+}
+
+void far msgsave_init(void) {
+    msglog_init();
+    MSGSAVE_CAPTURE_INIT();
+    g_msgsaveCandidate = 0;
+}
+
+void far msgsave_shutdown(void) {
+    msglog_discard_candidate();
+    msglog_shutdown();
+}
+
+int far msgsave_start_new(void) {
+    char work[MSGSAVE_PATH_MAX];
+    MsgLogTime now;
+    msglog_discard_candidate();
+    g_msgsaveCandidate = 0;
+    msgsave_work_path(work); msgsave_now(&now);
+    return msglog_new_timeline(work, &now);
+}
+
+int far msgsave_recover_for(const char *gam_path) {
+    char dir[MSGSAVE_PATH_MAX];
+    int id, ok;
+    unsigned char far *scratch;
+    if (!msgsave_parts(gam_path, dir, &id))
+        return 0;
+    scratch = msgsave_scratch_begin();
+    if (scratch == NULL)
+        return 0;
+    MSGSAVE_STAGE(1); ok = msgsave_recover_inner(dir);
+    if (!ok) {
+        msgsave_scratch_end(scratch);
+        return 0;
+    }
+    msgsave_scratch_end(scratch);
+    return ok;
+}
+
+int far msgsave_write_pair(const char *target_gam) {
+    char dir[MSGSAVE_PATH_MAX], target_mlg[MSGSAVE_PATH_MAX], new_gam[MSGSAVE_PATH_MAX];
+    char new_mlg[MSGSAVE_PATH_MAX], old_gam[MSGSAVE_PATH_MAX], old_mlg[MSGSAVE_PATH_MAX];
+    char mark[MSGSAVE_PATH_MAX];
+    unsigned char mlg_old_hdr[MSGLOG_HEADER_SIZE];
+    unsigned long len, crc;
+    long mlg_old_len;
+    unsigned char far *scratch;
+    int id, had_gam, had_mlg, mlg_extend, ok;
+    if (!msgsave_parts(target_gam, dir, &id))
+        return 0;
+    scratch = msgsave_scratch_begin();
+    if (scratch == NULL)
+        return 0;
+    ok = msgsave_recover_inner(dir);
+    /* A failed recovery owns every transaction artifact. Do not erase its
+       backups or staged pair while trying to start another save. */
+    if (!ok) {
+        msgsave_scratch_end(scratch);
+        return 0;
+    }
+    msgsave_target(target_mlg, dir, id, "MLG");
+    msgsave_path(new_gam, dir, "MLGNEW.GAM"); msgsave_path(new_mlg, dir, "MLGNEW.MLG");
+    msgsave_path(old_gam, dir, "MLGOLD.GAM"); msgsave_path(old_mlg, dir, "MLGOLD.MLG");
+    msgsave_path(mark, dir, "MLGTXN.DAT");
+    ok = msgsave_remove(new_gam) && msgsave_remove(new_mlg) &&
+         msgsave_remove(old_gam) && msgsave_remove(old_mlg);
+
+    had_gam = access(target_gam, 0) == 0;
+    had_mlg = access(target_mlg, 0) == 0;
+    mlg_old_len = 0L;
+    mlg_extend = ok && had_mlg &&
+                 msglog_snapshot_extends_working(target_mlg, mlg_old_hdr) == MSGLOG_OK;
+    if (mlg_extend)
+        mlg_old_len = (long)msgsave_get32(mlg_old_hdr + 24);
+
+    if (ok) { MSGSAVE_STAGE(2); ok = savegame_write(new_gam); }
+    if (ok) { MSGSAVE_STAGE(3); ok = msgsave_gam_valid(new_gam); }
+    if (ok) { MSGSAVE_STAGE(4); ok = msglog_crc32_file(new_gam, &len, &crc) == MSGLOG_OK; }
+
+    if (mlg_extend) {
+        /* Seed MLGNEW.MLG with the previous snapshot by moving it, then grow it
+           in place -- only the records committed since the last save to this
+           slot are written. No MLGOLD.MLG: the rollback point is the pre-extend
+           header carried in the marker. */
+        if (ok) { MSGSAVE_STAGE(5);
+                  ok = rename(target_mlg, new_mlg) == 0 &&
+                       msglog_extend_snapshot(new_mlg, len, crc) == MSGLOG_OK; }
+        if (ok) { MSGSAVE_STAGE(6); ok = msgsave_tail_valid(new_mlg, mlg_old_hdr, len, crc); }
+        if (!ok) {
+            /* Nothing durable has changed: restore the moved snapshot and bail. */
+            if (access(new_mlg, 0) == 0) {
+                msgsave_mlg_restore(new_mlg, mlg_old_len, mlg_old_hdr);
+                rename(new_mlg, target_mlg);
+            }
+            msgsave_scratch_end(scratch);
+            return 0;
+        }
+    } else {
+        if (ok) { MSGSAVE_STAGE(5); ok = msglog_prepare_snapshot(new_mlg, len, crc) == MSGLOG_OK; }
+        if (ok) { MSGSAVE_STAGE(6); ok = msgsave_mlg_valid(new_mlg, len, crc); }
+    }
+
+    if (ok) { MSGSAVE_STAGE(7);
+              ok = msgsave_write_mark(mark, id, had_gam, had_mlg,
+                                      mlg_extend ? MSGSAVE_MLG_EXTEND : MSGSAVE_MLG_FULL,
+                                      mlg_extend ? mlg_old_hdr : (unsigned char *)NULL,
+                                      len, crc); }
+    if (ok) { MSGSAVE_CRASH(7); }
+    if (ok && had_gam) { MSGSAVE_STAGE(8); ok = rename((char *)target_gam, old_gam) == 0; }
+    if (ok && had_gam) { MSGSAVE_CRASH(8); }
+    /* Stage 9 is the old MLG being set aside. In extend mode that already
+       happened at stage 5 (moved to MLGNEW.MLG), so the rename is skipped but
+       the checkpoint stays so an interruption here is still exercised. */
+    if (ok) { MSGSAVE_STAGE(9);
+              if (had_mlg && !mlg_extend) ok = rename(target_mlg, old_mlg) == 0; }
+    if (ok) { MSGSAVE_CRASH(9); }
+    if (ok) { MSGSAVE_STAGE(10); ok = rename(new_gam, (char *)target_gam) == 0; }
+    if (ok) { MSGSAVE_CRASH(10); }
+    if (ok) { MSGSAVE_STAGE(11); ok = rename(new_mlg, target_mlg) == 0; }
+    if (ok) { MSGSAVE_CRASH(11); }
+    /* Same-volume renames do not alter bytes; a GAM header check plus a tail-only
+       (extend) or full (fresh) MLG load catches a mismove without re-hashing the
+       whole save. */
+    if (ok) { MSGSAVE_STAGE(12); ok = msgsave_gam_valid(target_gam) &&
+                                      (mlg_extend
+                                           ? msgsave_tail_valid(target_mlg, mlg_old_hdr, len, crc)
+                                           : msgsave_mlg_valid(target_mlg, len, crc)); }
+    if (ok) {
+        /* Keep the marker until cleanup finishes, so a retry can finish it. */
+        ok = msgsave_remove(old_gam) && msgsave_remove(old_mlg) && msgsave_remove(mark);
+    } else if (access(mark, 0) == 0)
+        msgsave_recover_inner(dir);
+    else if (mlg_extend) {
+        if (access(new_mlg, 0) == 0) {
+            msgsave_mlg_restore(new_mlg, mlg_old_len, mlg_old_hdr);
+            rename(new_mlg, target_mlg);
+        }
+        remove(new_gam);
+    } else {
+        remove(new_gam); remove(new_mlg);
+    }
+    msgsave_scratch_end(scratch);
+    return ok;
+}
+
+int far msgsave_prepare_load(const char *gam_path) {
+    char dir[MSGSAVE_PATH_MAX], mlg[MSGSAVE_PATH_MAX];
+    unsigned long len, crc;
+    unsigned char far *scratch;
+    int id, rc;
+    msglog_discard_candidate();
+    g_msgsaveCandidate = 0;
+    if (!msgsave_parts(gam_path, dir, &id))
+        return 0;
+    scratch = msgsave_scratch_begin();
+    if (scratch == NULL)
+        return 0;
+    if (!msgsave_recover_inner(dir)) {
+        msgsave_scratch_end(scratch); return 0;
+    }
+    msgsave_target(mlg, dir, id, "MLG");
+    rc = msglog_crc32_file(gam_path, &len, &crc);
+    if (rc == MSGLOG_OK)
+        rc = msglog_load_candidate(mlg, len, crc);
+    g_msgsaveCandidate = rc == MSGLOG_OK;
+    msgsave_scratch_end(scratch);
+    return g_msgsaveCandidate;
+}
+
+int far msgsave_finish_load(int game_ok) {
+    char work[MSGSAVE_PATH_MAX];
+    MsgLogTime now;
+    unsigned char far *scratch;
+    int rc;
+    if (!game_ok) {
+        msglog_discard_candidate(); g_msgsaveCandidate = 0; return 1;
+    }
+    msgsave_work_path(work);
+    rc = MSGLOG_E_STATE;
+    if (g_msgsaveCandidate) {
+        scratch = msgsave_scratch_begin();
+        if (scratch != NULL) {
+            rc = msglog_activate_candidate(work);
+            msgsave_scratch_end(scratch);
+        }
+    } else
+        msglog_discard_candidate();
+    g_msgsaveCandidate = 0;
+    if (rc == MSGLOG_OK)
+        return 1;
+    msglog_discard_candidate();
+    msgsave_now(&now);
+    if (msglog_new_timeline(work, &now) == MSGLOG_OK)
+        msglog_append_gap(&now);
+    return 0;
+}
+
+void far msgsave_delete_companion(const char *gam_path) {
+    char dir[MSGSAVE_PATH_MAX], mlg[MSGSAVE_PATH_MAX];
+    int id;
+    if (msgsave_parts(gam_path, dir, &id)) {
+        msgsave_target(mlg, dir, id, "MLG"); remove(mlg);
+    }
+}

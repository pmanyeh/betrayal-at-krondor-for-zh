+static void font_restore_planar_write_mask(void) {
+    /* The VGA/EGA putpixel vtable entry selects one sequencer plane per
+       pixel and deliberately leaves that Map Mask behind.  Text drawing is
+       immediately followed by whole-rectangle buffer synchronisation, which
+       assumes all four planes are writable.  Restore the conventional 0Fh
+       mask for planar A000h framebuffers; packed/CGA renderers use another
+       segment and must not receive VGA sequencer I/O. */
+    if ((g_graphics_context.wGfxBlitDstPage & 0xf000) == 0xa000)
+        outpw(0x3c4, 0x0f02);
+}
+
+void font_init_chinese(void) {
+    ResFile *file;
+    char magic[4];
+    unsigned short ver, count;
+    unsigned char w, h, base_lead, pad[5];
+    unsigned long cjk_size;
+    unsigned long remaining;
+    unsigned long file_off;
+    unsigned char far *dst;
+    unsigned int chunk;
+
+    /* g_pZhAsciiBitmap (not g_pZhFontBitmap) is the "already initialized"
+       sentinel: in EMS mode g_pZhFontBitmap is deliberately never set, but
+       the ASCII block is always allocated conventionally either way. */
+    if (g_pZhAsciiBitmap != (unsigned char far *)0L) return;
+    file = res_fopen("ZH16.DAT", "rb");
+    if (file != (ResFile *)0) {
+        res_fread(magic, 4, 1, file);
+        res_fread(&ver, 2, 1, file);
+        res_fread(&w, 1, 1, file);
+        res_fread(&h, 1, 1, file);
+        res_fread(&count, 2, 1, file);
+        res_fread(&base_lead, 1, 1, file);
+        res_fread(pad, 5, 1, file);
+        if (magic[0] == 'Z' && magic[1] == 'H' && magic[2] == 'F' && magic[3] == 'N') {
+            g_nZhFontGlyphCount = count;
+            cjk_size = (unsigned long)count * 32L;
+
+            /* The CJK bitmap block grows with translated vocabulary (well
+               past 32K once the whole game is translated) and is never
+               freed for the rest of the session -- too large to keep
+               permanently resident in the scarce <640K conventional pool
+               alongside everything else the engine needs for interactive
+               gameplay. Prefer EMS (already used elsewhere for image
+               resources, see EMSIMG.C) and stream it in a page at a time;
+               fall back to conventional memory only when no EMS driver is
+               present. */
+            g_nZhFontEmsChain = g_ems_present ? ems_alloc_pages(cjk_size) : 0;
+            if (g_nZhFontEmsChain != 0) {
+                remaining = cjk_size;
+                file_off = 0L;
+                while (remaining > 0L) {
+                    chunk = (remaining > 16384L) ? 16384 : (unsigned int)remaining;
+                    dst = ems_map_at_offset(g_nZhFontEmsChain, file_off);
+                    res_fread_far(dst, 1L, (long)chunk, file);
+                    file_off += (unsigned long)chunk;
+                    remaining -= (unsigned long)chunk;
+                }
+            } else {
+                g_pZhFontBitmap = (unsigned char far *)alloc_far(cjk_size, 0L);
+                if (g_pZhFontBitmap != (unsigned char far *)0L &&
+                    FP_SEG(g_pZhFontBitmap) >= 0x0100) {
+                    res_fread_far(g_pZhFontBitmap, 1L, cjk_size, file);
+                } else {
+                    g_pZhFontBitmap = (unsigned char far *)0L;
+                }
+            }
+

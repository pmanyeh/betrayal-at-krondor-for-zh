+
+    if (effect_id < 0 || effect_id >= 9)
+        return -1L;
+    entry = g_gameState.aTimerEventPool;
+    for (i = 0; i < g_gameState.nTimerEventPoolCount; i++, entry++) {
+        if (entry->bKind == 2 && entry->wSub_id == (unsigned short)effect_id)
+            return entry->nValue;
+    }
+    return -1L;
+}

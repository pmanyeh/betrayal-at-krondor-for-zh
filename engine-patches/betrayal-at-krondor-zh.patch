+static int map_spell_landmark_header_read(SpellLandmarkHeader *header) {
+    header->magic = 0;
+    header->version = 0;
+    header->count = 0;
+    if (g_tempGamFP == (ResFile *)0 || sizeof(SpellLandmarkHeader) != GAM_SPELL_LANDMARK_HEADER_SIZE ||
+        sizeof(SpellLandmarkRecord) != GAM_SPELL_LANDMARK_RECORD_SIZE)
+        return 0;
+    if (!gstate_temp_file_read_at(header, GAM_SPELL_LANDMARK_EXT_OFFSET,
+                                  sizeof(SpellLandmarkHeader)))
+        return 0;
+    return header->magic == MAP_SPELL_LANDMARK_MAGIC &&
+           header->version == MAP_SPELL_LANDMARK_VERSION &&
+           header->count <= GAM_SPELL_LANDMARK_MAX_RECORDS;
+}
+
+static int map_spell_landmark_write(void far *src, unsigned long offset, unsigned int bytes) {
+    TempWriteRegion saved_region = g_pendingTempWriteRegion;
+    int result;
+
+    g_pendingTempWriteRegion = TWR_NONE;
+    result = gstate_temp_file_write_at((unsigned char far *)src, offset, bytes);
+    g_pendingTempWriteRegion = saved_region;
+    return result;
+}
+
+void far map_spell_landmark_discover_world_object(WorldObject far *object,
+                                                   unsigned char detection_mask) {
+    SpellLandmarkHeader header;
+    SpellLandmarkRecord records[MAP_SPELL_LANDMARK_READ_CHUNK];
+    unsigned short base;
+    unsigned short batch;
+    unsigned short i;
+    unsigned long offset;
+
+    if (object == (WorldObject far *)0 || detection_mask == 0 || g_tempGamFP == (ResFile *)0)
+        return;
+
+    if (!map_spell_landmark_header_read(&header)) {
+        header.magic = MAP_SPELL_LANDMARK_MAGIC;
+        header.version = MAP_SPELL_LANDMARK_VERSION;
+        header.count = 0;
+        if (!map_spell_landmark_write(&header, GAM_SPELL_LANDMARK_EXT_OFFSET,
+                                      sizeof(SpellLandmarkHeader)))
+            return;
+    }
+
+    for (base = 0; base < header.count; base += batch) {
+        batch = header.count - base;
+        if (batch > MAP_SPELL_LANDMARK_READ_CHUNK)
+            batch = MAP_SPELL_LANDMARK_READ_CHUNK;
+        offset = GAM_SPELL_LANDMARK_EXT_OFFSET + sizeof(SpellLandmarkHeader) +
+                 (unsigned long)base * sizeof(SpellLandmarkRecord);
+        if (!gstate_temp_file_read_at(records, offset,
+                                      batch * sizeof(SpellLandmarkRecord)))
+            return;
+        for (i = 0; i < batch; i++) {
+            if (records[i].zone == g_gameState.nZoneId &&
+                records[i].shape_id == object->shapeId &&
+                records[i].object_x == object->pos.xy.nWorld_x &&
+                records[i].object_y == object->pos.xy.nWorld_y) {
+                if ((records[i].detection_mask & detection_mask) != detection_mask) {
+                    records[i].detection_mask |= detection_mask;
+                    map_spell_landmark_write(&records[i],
+                                             offset + (unsigned long)i *
+                                                          sizeof(SpellLandmarkRecord),
+                                             sizeof(SpellLandmarkRecord));
+                }
+                return;
+            }
+        }
+    }
+
+    if (header.count >= GAM_SPELL_LANDMARK_MAX_RECORDS)
+        return;
+    records[0].zone = (unsigned char)g_gameState.nZoneId;
+    records[0].detection_mask = detection_mask;
+    records[0].shape_id = object->shapeId;
+    records[0].object_x = object->pos.xy.nWorld_x;
+    records[0].object_y = object->pos.xy.nWorld_y;
+    offset = GAM_SPELL_LANDMARK_EXT_OFFSET + sizeof(SpellLandmarkHeader) +
+             (unsigned long)header.count * sizeof(SpellLandmarkRecord);
+    if (!map_spell_landmark_write(&records[0], offset, sizeof(SpellLandmarkRecord)))
+        return;
+    header.count++;
+    map_spell_landmark_write(&header, GAM_SPELL_LANDMARK_EXT_OFFSET,
+                             sizeof(SpellLandmarkHeader));
+}
+
+/* Match world_render_record_marker_dot(), the original overhead-map marker
+ * projection used by detection spells.  The general 3-D actor transform also
+ * applies camera pitch/depth, which makes a flat map marker drift or leave the
+ * view at some map heights. */
+static int map_landmark_project(long world_x, long world_y, int *out_screen) {
+    int dx;
+    int dy;
+    long rx;
+    long ry;
+    long camera_z = g_world_camera->base.pos.nWorld_z;
+    int zoom = g_world_widget->zoom;
+
+    if (camera_z <= 0)
+        return 0;
+
+    dx = (int)(((world_x - g_world_camera->base.pos.xy.nWorld_x) * (1L << zoom)) / camera_z);
+    dy = (int)(((world_y - g_world_camera->base.pos.xy.nWorld_y) * (1L << zoom)) / camera_z);
+    rx = (r3d_imul_full32(dx, r3d_tbl_cos(-g_world_camera->base.orientation.yaw)) -
+          r3d_imul_full32(dy, r3d_tbl_sin(-g_world_camera->base.orientation.yaw))) >>
+         0xe;
+    ry = (r3d_imul_full32(dy, r3d_tbl_cos(-g_world_camera->base.orientation.yaw)) +
+          r3d_imul_full32(dx, r3d_tbl_sin(-g_world_camera->base.orientation.yaw))) >>
+         0xe;
+
+    out_screen[0] = g_world_widget->viewport.x + (g_world_widget->viewport.width >> 1) + (int)rx;
+    out_screen[1] = g_world_widget->viewport.y + (g_world_widget->viewport.height >> 1) - (int)ry;
+    return 1;
+}
+
+static int map_landmark_screen_radius(unsigned short shape_id, long depth) {
+    Shape far *shape = ts_get_shape(shape_id);
+    long world_radius;
+    long screen_scale;
+    long max_unclamped_world_radius;
+    long screen_radius;
+
+    if (shape == (Shape far *)0 || shape->radius <= 0 || depth <= 0)
+        return MAP_LANDMARK_FALLBACK_RADIUS;
+
+    world_radius = (long)shape->radius * (1L << shape->shift);
+    screen_scale = 1L << g_world_widget->zoom;
+
+    /* Test for the upper clamp before multiplying, keeping the 32-bit DOS
+     * calculation safe even for unusually large model bounds. */
+    max_unclamped_world_radius = (depth * MAP_LANDMARK_MAX_RADIUS) / screen_scale;
+    if (world_radius >= max_unclamped_world_radius)
+        return MAP_LANDMARK_MAX_RADIUS;
+
+    screen_radius = (world_radius * screen_scale) / depth;
+    if (screen_radius < MAP_LANDMARK_MIN_RADIUS)
+        return MAP_LANDMARK_MIN_RADIUS;
+    return (int)screen_radius;
+}
+
+static void map_landmark_draw_marker(int x, int y, int radius) {
+    g_graphics_context.bGfx_outline_color = MAP_LANDMARK_COLOR;
+    draw_line(x, y - radius, x + radius, y);
+    draw_line(x + radius, y, x, y + radius);
+    draw_line(x, y + radius, x - radius, y);
+    draw_line(x - radius, y, x, y - radius);
+    draw_line(x - 2, y, x + 2, y);
+    draw_line(x, y - 2, x, y + 2);
+}

+static void charscreen_draw_spell_book_actor(Combatant *actor, unsigned char far *pal_scratch) {
+    int school;
+    int selected;
+    int known_count;
+    int redraw;
+    int done;
+    int row;
+    unsigned int scancode;
+    short cursor_x;
+    short cursor_y;
+
+    if (gstate_actor_is_caster(actor) != 0) {
+        school = 0;
+        selected = 0;
+        known_count = charscreen_spellbook_load_school(actor, school);
+        charscreen_spellbook_draw(school, selected, known_count);
         g_pPalQueuedForFlip = pal_scratch = chunk_load_into_slot("INVENTOR.PAL");
         g_nPalBlendMode = 0;
         screen_frame_present();
         screen_frame_sync_buffers_rect(0, 200);
         cache_release(pal_scratch);
-        while (dialog_poll_arrow_or_button() == 0) {
-            screen_frame_present();
+        dialog_input_wait_release(1, 1);
+        redraw = 0;
+        done = 0;
+        while (done == 0) {
+            if (redraw != 0) {
+                known_count = charscreen_spellbook_load_school(actor, school);
+                if (known_count == 0)
+                    selected = 0;
+                else if (selected >= known_count)
+                    selected = known_count - 1;
+                charscreen_spellbook_draw(school, selected, known_count);
+                screen_frame_present();
+                screen_frame_sync_buffers_rect(0, 200);
+                redraw = 0;
+            } else {
+                screen_frame_present();
+            }
+            scancode = kbhit_read() >> 8;
+            if (scancode == 0x01) {
+                done = 1;
+            } else if (scancode == 0x4b) {
+                school = (school + SPELLBOOK_SCHOOL_COUNT - 1) % SPELLBOOK_SCHOOL_COUNT;
+                selected = 0;
+                redraw = 1;
+            } else if (scancode == 0x4d) {
+                school = (school + 1) % SPELLBOOK_SCHOOL_COUNT;
+                selected = 0;
+                redraw = 1;
+            } else if (scancode == 0x48 && known_count > 0) {
+                selected = (selected + known_count - 1) % known_count;
+                redraw = 1;
+            } else if (scancode == 0x50 && known_count > 0) {
+                selected = (selected + 1) % known_count;
+                redraw = 1;
+            }
+            if (g_mouse_installed != 0) {
+                if (mouse_button_pressed(1) != 0) {
+                    done = 1;
+                } else if (mouse_button_pressed(0) != 0) {
+                    screen_cursor_get_position(&cursor_x, &cursor_y);
+                    if (cursor_x >= 6 && cursor_x <= 0x2c) {
+                        for (row = 0; row < SPELLBOOK_SCHOOL_COUNT; row++) {
+                            if (cursor_y >= row * 0x20 + 5 &&
+                                cursor_y < row * 0x20 + 0x23) {
+                                school = row;
+                                selected = 0;
+                                redraw = 1;
+                            }
+                        }
+                    } else if (cursor_x >= SPELLBOOK_LIST_X - 2 &&
+                               cursor_x <= SPELLBOOK_LIST_XMAX) {
+                        row = (cursor_y - 6) / 0x17;
+                        if (cursor_y >= 6 && row >= 0 && row < known_count) {
+                            selected = row;
+                            redraw = 1;
+                        }
+                    }
+                    dialog_input_wait_release(1, 0);
+                }
+            }
+        }
+        dialog_input_wait_release(1, 1);
+    }
+}

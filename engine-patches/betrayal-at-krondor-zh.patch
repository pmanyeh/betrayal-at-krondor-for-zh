+                        charscreen_spellbook_draw_exit_button(1);
+                        screen_frame_present();
+                        done = 1;
+                    } else if (cursor_x >= 6 && cursor_x <= 0x2c) {
+                        for (row = 0; row < SPELLBOOK_SCHOOL_COUNT; row++) {
+                            if (cursor_y >= row * 0x20 + 5 &&
+                                cursor_y < row * 0x20 + 0x23) {
+                                school = row;
+                                selected = 0;
+                                redraw = 1;
+                            }
+                        }
+                    } else if (cursor_x >= SPELLBOOK_LIST_X - 2 &&
+                               cursor_x <= SPELLBOOK_LIST_XMAX) {
+                        row = (cursor_y - 6) / 0x17;
+                        if (cursor_y >= 6 && row >= 0 && row < known_count) {
+                            selected = row;
+                            redraw = 1;
+                        }
+                    }
+                    dialog_input_wait_release(1, 0);
+                }
+            }
+        }
+        dialog_input_wait_release(1, 1);
+    }

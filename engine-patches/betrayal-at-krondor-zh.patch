+int spellfx_event_caption_hit_test(int mouse_x, int mouse_y) {
+    int prev_slot;
+    int x;
+    int width;
+    int i;
+    int n;
+    int result;
+    char buf[10];
+    char glyph[2];
+
+    if (mouse_y < 0 || mouse_y >= 15)
+        return -1;
+
+    for (i = 0, n = 0; i < 9; i++) {
+        if (spellfx_event_mask_test_bit(i) != 0)
+            buf[n++] = g_event_caption_glyph_table[i] + 1;
+    }
+    buf[n] = 0;
+    if (n == 0)
+        return -1;
+
+    prev_slot = font_activate(0);
+    font_activate(g_nSpellFontSlot);
+    x = 0xA0 - (font_text_width_ds(buf) >> 1);
+    result = -1;
+    glyph[1] = 0;
+    for (i = 0; i < 9; i++) {
+        if (spellfx_event_mask_test_bit(i) == 0)
+            continue;
+        glyph[0] = g_event_caption_glyph_table[i] + 1;
+        width = font_text_width_ds(glyph);
+        if (mouse_x >= x && mouse_x < x + width) {
+            result = i;
+            break;
+        }
+        x += width;
+    }
+    font_activate(prev_slot);
+    return result;
+}
+
+long spellfx_event_remaining_ticks(int effect_id) {
+    TimerEventEntry *entry;

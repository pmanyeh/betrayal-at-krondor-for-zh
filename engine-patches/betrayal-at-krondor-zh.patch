+    viewport_x2 = g_world_widget->viewport.x + g_world_widget->viewport.width;
+    viewport_y2 = g_world_widget->viewport.y + g_world_widget->viewport.height;
+    x = (r->x < g_world_widget->viewport.x) ? g_world_widget->viewport.x : r->x;
+    y = (r->y < g_world_widget->viewport.y) ? g_world_widget->viewport.y : r->y;
+    x2 = r->x + r->width;
+    y2 = r->y + r->height;
+    if (x2 > viewport_x2)
+        x2 = viewport_x2;
+    if (y2 > viewport_y2)
+        y2 = viewport_y2;
+    if (x2 > x && y2 > y)
+        uiwidget_hotspot_outline_draw(x, y, x2 - x, y2 - y, color);
+}

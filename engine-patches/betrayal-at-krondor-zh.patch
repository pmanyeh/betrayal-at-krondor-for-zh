+static void map_north_compass_point(int center_x, int center_y, int right, int north,
+                                    int heading, int *out_x, int *out_y) {
+    *out_x = center_x +
+             (int)((r3d_imul_full32(right, r3d_tbl_cos(heading)) +
+                    r3d_imul_full32(north, r3d_tbl_sin(heading))) >>
+                   0xe);
+    *out_y = center_y +
+             (int)((r3d_imul_full32(right, r3d_tbl_sin(heading)) -
+                    r3d_imul_full32(north, r3d_tbl_cos(heading))) >>
+                   0xe);

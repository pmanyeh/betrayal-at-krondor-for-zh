+static void font_restore_planar_write_mask(void) {
+    /* The VGA/EGA putpixel vtable entry selects one sequencer plane per
+       pixel and deliberately leaves that Map Mask behind.  Text drawing is
+       immediately followed by whole-rectangle buffer synchronisation, which
+       assumes all four planes are writable.  Restore the conventional 0Fh
+       mask for planar A000h framebuffers; packed/CGA renderers use another
+       segment and must not receive VGA sequencer I/O. */
+    if ((g_graphics_context.wGfxBlitDstPage & 0xf000) == 0xa000)
+        outpw(0x3c4, 0x0f02);
+}

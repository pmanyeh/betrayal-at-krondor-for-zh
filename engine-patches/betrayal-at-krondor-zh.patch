+static void map_spell_landmark_draw_discovered(int xmin, int ymin, int xmax, int ymax) {
+    SpellLandmarkHeader header;
+    SpellLandmarkRecord records[MAP_SPELL_LANDMARK_READ_CHUNK];
+    unsigned short base;
+    unsigned short batch;
+    unsigned short i;
+    unsigned long offset;
+    int screen[2];
+
+    if (!map_spell_landmark_header_read(&header))
+        return;
+
+    for (base = 0; base < header.count; base += batch) {
+        batch = header.count - base;
+        if (batch > MAP_SPELL_LANDMARK_READ_CHUNK)
+            batch = MAP_SPELL_LANDMARK_READ_CHUNK;
+        offset = GAM_SPELL_LANDMARK_EXT_OFFSET + sizeof(SpellLandmarkHeader) +
+                 (unsigned long)base * sizeof(SpellLandmarkRecord);
+        if (!gstate_temp_file_read_at(records, offset,
+                                      batch * sizeof(SpellLandmarkRecord)))
+            return;
+        for (i = 0; i < batch; i++) {
+            if (records[i].zone != g_gameState.nZoneId || records[i].detection_mask == 0)
+                continue;
+            if (!map_landmark_project(records[i].object_x, records[i].object_y, screen))
+                continue;
+            if (screen[0] + 2 >= xmin && screen[0] - 2 <= xmax &&
+                screen[1] + 2 >= ymin && screen[1] - 2 <= ymax)
+                map_spell_landmark_draw_marker(screen[0], screen[1]);
+        }
+    }
+}
+
+void far map_landmark_draw_discovered(void) {
+    int screen[2];
+    int radius;
+    int xmin = g_world_widget->viewport.x;
+    int ymin = g_world_widget->viewport.y;
+    int xmax = g_world_widget->viewport.x + g_world_widget->viewport.width - 1;
+    int ymax = g_world_widget->viewport.y + g_world_widget->viewport.height - 1;
+    unsigned char saved_clip_enabled = g_graphics_context.bClip_enabled;
+    unsigned char saved_fill_enabled = g_graphics_context.bGfx_fill_enabled;
+    unsigned char saved_fill_color = g_graphics_context.bGfx_fill_color;
+    unsigned char saved_outline_color = g_graphics_context.bGfx_outline_color;
+    ClipRect saved_clip = g_graphics_context.clip;
+    int i;
+
+    g_graphics_context.bClip_enabled = 1;
+    g_graphics_context.clip.xmin = xmin;
+    g_graphics_context.clip.xmax = xmax;
+    g_graphics_context.clip.ymin = ymin;
+    g_graphics_context.clip.ymax = ymax;
+
+    for (i = 0; i < MAP_LANDMARK_COUNT; i++) {
+        MapLandmarkRecord *landmark = &s_mapLandmarks[i];
+
+        if (landmark->zone != g_gameState.nZoneId ||
+            gstate_event_read(LANDMARK_DISCOVERED(landmark->event_index)) == 0)
+            continue;
+
+        if (map_landmark_project(landmark->object_x, landmark->object_y, screen) == 0)
+            continue;
+        radius = map_landmark_screen_radius(landmark->shape_id,
+                                            g_world_camera->base.pos.nWorld_z);
+
+        if (screen[0] + radius >= xmin && screen[0] - radius <= xmax &&
+            screen[1] + radius >= ymin && screen[1] - radius <= ymax)
+            map_landmark_draw_marker(screen[0], screen[1], radius);
+    }
+
+    map_spell_landmark_draw_discovered(xmin, ymin, xmax, ymax);
+
+    g_graphics_context.bClip_enabled = saved_clip_enabled;
+    g_graphics_context.clip = saved_clip;
+    g_graphics_context.bGfx_fill_enabled = saved_fill_enabled;
+    g_graphics_context.bGfx_fill_color = saved_fill_color;
+    g_graphics_context.bGfx_outline_color = saved_outline_color;
+}

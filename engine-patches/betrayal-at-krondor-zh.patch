+static unsigned int msgview_wait_input(short *mouse_x, short *mouse_y) {
+    unsigned int key;
+
+    for (;;) {
+        screen_cur_refr_during_long_op();
+        key = kbhit_read() >> 8;
+        if (key != 0)
+            return key;
+        if (g_mouse_installed != 0) {
+            if (mouse_button_pressed(0) != 0) {
+                screen_cursor_get_position(mouse_x, mouse_y);
+                dialog_input_wait_release(0, 0);
+                return MSGVIEW_MOUSE_LEFT;
+            }
+            if (mouse_button_pressed(1) != 0) {
+                screen_cursor_get_position(mouse_x, mouse_y);
+                dialog_input_wait_release(0, 0);
+                return MSGVIEW_MOUSE_RIGHT;
+            }
+        }
+    }
+}
+
+static int msgview_same_speech(const MsgLogEvent far *first, const MsgLogEvent far *next) {
+    return first->kind == MSGLOG_KIND_TEXT && next->kind == MSGLOG_KIND_TEXT &&
+           first->conversation != 0 && first->conversation == next->conversation &&
+           first->speaker_id == next->speaker_id && first->source_key == next->source_key;
+}
+
+static long msgview_group_start(long offset) {
+    MsgLogEvent cur;
+    MsgLogEvent prev;
+    long prev_offset;
+
+    if (msglog_read_event(offset, &cur, NULL, 0, NULL, 0, NULL, 0) != MSGLOG_OK)
+        return offset;
+    while (msglog_prev_offset(offset, &prev_offset) == MSGLOG_OK) {
+        if (msglog_read_event(prev_offset, &prev, NULL, 0, NULL, 0, NULL, 0) != MSGLOG_OK ||
+            !msgview_same_speech(&prev, &cur))
+            break;
+        offset = prev_offset;
+        cur = prev;
+    }
+    return offset;
+}
+
+static int msgview_read(long offset, MsgLogEvent far *ev, unsigned char far **speaker,
+                        unsigned char far **location, unsigned char far **body) {
+    MsgLogEvent next_ev;
+    long next_offset;
+    unsigned int body_len;
+
+    offset = msgview_group_start(offset);
+    *speaker = g_pMainScratchBuf + MSGVIEW_SPEAKER_OFFSET;
+    *location = g_pMainScratchBuf + MSGVIEW_LOCATION_OFFSET;
+    *body = g_pMainScratchBuf + MSGVIEW_BODY_OFFSET;
+    if (msglog_read_event(offset, ev, *speaker, 64, *location, 64, *body,
+                          MSGVIEW_BODY_CAP) != MSGLOG_OK)
+        return 0;
+    body_len = ev->body_len;
+    next_offset = offset;
+    while (msglog_next_offset(next_offset, &next_offset) == MSGLOG_OK) {
+        if (msglog_read_event(next_offset, &next_ev, NULL, 0, NULL, 0, NULL, 0) != MSGLOG_OK ||
+            !msgview_same_speech(ev, &next_ev))
+            break;
+        if ((unsigned long)body_len + next_ev.body_len > MSGVIEW_BODY_CAP)
+            break;
+        if (msglog_read_event(next_offset, &next_ev, NULL, 0, NULL, 0,
+                              *body + body_len, MSGVIEW_BODY_CAP - body_len) != MSGLOG_OK)
+            return 0;
+        body_len += next_ev.body_len;
+    }
+    ev->body_len = body_len;
+    (*speaker)[ev->speaker_len] = 0;
+    (*location)[ev->location_len] = 0;
+    (*body)[ev->body_len] = 0;
+    if (ev->kind == MSGLOG_KIND_GAP)
+        *body = (unsigned char far *)g_msgviewGap;
+    else
+        while (**body != 0 && **body <= ' ')
+            (*body)++;
+    return 1;
+}
+
+static void msgview_frame(int detail, int has_pages) {
+    g_graphics_context.wGfxBlitDstPage = g_graphics_context.wVgaPage2Base;
+    uiwidget_panel_draw_inset(12, 12, 296, 172, 0xa9);
+    font_draw_text_ds(g_msgviewTitle, 20, 18);
+    if (msglog_base_state() == MSGLOG_STATE_FAILED)
+        font_draw_text_ds(g_msgviewStopped, 150, 18);
+    if (detail == 0) {
+        font_draw_text_ds(g_msgviewHelpList, 20, 167);
+    } else if (has_pages != 0) {
+        font_draw_text_ds(g_msgviewHelpDetailPage, 20, 167);
+    } else {
+        font_draw_text_ds(g_msgviewHelpDetailSingle, 20, 167);
+    }
+}
+
+static int msgview_visible(long offset) {
+    MsgLogEvent ev;
+    if (msglog_read_event(offset, &ev, NULL, 0, NULL, 0, NULL, 0) != MSGLOG_OK)
+        return 0;
+    return ev.kind == MSGLOG_KIND_TEXT || ev.kind == MSGLOG_KIND_CHOICE ||
+           ev.kind == MSGLOG_KIND_SCENE || ev.kind == MSGLOG_KIND_GAP;
+}
+
+static int msgview_step(long from, int newer, long far *out) {
+    MsgLogEvent group;
+    MsgLogEvent candidate;
+    long next;
+    int rc;
+
+    from = msgview_group_start(from);
+    if (newer != 0 &&
+        msglog_read_event(from, &group, NULL, 0, NULL, 0, NULL, 0) == MSGLOG_OK) {
+        for (;;) {
+            rc = msglog_next_offset(from, &next);
+            if (rc != MSGLOG_OK)
+                return rc;
+            if (msglog_read_event(next, &candidate, NULL, 0, NULL, 0, NULL, 0) != MSGLOG_OK)
+                return MSGLOG_E_IO;
+            if (!msgview_same_speech(&group, &candidate))
+                break;
+            from = next;
+        }
+        from = next;
+        if (msgview_visible(from) != 0) {
+            *out = msgview_group_start(from);
+            return MSGLOG_OK;
+        }
+    }
+    for (;;) {
+        rc = newer != 0 ? msglog_next_offset(from, &next) : msglog_prev_offset(from, &next);
+        if (rc != MSGLOG_OK)
+            return rc;
+        if (msgview_visible(next) != 0) {
+            *out = msgview_group_start(next);
+            return MSGLOG_OK;
+        }
+        from = next;
+    }
+}
+
+static int msgview_calc_pages(unsigned char far *body, int far *page_starts, int max_pages) {
+    int count;
+    int fl;
+    int n_pages;
+    int capacity;
+
+    fl = 0;
+    n_pages = 0;
+    capacity = 4;
+    count = textwrap_compute_lines((long)body, 280, (int *)0L, 90);
+    if (count <= 0) {
+        page_starts[0] = 0;
+        return 1;
+    }
+    while (fl < count && n_pages < max_pages) {
+        int total;
+        int drawn;
+
+        total = count - fl;
+        page_starts[n_pages++] = fl;
+        if (total <= capacity) {
+            break;
+        } else {
+            int pages;
+
+            pages = (total + capacity - 1) / capacity;
+            drawn = (total + pages - 1) / pages;
+            fl += drawn;
+        }
+    }
+    return n_pages > 0 ? n_pages : 1;
+}
+
+static void msgview_draw_list(long selected) {
+    MsgLogEvent ev;
+    unsigned char far *speaker;
+    unsigned char far *location;
+    unsigned char far *body;
+    char line[40];
+    long offset;
+    int row;
+
+    msgview_frame(0, 0);
+    offset = selected;
+    /* Three two-line summaries fit the 320x200 layout at the native 16px
+       Chinese size. Clip names through TEXTWRAP instead of drawing past the
+       right edge; the detail view retains the complete stored text. */
+    for (row = 0; row < 3 && offset >= MSGLOG_HEADER_SIZE; row++) {
+        if (!msgview_read(offset, &ev, &speaker, &location, &body)) {
+            font_draw_text_ds(g_msgviewBad, 20, 45);
+            break;
+        }
+        sprintf(line, "%c %04u-%02u-%02u %02u:%02u", row == 0 ? '>' : ' ', ev.when.year,
+                ev.when.month, ev.when.day, ev.when.hour, ev.when.minute);
+        font_draw_text_ds(line, 20, 40 + row * 40);
+        if (ev.speaker_len != 0)
+            textwrap_draw_aligned((long)speaker, 172, 40 + row * 40, 128, 16, 0, 0, 0);
+        else if (ev.location_len != 0)
+            textwrap_draw_aligned((long)location, 172, 40 + row * 40, 128, 16, 0, 0, 0);
+        else
+            font_draw_text_ds(g_msgviewNarrator, 172, 40 + row * 40);
+        /* Indent previews by two 16px Chinese glyph cells. */
+        textwrap_draw_aligned((long)body, 52, 58 + row * 40, 248, 16, 0, 0, 0);
+        if (msgview_step(offset, 0, &offset) != MSGLOG_OK)
+            break;
+    }
+    screen_frame_present();
+}
+
+static void msgview_draw_detail(long offset, int cur_page, int far *out_total_pages) {
+    MsgLogEvent ev;
+    unsigned char far *speaker;
+    unsigned char far *location;
+    unsigned char far *body;
+    char when[24];
+    char pageStr[16];
+    int page_starts[30];
+    int total_pages;
+    int firstLine;
+
+    if (!msgview_read(offset, &ev, &speaker, &location, &body)) {
+        msgview_frame(1, 0);
+        font_draw_text_ds(g_msgviewBad, 20, 45);
+        if (out_total_pages != NULL)
+            *out_total_pages = 1;
+        screen_frame_present();
+        return;
+    }
+
+    total_pages = msgview_calc_pages(body, page_starts, 30);
+    if (out_total_pages != NULL)
+        *out_total_pages = total_pages;
+    if (cur_page >= total_pages)
+        cur_page = total_pages - 1;
+    if (cur_page < 0)
+        cur_page = 0;
+    firstLine = page_starts[cur_page];
+
+    msgview_frame(1, total_pages > 1);
+    if (total_pages > 1) {
+        sprintf(pageStr, "\x89\x7d %d/%d", cur_page + 1, total_pages);
+        font_draw_text_ds(pageStr, 240, 18);
+    }
+    sprintf(when, "%04u-%02u-%02u %02u:%02u:%02u", ev.when.year, ev.when.month,
+            ev.when.day, ev.when.hour, ev.when.minute, ev.when.second);
+    font_draw_text_ds(g_msgviewWhen, 20, 35);
+    font_draw_text_ds(when, 65, 35);
+    font_draw_text_ds(g_msgviewWho, 20, 53);
+    if (ev.speaker_len != 0)
+        font_draw_text_far((char far *)speaker, 65, 53);
+    else
+        font_draw_text_ds(g_msgviewNarrator, 65, 53);
+    font_draw_text_ds(g_msgviewWhere, 20, 71);
+    font_draw_text_far((char far *)location, 65, 71);
+    textwrap_draw_aligned((long)body, 20, 90, 280, 74, 2, 0, firstLine);
+    screen_frame_present();
+}
+
+void far msgview_run(void) {
+    long selected;
+    long next;
+    unsigned int key;
+    short mouse_x;
+    short mouse_y;
+    int detail;
+    int cur_page;
+    int total_pages;
+    int running;
+    char savedMixed;
+    char savedSmall;
+
+    msglog_enter_viewer();
+    savedMixed = g_bMixedZhMode;
+    savedSmall = g_bSmallZhMode;
+    g_bMixedZhMode = 1;
+    g_bSmallZhMode = 0;
+    dialog_input_wait_release(0, 1);
+    screen_cursor_set_position(160, 100);
+    screen_cursor_set_shape(-1);
+
+    detail = 0;
+    cur_page = 0;
+    total_pages = 1;
+    running = 1;
+    if (msglog_last_offset(&selected) != MSGLOG_OK) {
+        msgview_frame(0, 0);
+        font_draw_text_ds(g_msgviewEmpty, 20, 45);
+        screen_frame_present();
+        do {
+            key = msgview_wait_input(&mouse_x, &mouse_y);
+        } while (key != 1 && key != MSGVIEW_MOUSE_LEFT && key != MSGVIEW_MOUSE_RIGHT);
+        g_bMixedZhMode = savedMixed;
+        g_bSmallZhMode = savedSmall;
+        msglog_leave_viewer();
+        return;
+    }
+    while (msgview_visible(selected) == 0 && msglog_prev_offset(selected, &selected) == MSGLOG_OK) {
+    }
+    selected = msgview_group_start(selected);
+    while (running != 0) {
+        if (detail != 0)
+            msgview_draw_detail(selected, cur_page, &total_pages);
+        else
+            msgview_draw_list(selected);
+        key = msgview_wait_input(&mouse_x, &mouse_y);
+        if (key == 1 || key == MSGVIEW_MOUSE_RIGHT) { /* Esc or right click */
+            if (detail != 0) {
+                detail = 0;
+                cur_page = 0;
+            } else {
+                running = 0;
+            }
+        } else if (key == MSGVIEW_MOUSE_LEFT) {
+            if (detail == 0) {
+                if (mouse_y >= 36 && mouse_y < 156) {
+                    int row;
+                    long clicked;
+
+                    row = (mouse_y - 36) / 40;
+                    clicked = selected;
+                    while (row > 0) {
+                        if (msgview_step(clicked, 0, &clicked) != MSGLOG_OK)
+                            break;
+                        row--;
+                    }
+                    if (row == 0) {
+                        selected = clicked;
+                        detail = 1;
+                        cur_page = 0;
+                    }
+                } else if (mouse_y >= 164 && mouse_y < 184) {
+                    running = 0;
+                }
+            } else if (mouse_y >= 164 && mouse_y < 184) {
+                detail = 0;
+                cur_page = 0;
+            } else if (mouse_x < 160) {
+                if (cur_page > 0)
+                    cur_page--;
+            } else if (cur_page + 1 < total_pages) {
+                cur_page++;
+            }
+        } else if (key == 0x1c) { /* Enter */
+            if (detail == 0) {
+                detail = 1;
+                cur_page = 0;
+            } else if (cur_page + 1 < total_pages) {
+                cur_page++;
+            }
+        } else if (key == 0x48) { /* Up */
+            if (msgview_step(selected, 1, &next) == MSGLOG_OK) {
+                selected = next;
+                cur_page = 0;
+            }
+        } else if (key == 0x50) { /* Down */
+            if (msgview_step(selected, 0, &next) == MSGLOG_OK) {
+                selected = next;
+                cur_page = 0;
+            }
+        } else if (detail != 0 && (key == 0x4b || key == 0x49)) { /* Left or PageUp */
+            if (cur_page > 0)
+                cur_page--;
+        } else if (detail != 0 && (key == 0x4d || key == 0x51 || key == 0x39)) { /* Right, PageDown, Space */
+            if (cur_page + 1 < total_pages)
+                cur_page++;
+        } else if (detail != 0 && key == 0x47) { /* Home */
+            cur_page = 0;
+        } else if (detail != 0 && key == 0x4f) { /* End */
+            cur_page = total_pages - 1;
+        }
+    }
+    g_bMixedZhMode = savedMixed;
+    g_bSmallZhMode = savedSmall;
+    msglog_leave_viewer();
+}

+             (g_world_widget->viewport.y + MAP_NORTH_COMPASS_Y_OFFSET);
+
+    return dx >= -MAP_NORTH_COMPASS_HIT_RADIUS && dx <= MAP_NORTH_COMPASS_HIT_RADIUS &&
+           dy >= -MAP_NORTH_COMPASS_HIT_RADIUS && dy <= MAP_NORTH_COMPASS_HIT_RADIUS;
+}

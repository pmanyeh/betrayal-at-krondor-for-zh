+    unsigned int oldest_sequence;
+    unsigned int old_icon;
+    int old_x;
+    int old_y;
+    int target_id;
+    int first_free;
+    int malformed_id;
+    int i;
+
+    if (!g_nAutosavePending || g_gameState.bCombatExitRequest != 0 ||
+        g_gameState.nWorldLoopExitRequest != 0)
+        return 0;
+
+    g_nAutosavePending = 0;
+    if (mainmenu_save_games_dir_exists() == 0 && mainmenu_save_games_dir_create() == 0)
+        return 0;
+    if (access("GAMES\\AutoSave.G99", 0) != 0 && mkdir("GAMES\\AutoSave.G99") != 0)
+        return 0;
+
+    mainmenu_autosave_recover_files();
+    getdate(&today);
+    current_date = (unsigned long)today.da_year * 10000L +
+                   (unsigned long)today.da_mon * 100L + (unsigned long)today.da_day;
+    max_sequence = 0;
+    oldest_date = 0;
+    oldest_sequence = 0;
+    first_free = 0;
+    malformed_id = 0;
+    target_id = 1;
+
+    for (i = 1; i <= AUTOSAVE_FILE_COUNT; i++) {
+        sprintf(path, "GAMES\\AutoSave.G99\\SAVE%02d.GAM", i);
+        if (access(path, 0) != 0) {
+            if (first_free == 0)
+                first_free = i;
+            continue;
+        }
+        if (!mainmenu_autosave_file_valid(path, title) ||
+            !mainmenu_autosave_title_parse(title, &date, &sequence)) {
+            if (malformed_id == 0)
+                malformed_id = i;
+            continue;
+        }
+        if (date == current_date && sequence > max_sequence)
+            max_sequence = sequence;
+        if (oldest_date == 0 || date < oldest_date ||
+            (date == oldest_date && sequence < oldest_sequence)) {
+            oldest_date = date;
+            oldest_sequence = sequence;
+            target_id = i;
+        }
+    }
+    if (first_free != 0)
+        target_id = first_free;
+    else if (malformed_id != 0)

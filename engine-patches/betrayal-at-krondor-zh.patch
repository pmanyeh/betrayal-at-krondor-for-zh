+static int mainmenu_autosave_title_parse(char *title, unsigned long *out_date,
+                                         unsigned int *out_sequence) {
+    unsigned long date;
+    unsigned int sequence;
+    int i;
+
+    date = 0;
+    for (i = 0; i < 8; i++) {
+        if (!isdigit(title[i]))
+            return 0;
+        date = date * 10L + (unsigned long)(title[i] - '0');
+    }
+    if (title[8] != '_')
+        return 0;
+    sequence = 0;
+    i = 9;
+    if (!isdigit(title[i]))
+        return 0;
+    while (isdigit(title[i])) {
+        sequence = sequence * 10U + (unsigned int)(title[i] - '0');
+        i++;
+    }
+    if (title[i] != '\0' || sequence == 0)
+        return 0;
+    *out_date = date;
+    *out_sequence = sequence;
+    return 1;
+}
+
+static int mainmenu_autosave_file_valid(char *path, char *title) {
+    int scratch;
+    int fd;
+    int ok;
+
+    ok = mainmenu_save_file_read_header(path, title, &scratch, &scratch, &scratch, &scratch);
+    if (!ok)
+        return 0;
+    fd = open(path, 0);
+    if (fd < 0)
+        return 0;
+    ok = (filelength(fd) >= GAM_SAVE_FILE_BASE_SIZE && filelength(fd) <= GAM_SAVE_FILE_MAX_SIZE);
+    close(fd);
+    return ok;
+}
+
+static void mainmenu_autosave_recover_files(void) {
+    char backup[50];
+    char target[50];
+    int i;
+
+    remove("GAMES\\AutoSave.G99\\AUTONEW.GAM");
+    for (i = 1; i <= AUTOSAVE_FILE_COUNT; i++) {
+        sprintf(backup, "GAMES\\AutoSave.G99\\AUTOB%02d.GAM", i);
+        sprintf(target, "GAMES\\AutoSave.G99\\SAVE%02d.GAM", i);
+        if (access(backup, 0) == 0) {
+            if (access(target, 0) == 0)
+                remove(backup);
+            else
+                rename(backup, target);
+        }
+    }
+}
+
+static int mainmenu_autosave_commit(char *temp_path, int target_id) {
+    char backup[50];
+    char target[50];
+
+    sprintf(backup, "GAMES\\AutoSave.G99\\AUTOB%02d.GAM", target_id);
+    sprintf(target, "GAMES\\AutoSave.G99\\SAVE%02d.GAM", target_id);
+    remove(backup);
+    if (access(target, 0) == 0) {
+        if (rename(target, backup) != 0)
+            return 0;
+    }
+    if (rename(temp_path, target) != 0) {
+        if (access(backup, 0) == 0)
+            rename(backup, target);
+        return 0;
+    }
+    remove(backup);
+    return 1;
+}
+
+void mainmenu_autosave_request(void) {
+    g_nAutosavePending = 1;
+}
+
+int mainmenu_autosave_service(void) {
+    struct date today;
+    char old_header[90];
+    char title[90];
+    char path[50];
+    char temp_path[50];
+    unsigned long current_date;
+    unsigned long date;
+    unsigned long oldest_date;
+    unsigned int sequence;
+    unsigned int max_sequence;
+    unsigned int oldest_sequence;
+    unsigned int old_icon;
+    int old_x;
+    int old_y;
+    int target_id;
+    int first_free;
+    int malformed_id;
+    int i;
+    int ok;
+
+    if (!g_nAutosavePending || g_gameState.bCombatExitRequest != 0 ||
+        g_gameState.nWorldLoopExitRequest != 0)
+        return 0;
+
+    g_nAutosavePending = 0;
+    if (mainmenu_save_games_dir_exists() == 0 && mainmenu_save_games_dir_create() == 0)
+        return 0;
+    if (access("GAMES\\AutoSave.G99", 0) != 0 && mkdir("GAMES\\AutoSave.G99") != 0)
+        return 0;
+
+    mainmenu_autosave_recover_files();
+    getdate(&today);
+    current_date = (unsigned long)today.da_year * 10000L +
+                   (unsigned long)today.da_mon * 100L + (unsigned long)today.da_day;
+    max_sequence = 0;
+    oldest_date = 0;
+    oldest_sequence = 0;
+    first_free = 0;
+    malformed_id = 0;
+    target_id = 1;
+
+    for (i = 1; i <= AUTOSAVE_FILE_COUNT; i++) {
+        sprintf(path, "GAMES\\AutoSave.G99\\SAVE%02d.GAM", i);
+        if (access(path, 0) != 0) {
+            if (first_free == 0)
+                first_free = i;
+            continue;
+        }
+        if (!mainmenu_autosave_file_valid(path, title) ||
+            !mainmenu_autosave_title_parse(title, &date, &sequence)) {
+            if (malformed_id == 0)
+                malformed_id = i;
+            continue;
+        }
+        if (date == current_date && sequence > max_sequence)
+            max_sequence = sequence;
+        if (oldest_date == 0 || date < oldest_date ||
+            (date == oldest_date && sequence < oldest_sequence)) {
+            oldest_date = date;
+            oldest_sequence = sequence;
+            target_id = i;
+        }
+    }
+    if (first_free != 0)
+        target_id = first_free;
+    else if (malformed_id != 0)
+        target_id = malformed_id;
+
+    memcpy(old_header, g_abSaveFileHeader, sizeof(old_header));

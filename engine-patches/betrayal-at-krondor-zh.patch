+static void charscreen_spellbook_load_doc(int spell_idx) {
+    int doc_count;
+    int first_row;
+    int row;
+    int pos;
+    int ch;
+    int narrative_started;
+    unsigned int blob_len;
+    long offsets[SPELLBOOK_DOC_ROWS];
+    long blob_start;
+    ResFile *file;
+
+    for (row = 0; row < SPELLBOOK_DOC_ROWS; row++)
+        g_spellbookDocRows[row][0] = '\0';
+    g_spellbookDocText[0] = '\0';
+    file = res_fopen("SpellDoc.dat", "rb");
+    if (file == (ResFile *)0)
+        return;
+    res_fread(&doc_count, 2, 1, file);
+    first_row = spell_idx * SPELLBOOK_DOC_ROWS;
+    if (first_row < 0 || first_row + SPELLBOOK_DOC_ROWS > doc_count) {
         res_fclose(file);
+        return;
+    }
+    res_fseek(file, 2L + (long)first_row * 4L, SEEK_SET);
+    res_fread(offsets, 4, SPELLBOOK_DOC_ROWS, file);
+    res_fseek(file, 2L + (long)doc_count * 4L, SEEK_SET);
+    res_fread(&blob_len, 2, 1, file);
+    blob_start = 4L + (long)doc_count * 4L;
+    for (row = 0; row < SPELLBOOK_DOC_ROWS; row++) {
+        if (offsets[row] >= (long)blob_len)
+            continue;
+        res_fseek(file, blob_start + offsets[row], SEEK_SET);
+        pos = 0;
+        while (pos < SPELLBOOK_DOC_ROW_LEN - 1) {
+            ch = res_fgetc(file);
+            if (ch <= 0)
+                break;
+            g_spellbookDocRows[row][pos++] = (char)ch;
+        }
+        g_spellbookDocRows[row][pos] = '\0';
+    }
+    res_fclose(file);
+    for (row = 1; row <= 4; row++) {
+        if (g_spellbookDocRows[row][0] != '\0') {
+            if (g_spellbookDocText[0] != '\0')
+                strcat(g_spellbookDocText, "\n");
+            strcat(g_spellbookDocText, g_spellbookDocRows[row]);
+        }
+    }
+    narrative_started = 0;
+    for (row = 5; row < SPELLBOOK_DOC_ROWS; row++) {
+        if (g_spellbookDocRows[row][0] != '\0') {
+            if (narrative_started == 0) {
+                if (g_spellbookDocText[0] != '\0')
+                    strcat(g_spellbookDocText, "\n\n");
+                narrative_started = 1;
+            } else {
+                strcat(g_spellbookDocText, "\n");
+            }
+            strcat(g_spellbookDocText, g_spellbookDocRows[row]);
+        }
+    }
+}

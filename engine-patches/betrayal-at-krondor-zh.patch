+                                *g_pMouseLookUiY);
+}
+
+static int worldloop_mouselook_poll(int *capture_active, short *ui_x, short *ui_y,
+                                    short *last_mouse_x, short *last_mouse_y) {
+    int wanted;
+    short mouse_x;
+    short mouse_y;
+    int dx;
+    int dy;
+    int pitch_offset;
+
+    wanted = g_bMouseLookMode != 0 && g_mouse_installed != 0 &&
+             key_is_down(MOUSELOOK_CTRL_SCANCODE) == 0;
+    if (wanted != 0 && *capture_active == 0) {
+        screen_cursor_get_position(&mouse_x, &mouse_y);
+        *ui_x = mouse_x;
+        *ui_y = mouse_y;
+        mouse_set_cursor_clip_rect(0, 0, g_wScreen_width, g_wScreen_height);
+        screen_cursor_set_hidden_flag(0);
+        screen_cursor_hide();
+        mouse_get_motion_delta(&dx, &dy);
+        *last_mouse_x = g_mouse_x_mickeys;
+        *last_mouse_y = g_mouse_y_mickeys;
+        g_world_camera->base.orientation.pitch =
+            g_nMouseLookBasePitch + g_nMouseLookPitchOffset;
+        *capture_active = 1;
+        return 1;
+    }
+    if (wanted == 0 && *capture_active != 0) {
+        worldloop_mouselook_release(capture_active, *ui_x, *ui_y);
+        return 1;
+    }
+    if (wanted == 0) {
+        if (g_bMouseLookMode != 0 && g_mouse_installed != 0) {
+            screen_cursor_get_position(&mouse_x, &mouse_y);
+            *ui_x = mouse_x;
+            *ui_y = mouse_y;
+        }
+        return 0;
+    }
+
+    mouse_get_motion_delta(&dx, &dy);
+    if (dx != 0 || dy != 0) {
+        /* INT 33h motion counters use the configured 8:8 mickey ratio, while
+           the legacy absolute callback stores quarter-pixel coordinates. */
+        dx *= MOUSELOOK_RELATIVE_TO_CURSOR_SCALE;
+        dy *= MOUSELOOK_RELATIVE_TO_CURSOR_SCALE;
+    } else {
+        /* Before DOSBox-X has completed host capture, retain ordinary absolute
+           movement as a fallback.  It may stop at the host image boundary, but
+           without recentering it can never manufacture repeated motion. */
+        dx = (short)(g_mouse_x_mickeys - *last_mouse_x);
+        dy = (short)(g_mouse_y_mickeys - *last_mouse_y);
+    }
+    *last_mouse_x = g_mouse_x_mickeys;
+    *last_mouse_y = g_mouse_y_mickeys;
+    if (dx == 0 && dy == 0)
+        return 0;
+    /* Positive mouse X is a right turn; the engine's right-turn convention
+       subtracts from yaw (worldmove_heading_step direction 3). */
+    g_world_camera->base.orientation.yaw -= (short)(dx * MOUSELOOK_YAW_PER_MICKEY);
+    /* Mouse up (negative Y motion) looks up in the active camera. */
+    pitch_offset = g_nMouseLookPitchOffset - dy * MOUSELOOK_PITCH_PER_MICKEY;
+    if (pitch_offset < -MOUSELOOK_PITCH_LIMIT)
+        pitch_offset = -MOUSELOOK_PITCH_LIMIT;
+    else if (pitch_offset > MOUSELOOK_PITCH_LIMIT)
+        pitch_offset = MOUSELOOK_PITCH_LIMIT;
+    g_nMouseLookPitchOffset = (short)pitch_offset;
+    g_world_camera->base.orientation.pitch =
+        g_nMouseLookBasePitch + g_nMouseLookPitchOffset;
+    return 1;
+}

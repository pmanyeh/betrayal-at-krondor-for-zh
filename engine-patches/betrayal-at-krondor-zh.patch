+unsigned int font_draw_zh_glyph_small(int lead, int trail, int x, int y) {
+    unsigned int gid;
+    int lead_idx, trail_idx;
+    unsigned char far *entry;
+    unsigned char far *glyph_ptr;
+    unsigned short i, entry_gid;
+    unsigned int row, col;
+    unsigned char bit_mask, byte_val;
+
+    if (g_pZhFontSmallBitmap == (unsigned char far *)0L) {
+        font_init_chinese_small();
+    }
+    if (g_pZhFontSmallBitmap == (unsigned char far *)0L) {
+        return 10;
+    }
+
+    lead_idx = (unsigned char)lead - 0x80;
+    if (trail >= 0x20 && trail <= 0x7E) {
+        trail_idx = trail - 0x20;
+    } else if (trail >= 0x80 && trail <= 0xDF) {
+        trail_idx = 95 + (trail - 0x80);
+    } else {
+        return 10;
+    }
+    gid = (unsigned int)lead_idx * 160 + trail_idx;
+
+    glyph_ptr = (unsigned char far *)0L;
+    if (FP_SEG(g_pZhFontSmallBitmap) == 0) {
+        /* ZHSTAT currently fits within the four contiguous 16K EMS page-frame
+           slots mapped by ems_map_at_offset(), so all 22-byte records remain
+           directly searchable even when one straddles a logical page. */
+        entry = ems_map_at_offset(FP_OFF(g_pZhFontSmallBitmap), 0L);
+    } else {
+        entry = g_pZhFontSmallBitmap;
+    }
+    for (i = 0; i < g_nZhFontSmallCount; i++) {
+        entry_gid = *(unsigned short far *)entry;
+        if (entry_gid == gid) {
+            glyph_ptr = entry + 2;
+            break;
+        }
+        entry += 22;
+    }
+    if (glyph_ptr == (unsigned char far *)0L) {
+        return 10;
+    }
+
+    row = 0;
+    while (row < 10) {
+        col = 0;
+        while (col < 10) {
+            byte_val = glyph_ptr[col >> 3];
+            bit_mask = 0x80 >> (col & 7);
+            if ((byte_val & bit_mask) != 0) {
+                putpixel(x + col, y, (char)g_graphics_context.bText_fg_color);
+            }
+            col++;
+        }
+        glyph_ptr += 2;
+        row++;
+        y++;
+    }
+    font_restore_planar_write_mask();
+    return 10;
+}

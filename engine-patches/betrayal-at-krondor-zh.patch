+/* Draw a clickable north arrow inside the upper-left of the close map.  When
+ * the map is north-locked its effective heading is zero, so the arrow remains
+ * upright; otherwise it rotates against the party-relative map. */
+static void map_north_compass_draw(void) {
+    static int local_right[6] = {0, -6, -2, 0, 2, 6};
+    static int local_north[6] = {9, -7, -4, -7, -4, -7};
+    int xs[6];
+    int ys[6];
+    int center_x;
+    int center_y;
+    int heading;
+    int i;
+    unsigned char saved_clip_enabled;
+    unsigned char saved_outline_color;
+    ClipRect saved_clip;
+
+    center_x = g_world_widget->viewport.x + MAP_NORTH_COMPASS_X_OFFSET;
+    center_y = g_world_widget->viewport.y + MAP_NORTH_COMPASS_Y_OFFSET;
+    heading = g_cfgNonRotatingMap ? 0 : g_world_camera->base.orientation.yaw;
+    for (i = 0; i < 6; i++) {
+        map_north_compass_point(center_x, center_y, local_right[i], local_north[i],
+                                heading, &xs[i], &ys[i]);
+    }
+
+    saved_clip_enabled = g_graphics_context.bClip_enabled;
+    saved_outline_color = g_graphics_context.bGfx_outline_color;
+    saved_clip = g_graphics_context.clip;
+    g_graphics_context.bClip_enabled = 1;
+    g_graphics_context.clip.xmin = g_world_widget->viewport.x;
+    g_graphics_context.clip.ymin = g_world_widget->viewport.y;
+    g_graphics_context.clip.xmax =
+        g_world_widget->viewport.x + g_world_widget->viewport.width - 1;
+    g_graphics_context.clip.ymax =
+        g_world_widget->viewport.y + g_world_widget->viewport.height - 1;
+
+    /* A one-pixel dark offset keeps the indicator visible over pale terrain. */
+    g_graphics_context.bGfx_outline_color = 0;
+    for (i = 0; i < 5; i++)
+        draw_line(xs[i] + 1, ys[i] + 1, xs[i + 1] + 1, ys[i + 1] + 1);
+    draw_line(xs[5] + 1, ys[5] + 1, xs[0] + 1, ys[0] + 1);
+
+    g_graphics_context.bGfx_outline_color =
+        g_cfgNonRotatingMap ? MAP_NORTH_COMPASS_LOCKED_COLOR
+                            : MAP_NORTH_COMPASS_UNLOCKED_COLOR;
+    for (i = 0; i < 5; i++)
+        draw_line(xs[i], ys[i], xs[i + 1], ys[i + 1]);
+    draw_line(xs[5], ys[5], xs[0], ys[0]);
+
+    g_graphics_context.bClip_enabled = saved_clip_enabled;
+    g_graphics_context.bGfx_outline_color = saved_outline_color;
+    g_graphics_context.clip = saved_clip;
+}

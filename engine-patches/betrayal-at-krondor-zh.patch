diff --git a/bak/SRC/DIALOG/MSGCAP.C b/bak/SRC/DIALOG/MSGCAP.C
new file mode 100644
index 0000000000000000000000000000000000000000..fd82bd72b8e45426127919496f700822a11774e3
--- /dev/null
+++ b/bak/SRC/DIALOG/MSGCAP.C
@@ -0,0 +1,233 @@
+#include <dos.h>
+#include <stdio.h>
+#include <string.h>
+#include "SRC/DIALOG/MSGCAP.H"
+#include "SRC/DIALOG/MSGLOG.H"
+#include "SRC/GAME/GMAIN.H"
+#include "SRC/GAME/MAINDATA.H"
+#include "SRC/SCREENS/BOOKVIEW.H"
+
+#define MSGCAP_SCOPE_MAX 8
+
+static unsigned char g_msgcapScope[MSGCAP_SCOPE_MAX];
+static unsigned short g_msgcapDepth;
+static unsigned short g_msgcapSourceKind;
+static unsigned short g_msgcapSpeakerId;
+static unsigned short g_msgcapSceneId;
+static unsigned long g_msgcapKey;
+static unsigned long g_msgcapDisplayId;
+static unsigned long g_msgcapNextDisplayId;
+static unsigned short g_msgcapMaxEnd;
+static unsigned short g_msgcapLastScroll;
+static unsigned char g_msgcapSpeaker[MSGLOG_MAX_SPEAKER];
+static unsigned short g_msgcapSpeakerLen;
+static unsigned char g_msgcapLocation[MSGLOG_MAX_LOCATION];
+static unsigned short g_msgcapLocationLen;
+
+static unsigned short copy_far(unsigned char *dst, unsigned short cap,
+                               const unsigned char far *src) {
+    unsigned short n;
+
+    n = 0;
+    if (src != NULL) {
+        while (n < cap && src[n] != 0) {
+            if (src[n] >= 0x80 && src[n] <= 0xdf) {
+                if (n + 1 >= cap || src[n + 1] == 0)
+                    break;
+                dst[n] = src[n];
+                dst[n + 1] = src[n + 1];
+                n += 2;
+                continue;
+            }
+            dst[n] = src[n];
+            n++;
+        }
+    }
+    return n;
+}
+
+static void now(MsgLogTime *stamp) {
+    struct date d;
+    struct time t;
+
+    getdate(&d);
+    gettime(&t);
+    stamp->year = d.da_year;
+    stamp->month = d.da_mon;
+    stamp->day = d.da_day;
+    stamp->hour = t.ti_hour;
+    stamp->minute = t.ti_min;
+    stamp->second = t.ti_sec;
+    stamp->hundredth = t.ti_hund;
+}
+
+static int excluded(unsigned long key) {
+    key &= 0x7fffffffUL;
+#include "SRC/DIALOG/CAPCLASS.INC"
+    return 0;
+}
+
+static int scope_enabled(void) {
+    unsigned short i;
+
+    if (g_msgcapDepth > MSGCAP_SCOPE_MAX)
+        return 0;
+    for (i = 0; i < g_msgcapDepth; i++) {
+        if (g_msgcapScope[i] == 0)
+            return 0;
+    }
+    return 1;
+}
+
+static void context(MsgLogContext *ctx) {
+    memset(ctx, 0, sizeof(*ctx));
+    ctx->chapter = g_gameState.nChapter;
+    ctx->zone_id = g_gameState.nZoneId;
+    ctx->scene_id = g_msgcapSceneId;
+    ctx->speaker_id = g_msgcapSpeakerId;
+    ctx->source_key = g_msgcapKey;
+    ctx->source_file = g_msgcapKey == 0 ? 0xffff : (unsigned short)(g_msgcapKey / 100000UL);
+    ctx->speaker = g_msgcapSpeakerLen == 0 ? NULL : g_msgcapSpeaker;
+    ctx->speaker_len = g_msgcapSpeakerLen;
+    ctx->location = g_msgcapLocation;
+    ctx->location_len = g_msgcapLocationLen;
+    if (g_msgcapSpeakerLen == 0)
+        ctx->flags |= MSGLOG_EV_NARRATION;
+}
+
+void far msgcap_init(void) {
+    g_msgcapDepth = 0;
+    g_msgcapSourceKind = 0;
+    g_msgcapSpeakerId = 0;
+    g_msgcapSceneId = 0xffff;
+    g_msgcapKey = 0;
+    g_msgcapDisplayId = 0;
+    g_msgcapNextDisplayId = 0;
+    g_msgcapMaxEnd = 0;
+    g_msgcapLastScroll = 0;
+    g_msgcapSpeakerLen = 0;
+    g_msgcapLocationLen = (unsigned short)sprintf((char *)g_msgcapLocation, "Zone %u",
+                                                  (unsigned int)g_gameState.nZoneId);
+}
+
+int far msgcap_scope_begin(unsigned long key, unsigned short speaker_id,
+                           const unsigned char far *speaker) {
+    MsgLogContext ctx;
+    MsgLogTime stamp;
+    int active;
+
+    active = !excluded(key);
+    if (active) {
+        msgcap_display(MSGCAP_DIALOG, key, speaker_id, speaker);
+        context(&ctx);
+        now(&stamp);
+        active = msglog_conv_begin(&ctx, &stamp) == MSGLOG_OK;
+    }
+    if (g_msgcapDepth < MSGCAP_SCOPE_MAX)
+        g_msgcapScope[g_msgcapDepth] = (unsigned char)active;
+    g_msgcapDepth++;
+    return active ? MSGLOG_OK : MSGLOG_E_SUPPRESSED;
+}
+
+void far msgcap_scope_end(void) {
+    MsgLogTime stamp;
+    int active;
+
+    if (g_msgcapDepth == 0)
+        return;
+    g_msgcapDepth--;
+    active = g_msgcapDepth < MSGCAP_SCOPE_MAX ? g_msgcapScope[g_msgcapDepth] : 0;
+    if (active) {
+        now(&stamp);
+        msglog_conv_end(&stamp);
+    }
+}
+
+void far msgcap_display(unsigned int source_kind, unsigned long key,
+                        unsigned short speaker_id, const unsigned char far *speaker) {
+    g_msgcapSourceKind = source_kind;
+    g_msgcapKey = key & 0x7fffffffUL;
+    g_msgcapSpeakerId = speaker_id;
+    g_msgcapSpeakerLen = copy_far(g_msgcapSpeaker, MSGLOG_MAX_SPEAKER, speaker);
+    g_msgcapNextDisplayId++;
+    if (g_msgcapNextDisplayId == 0)
+        g_msgcapNextDisplayId++;
+    g_msgcapDisplayId = g_msgcapNextDisplayId;
+    g_msgcapMaxEnd = 0;
+    g_msgcapLastScroll = 0xffff;
+    if (g_msgcapSceneId == 0xffff) {
+        g_msgcapLocationLen = (unsigned short)sprintf((char *)g_msgcapLocation, "Zone %u",
+                                                      (unsigned int)g_gameState.nZoneId);
+    }
+}
+
+int far msgcap_page(const unsigned char huge *text, unsigned short start,
+                    unsigned short end, unsigned short scroll) {
+    MsgLogContext ctx;
+    MsgLogTime stamp;
+
+    if (text == NULL || end <= start || g_msgcapDisplayId == 0 || excluded(g_msgcapKey) ||
+        !scope_enabled())
+        return MSGLOG_E_SUPPRESSED;
+    if (end <= g_msgcapMaxEnd || (scroll == g_msgcapLastScroll && end == g_msgcapMaxEnd))
+        return MSGLOG_E_SUPPRESSED;
+    g_msgcapMaxEnd = end;
+    g_msgcapLastScroll = scroll;
+    context(&ctx);
+    now(&stamp);
+    if (g_msgcapSourceKind == MSGCAP_SCENE)
+        return msglog_append_scene(&ctx, &stamp, text + start, end - start);
+    return msglog_append_span(&ctx, &stamp, text + start, end - start);
+}
+
+int far msgcap_rendered(unsigned short scroll) {
+    return msgcap_page((const unsigned char huge *)g_pMainScratchBuf,
+                       g_wTextWrapByteStart, g_wTextWrapByteEnd, scroll);
+}
+
+int far msgcap_choice(unsigned long key, const unsigned char huge *label,
+                      unsigned short label_len) {
+    MsgLogContext ctx;
+    MsgLogTime stamp;
+
+    if (label == NULL || excluded(key) || !scope_enabled())
+        return MSGLOG_E_SUPPRESSED;
+    if (label_len == 0) {
+        while (label[label_len] != 0 && label_len < MSGLOG_MAX_BODY)
+            label_len++;
+    }
+    if (label_len == 0)
+        return MSGLOG_E_SUPPRESSED;
+    g_msgcapKey = key & 0x7fffffffUL;
+    context(&ctx);
+    now(&stamp);
+    return msglog_append_choice(&ctx, &stamp, label, label_len);
+}
+
+void far msgcap_scene_enter(unsigned short scene_id, unsigned long key,
+                            const unsigned char far *title) {
+    int same;
+    int sameScene;
+
+    key &= 0x7fffffffUL;
+    sameScene = g_msgcapSceneId == scene_id;
+    same = g_msgcapSourceKind == MSGCAP_SCENE && g_msgcapSceneId == scene_id &&
+           g_msgcapKey == key;
+    g_msgcapSceneId = scene_id;
+    if (title != NULL)
+        g_msgcapLocationLen = copy_far(g_msgcapLocation, MSGLOG_MAX_LOCATION, title);
+    else if (!sameScene)
+        g_msgcapLocationLen = 0;
+    if (g_msgcapLocationLen == 0)
+        g_msgcapLocationLen = (unsigned short)sprintf((char *)g_msgcapLocation, "Zone %u",
+                                                      (unsigned int)g_gameState.nZoneId);
+    if (!same)
+        msgcap_display(MSGCAP_SCENE, key, 0, NULL);
+}
+
+void far msgcap_scene_leave(void) {
+    g_msgcapSceneId = 0xffff;
+    g_msgcapDisplayId = 0;
+    g_msgcapLocationLen = (unsigned short)sprintf((char *)g_msgcapLocation, "Zone %u",
+                                                  (unsigned int)g_gameState.nZoneId);
+}

+static void map_spell_landmark_draw_marker(int x, int y) {
+    g_graphics_context.bGfx_fill_enabled = 1;
+    g_graphics_context.bGfx_outline_color = MAP_SPELL_LANDMARK_COLOR;
+    g_graphics_context.bGfx_fill_color = MAP_SPELL_LANDMARK_COLOR;
+    draw_circle(2, x, y);
+}

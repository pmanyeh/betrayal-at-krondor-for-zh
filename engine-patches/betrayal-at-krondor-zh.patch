+unsigned short g_wTextWrapByteEnd;
+
+static unsigned char g_scratch[1024];
+static unsigned char g_text[] = "first second third";
+static unsigned char g_speaker[] = "NPC";
+static unsigned char g_choice[] = "Topic";
+static unsigned char g_title[] = "Inn";
+
+static void dump(void) {
+    MsgLogEvent ev;
+    unsigned char speaker[MSGLOG_MAX_SPEAKER];
+    unsigned char location[MSGLOG_MAX_LOCATION];
+    unsigned char body[MSGLOG_MAX_BODY];
+    long p;
+    int rc;
+
+    rc = msglog_first_offset(&p);
+    while (rc == MSGLOG_OK) {
+        memset(speaker, 0, sizeof(speaker));
+        memset(location, 0, sizeof(location));
+        memset(body, 0, sizeof(body));
+        rc = msglog_read_event(p, &ev, speaker, sizeof(speaker), location,
+                               sizeof(location), body, sizeof(body));
+        if (rc != MSGLOG_OK)
+            break;
+        printf("EV %u %lu %lu %u %u %u %u %u %u\n", ev.kind, ev.sequence,
+               ev.conversation, ev.chapter, ev.zone_id, ev.scene_id,
+               ev.speaker_id, ev.speaker_len, ev.body_len);
+        rc = msglog_next_offset(p, &p);
+    }
+}
+
+static void excluded_probe(unsigned long key) {
+    int begin;
+    int page;
+
+    begin = msgcap_scope_begin(key, 0, NULL);
+    msgcap_display(MSGCAP_DIALOG, key, 0, NULL);
+    page = msgcap_page(g_text, 0, 5, 0);
+    msgcap_scope_end();
+    printf("EX %lu %d %d\n", key, begin, page);
+}
+
+int main(void) {
+    MsgLogTime stamp;
+    int rc;
+    unsigned char long_name[67];
+
+    memset(&g_gameState, 0, sizeof(g_gameState));
+    g_gameState.nChapter = 3;
+    g_gameState.nZoneId = 9;
+    stamp.year = 2026;
+    stamp.month = 9;
+    stamp.day = 6;
+    stamp.hour = 15;
+    stamp.minute = 0;
+    stamp.second = 0;
+    stamp.hundredth = 0;
+    msglog_init();
+    msglog_set_scratch(g_scratch, sizeof(g_scratch));
+    rc = msglog_new_timeline("CAP.MLG", &stamp);
+    printf("NEW %d\n", rc);
+    msgcap_init();
+    printf("BEGIN %d\n", msgcap_scope_begin(1600006UL, 7, g_speaker));
+    msgcap_display(MSGCAP_DIALOG, 1600006UL, 7, g_speaker);
+    printf("PAGE1 %d\n", msgcap_page(g_text, 0, 5, 0));
+    printf("DUP1 %d\n", msgcap_page(g_text, 0, 5, 0));
+    printf("PAGE2 %d\n", msgcap_page(g_text, 6, 12, 1));
+    printf("BACK %d\n", msgcap_page(g_text, 0, 5, 0));
+    printf("CHOICE %d\n", msgcap_choice(1600006UL, g_choice, 0));
+    msgcap_scope_end();
+    printf("XBEGIN %d\n", msgcap_scope_begin(1800022UL, 7, g_speaker));
+    msgcap_display(MSGCAP_DIALOG, 1800022UL, 7, g_speaker);
+    printf("XPAGE %d\n", msgcap_page(g_text, 0, 5, 0));
+    printf("XCHOICE %d\n", msgcap_choice(1800022UL, g_choice, 0));
+    msgcap_scope_end();
+    excluded_probe(254UL);
+    excluded_probe(199UL);
+    excluded_probe(11UL);
+    msgcap_scene_enter(0x1301, 1300001UL, g_title);
+    printf("SCENE %d\n", msgcap_page(g_text, 0, 5, 0));
+    msgcap_scene_enter(0x1301, 1300001UL, g_title);
+    printf("SDUP %d\n", msgcap_page(g_text, 0, 5, 0));
+    msgcap_scene_leave();
+    dump();
+    printf("COUNT %lu\n", msglog_event_count());

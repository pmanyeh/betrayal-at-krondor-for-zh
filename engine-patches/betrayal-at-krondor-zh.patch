 # INCLUDE = the project headers (bak\INCLUDE); C:\BC\INCLUDE = the Borland RTL headers
-INC  = -IINCLUDE -IC:\BC\INCLUDE
+# The Traditional Chinese build keeps the 1.00 floppy packaging/runtime but
+# opts into the release-1.02 fixes that do not depend on MSCDEX or CD assets.
+INC  = -IINCLUDE -IC:\BC\INCLUDE -DV102_GAMEPLAY_FIXES
+# A v1.02 translation unit already selects every gameplay-fix branch through

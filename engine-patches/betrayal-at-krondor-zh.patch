new file mode 100644
index 0000000000000000000000000000000000000000..216f658201ed17dc73126a9034122b822031de2a
--- /dev/null
+++ b/bak/TOOLS/MLGTEST.C
@@ -0,0 +1,312 @@
+/**
+ * @file  MLGTEST.C
+ * @brief DOS-side conformance harness for the MSGLOG (.MLG v1) data core.
+ *
+ * @details Builds as a standalone real-mode tool from the same Borland C++ 3.1
+ *          medium-model toolchain as the game, linking the *unmodified*
+ *          SRC/DIALOG/MSGLOG.C plus OUT\DOSRW.OBJ.  It exists so the format can
+ *          be verified across languages for real: a fixture this tool writes is
+ *          parsed by tools/text/message_log.py, and fixtures that Python writes
+ *          (including deliberately corrupt ones) are fed back through the very
+ *          same C code the game will run.
+ *
+ *          Every command prints one plain-ASCII line per fact so a host-side
+ *          test can assert on it; strings are printed as uppercase hex because
+ *          the payload is BAK-ZH game bytes, not console text.
+ *
+ * Usage:
+ *   MLGTEST GEN  <out.mlg>          write the canonical scripted fixture
+ *   MLGTEST DUMP <in.mlg>           open as a working file and list every event
+ *   MLGTEST OPEN <in.mlg>           print only the msglog_open_working() code
+ *   MLGTEST CAND <in.mlg> <len> <crc>   print the msglog_load_candidate() code
+ *   MLGTEST SNAP <work.mlg> <out.mlg> <len> <crc>   snapshot a working file
+ *   MLGTEST ACT  <cand.mlg> <work.mlg>  load + activate a candidate, then list
+ *   MLGTEST SPLIT                   exercise msglog_split_point()
+ *   MLGTEST STATE                   exercise the state machine
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "SRC/DIALOG/MSGLOG.H"
+
+static unsigned char g_scratch[1024];
+static unsigned char g_speaker[MSGLOG_MAX_SPEAKER];
+static unsigned char g_location[MSGLOG_MAX_LOCATION];
+static unsigned char g_body[MSGLOG_MAX_BODY];
+static unsigned char g_long[601];
+
+/* "納馮" and "三山當鋪" in the BAK-ZH compact encoding. */
+static unsigned char g_zhSpeaker[4] = {0x84, 0x32, 0x96, 0x49};
+static unsigned char g_zhLocation[8] = {0x85, 0x43, 0x80, 0x24, 0x81, 0x34, 0x99, 0x3d};
+
+/* '"Hello!" ' + U+6F2B (trail 0x23 '#') + U+62B5 (trail 0x40 '@') + U+6578
+   (trail 0x23) + '#end@'. Proves a trail byte that looks like the title
+   delimiter or a token marker survives a byte-exact round trip. */
+static unsigned char g_zhBody[20] = {0x22, 0x48, 0x65, 0x6c, 0x6c, 0x6f, 0x21, 0x22, 0x20,
+                                     0x80, 0x23, 0x80, 0x40, 0x81, 0x23,
+                                     0x23, 0x65, 0x6e, 0x64, 0x40};
+
+/* U+62B5 + U+812B: a short two-glyph choice label. */
+static unsigned char g_zhChoice[4] = {0x80, 0x40, 0x82, 0x23};
+
+static void mlgtest_set_time(MsgLogTime *t, unsigned short y, int mo, int d, int h, int mi, int s,
+                             int hs) {
+    t->year = y;
+    t->month = (unsigned char)mo;
+    t->day = (unsigned char)d;
+    t->hour = (unsigned char)h;
+    t->minute = (unsigned char)mi;
+    t->second = (unsigned char)s;
+    t->hundredth = (unsigned char)hs;
+}
+
+static void mlgtest_print_hex(const char *label, const unsigned char *p, unsigned int n) {
+    unsigned int i;
+    printf("%s ", label);
+    for (i = 0; i < n; i++)
+        printf("%02X", p[i]);
+    printf("\n");
+}
+
+static void mlgtest_story_context(MsgLogContext *ctx) {
+    memset(ctx, 0, sizeof(MsgLogContext));
+    ctx->chapter = 1;
+    ctx->zone_id = 9;
+    ctx->scene_id = 7;
+    ctx->speaker_id = 7;
+    ctx->source_key = 1600006UL;
+    ctx->source_file = 16;
+    ctx->flags = 0;
+    ctx->speaker = g_zhSpeaker;
+    ctx->speaker_len = 4;
+    ctx->location = g_zhLocation;
+    ctx->location_len = 8;
+}
+
+static int mlgtest_gen(const char *path) {
+    MsgLogContext ctx;
+    MsgLogTime now;
+    int rc;
+    int i;
+
+    msglog_init();
+    msglog_set_scratch(g_scratch, sizeof(g_scratch));
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 7, 25);
+    rc = msglog_new_timeline(path, &now);
+    printf("GEN new_timeline=%d\n", rc);
+    if (rc != MSGLOG_OK)
+        return 1;
+
+    mlgtest_story_context(&ctx);
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 8, 0);
+    printf("GEN conv_begin=%d\n", msglog_conv_begin(&ctx, &now));
+
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 9, 10);
+    printf("GEN append_span=%d\n", msglog_append_span(&ctx, &now, g_zhBody, 20));
+
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 10, 20);
+    printf("GEN append_choice=%d\n", msglog_append_choice(&ctx, &now, g_zhChoice, 4));
+
+    /* 'A' followed by 300 double-byte glyphs = 601 bytes. A naive 512-byte cut
+       would land between the lead and trail of the glyph at bytes 511/512, so
+       the first fragment must come out 511 bytes long, not 512. */
+    g_long[0] = 0x41;
+    for (i = 0; i < 300; i++) {
+        g_long[1 + i * 2] = 0x80;
+        g_long[2 + i * 2] = 0x23;
+    }
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 11, 30);
+    printf("GEN append_long=%d\n", msglog_append_span(&ctx, &now, g_long, 601));
+
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 12, 40);
+    printf("GEN append_gap=%d\n", msglog_append_gap(&now));
+
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 13, 50);
+    printf("GEN conv_end=%d\n", msglog_conv_end(&now));
+
+    printf("GEN events=%lu\n", msglog_event_count());
+    printf("GEN shutdown=%d\n", msglog_shutdown());
+    return 0;
+}
+
+static void mlgtest_list(void) {
+    MsgLogEvent ev;
+    long off;
+    int rc;
+
+    printf("LIST events=%lu flags=%04X\n", msglog_event_count(), msglog_header_flags());
+    rc = msglog_first_offset(&off);
+    if (rc != MSGLOG_OK) {
+        printf("LIST first=%d\n", rc);
+        return;
+    }
+    for (;;) {
+        rc = msglog_read_event(off, &ev, g_speaker, sizeof(g_speaker), g_location,
+                               sizeof(g_location), g_body, sizeof(g_body));
+        if (rc != MSGLOG_OK) {
+            printf("EV off=%ld read=%d\n", off, rc);
+            return;
+        }
+        printf("EV off=%ld len=%lu kind=%u flags=%04X seq=%lu conv=%lu prev=%lu\n", ev.offset,
+               ev.record_length, ev.kind, ev.flags, ev.sequence, ev.conversation, ev.prev_offset);
+        printf("   when=%04u-%02u-%02u %02u:%02u:%02u.%02u ch=%u zone=%u scene=%u spk=%u "
+               "key=%lu file=%u frag=%u\n",
+               ev.when.year, ev.when.month, ev.when.day, ev.when.hour, ev.when.minute,
+               ev.when.second, ev.when.hundredth, ev.chapter, ev.zone_id, ev.scene_id,
+               ev.speaker_id, ev.source_key, ev.source_file, ev.fragment_index);
+        mlgtest_print_hex("   SPK", g_speaker, ev.speaker_len);
+        mlgtest_print_hex("   LOC", g_location, ev.location_len);
+        mlgtest_print_hex("   BOD", g_body, ev.body_len);
+        rc = msglog_next_offset(off, &off);
+        if (rc != MSGLOG_OK) {
+            printf("LIST end=%d\n", rc);
+            break;
+        }
+    }
+    /* Walk back with prev_offset to prove the reverse chain the pager uses. */
+    rc = msglog_last_offset(&off);
+    printf("BACK start=%d off=%ld\n", rc, (rc == MSGLOG_OK) ? off : -1L);
+    while (rc == MSGLOG_OK) {
+        rc = msglog_prev_offset(off, &off);
+        if (rc == MSGLOG_OK)
+            printf("BACK off=%ld\n", off);
+    }
+    printf("BACK end=%d\n", rc);
+}
+
+static int mlgtest_dump(const char *path) {
+    int rc;
+
+    msglog_init();
+    msglog_set_scratch(g_scratch, sizeof(g_scratch));
+    rc = msglog_open_working(path);
+    printf("DUMP open=%d state=%d\n", rc, msglog_state());
+    if (rc != MSGLOG_OK)
+        return 1;
+    mlgtest_list();
+    msglog_shutdown();
+    return 0;
+}
+
+static int mlgtest_open(const char *path) {
+    int rc;
+
+    msglog_init();
+    msglog_set_scratch(g_scratch, sizeof(g_scratch));
+    rc = msglog_open_working(path);
+    printf("OPEN rc=%d committed_events=%lu\n", rc, msglog_event_count());
+    if (rc == MSGLOG_OK)
+        msglog_shutdown();
+    return 0;
+}
+
+static int mlgtest_cand(const char *path, unsigned long len, unsigned long crc) {
+    int rc;
+
+    msglog_init();
+    msglog_set_scratch(g_scratch, sizeof(g_scratch));
+    rc = msglog_load_candidate(path, len, crc);
+    printf("CAND rc=%d\n", rc);
+    msglog_discard_candidate();
+    return 0;
+}
+
+static int mlgtest_snap(const char *work, const char *out, unsigned long len, unsigned long crc) {
+    int rc;
+
+    msglog_init();
+    msglog_set_scratch(g_scratch, sizeof(g_scratch));
+    rc = msglog_open_working(work);
+    printf("SNAP open=%d\n", rc);
+    if (rc != MSGLOG_OK)
+        return 1;
+    rc = msglog_prepare_snapshot(out, len, crc);
+    printf("SNAP prepare=%d\n", rc);
+    msglog_shutdown();
+    return 0;
+}
+
+static int mlgtest_act(const char *cand, const char *work) {
+    int rc;
+
+    msglog_init();
+    msglog_set_scratch(g_scratch, sizeof(g_scratch));
+    rc = msglog_load_candidate(cand, 0UL, 0UL);
+    printf("ACT load=%d\n", rc);
+    if (rc != MSGLOG_OK)
+        return 1;
+    rc = msglog_activate_candidate(work);
+    printf("ACT activate=%d state=%d\n", rc, msglog_state());
+    if (rc != MSGLOG_OK)
+        return 1;
+    mlgtest_list();
+    msglog_shutdown();
+    return 0;
+}
+
+static int mlgtest_split(void) {
+    static unsigned char a[8] = {0x41, 0x42, 0x80, 0x23, 0x80, 0x40, 0x43, 0x44};
+    int i;
+
+    for (i = 0; i <= 8; i++)
+        printf("SPLIT limit=%d cut=%u\n", i, msglog_split_point(a, 8, (unsigned int)i));
+    printf("SPLIT lead_only cut=%u\n", msglog_split_point(a + 2, 6, 1));
+    return 0;
+}
+
+static int mlgtest_state(void) {
+    MsgLogTime now;
+
+    mlgtest_set_time(&now, 2026, 9, 6, 13, 45, 7, 25);
+    msglog_init();
+    printf("ST init base=%d state=%d rec=%d\n", msglog_base_state(), msglog_state(),
+           msglog_recording_enabled());
+    msglog_enter_transition();
+    printf("ST transition state=%d rec=%d\n", msglog_state(), msglog_recording_enabled());
+    msglog_enter_viewer();
+    printf("ST viewer state=%d rec=%d\n", msglog_state(), msglog_recording_enabled());
+    msglog_leave_viewer();
+    msglog_leave_transition();
+    printf("ST restored base=%d state=%d\n", msglog_base_state(), msglog_state());
+
+    /* Drive the module into recording-failed, then prove a viewer visit cannot
+       launder it back into active on the way out. */
+    printf("ST bad_new=%d\n", msglog_new_timeline("Z:\\NOSUCH\\X.MLG", &now));
+    printf("ST failed base=%d state=%d rec=%d\n", msglog_base_state(), msglog_state(),
+           msglog_recording_enabled());
+    msglog_enter_viewer();
+    printf("ST failed_in_viewer state=%d rec=%d\n", msglog_state(), msglog_recording_enabled());
+    msglog_leave_viewer();
+    printf("ST failed_after_viewer base=%d state=%d rec=%d\n", msglog_base_state(), msglog_state(),
+           msglog_recording_enabled());
+    printf("ST gap_when_failed=%d\n", msglog_append_gap(&now));
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) {
+        printf("MLGTEST: no command\n");
+        return 2;
+    }
+    if (strcmp(argv[1], "GEN") == 0 && argc >= 3)
+        return mlgtest_gen(argv[2]);
+    if (strcmp(argv[1], "DUMP") == 0 && argc >= 3)
+        return mlgtest_dump(argv[2]);
+    if (strcmp(argv[1], "OPEN") == 0 && argc >= 3)
+        return mlgtest_open(argv[2]);
+    if (strcmp(argv[1], "CAND") == 0 && argc >= 5)
+        return mlgtest_cand(argv[2], strtoul(argv[3], NULL, 10), strtoul(argv[4], NULL, 16));
+    if (strcmp(argv[1], "SNAP") == 0 && argc >= 6)
+        return mlgtest_snap(argv[2], argv[3], strtoul(argv[4], NULL, 10),
+                            strtoul(argv[5], NULL, 16));
+    if (strcmp(argv[1], "ACT") == 0 && argc >= 4)
+        return mlgtest_act(argv[2], argv[3]);
+    if (strcmp(argv[1], "SPLIT") == 0)
+        return mlgtest_split();
+    if (strcmp(argv[1], "STATE") == 0)
+        return mlgtest_state();
+    printf("MLGTEST: bad command %s\n", argv[1]);
+    return 2;
+}
diff --git a/bak/TOOLS/MSGPTEST.C b/bak/TOOLS/MSGPTEST.C
new file mode 100644
index 0000000000000000000000000000000000000000..0ff3bf462da536247efe5a3f94eb800e4acb2cd8
--- /dev/null
+++ b/bak/TOOLS/MSGPTEST.C
@@ -0,0 +1,273 @@
+#include <stdio.h>
+#include <string.h>
+#include <io.h>
+#include <dir.h>
+#include <alloc.h>
+
+#define MSGSAVE_TEST
+#include "SRC/DIALOG/MSGLOG.H"
+#include "SRC/DIALOG/MSGSAVE.H"
+#include "SRC/GAME/STATE/GSTATE.H"
+#include "SRC/IO/DOSRW.H"
+
+/* Only this test translation unit redirects I/O. Release code is unchanged.
+   A close fault closes the handle and reports failure (e.g. delayed flush). */
+static int fault_stage, fault_op, fault_hit;
+static int should_fail(int op) {
+    if (!fault_hit && fault_op == op && fault_stage == g_msgsaveTestStage) {
+        fault_hit = 1;
+        return 1;
+    }
+    return 0;
+}
+static int test_write(int fd, const void *p, unsigned n) {
+    if (should_fail(1))
+        return n > 1 ? write(fd, p, n / 2) : -1;
+    return write(fd, p, n);
+}
+static int test_close(int fd) {
+    int fail = should_fail(2);
+    int rc = close(fd);
+    return fail ? -1 : rc;
+}
+static long far test_dos_write(unsigned char far *p, long n, int fd) {
+    if (should_fail(3))
+        return dos_write(p, n / 2, fd);
+    return dos_write(p, n, fd);
+}
+static int test_rename(const char *a, const char *b) {
+    return should_fail(4) ? -1 : rename(a, b);
+}
+static int test_remove(const char *p) {
+    return should_fail(5) ? -1 : remove(p);
+}
+#define write test_write
+#define close test_close
+#define dos_write test_dos_write
+#define rename test_rename
+#define remove test_remove
+
+int g_cfgTempDrive = 0;
+static int g_saveSerial = 0;
+
+void far *alloc_far_umb(unsigned long size) {
+    return farmalloc(size);
+}
+
+int _freemem(void far *p) {
+    farfree(p);
+    return 0;
+}
+
+int far savegame_write(char *path) {
+    unsigned char b[1024];
+    long remaining;
+    int chunk;
+    int fd;
+    int i;
+    g_saveSerial++;
+    for (i = 0; i < sizeof(b); i++)
+        b[i] = (unsigned char)(g_saveSerial * 17 + i);
+    b[98] = 0x16; b[99] = 0;
+    fd = open(path, 0x8302, 0x0180);
+    if (fd < 0)
+        return 0;
+    remaining = GAM_SAVE_FILE_BASE_SIZE;
+    while (remaining > 0) {
+        chunk = remaining > sizeof(b) ? sizeof(b) : (int)remaining;
+        if (write(fd, b, chunk) != chunk) {
+            close(fd); return 0;
+        }
+        remaining -= chunk;
+        b[98] = (unsigned char)(g_saveSerial * 17 + 98);
+        b[99] = (unsigned char)(g_saveSerial * 17 + 99);
+    }
+    return close(fd) == 0;
+}
+
+static void clean(void) {
+    remove("PAIR\\SAVE01.GAM"); remove("PAIR\\SAVE01.MLG");
+    remove("PAIR\\SAVE02.GAM"); remove("PAIR\\SAVE02.MLG");
+    remove("PAIR\\SAVE03.GAM"); remove("PAIR\\SAVE03.MLG");
+    remove("PAIR\\MLGNEW.GAM"); remove("PAIR\\MLGNEW.MLG");
+    remove("PAIR\\MLGOLD.GAM"); remove("PAIR\\MLGOLD.MLG"); remove("PAIR\\MLGTXN.DAT");
+    remove("MSGWORK.MLG");
+}
+
+static int files_equal(const char *a, const char *b) {
+    unsigned char ba[512];
+    unsigned char bb[512];
+    int fa;
+    int fb;
+    int na;
+    int nb;
+    int eq;
+    fa = open((char *)a, 0x8001);
+    fb = open((char *)b, 0x8001);
+    if (fa < 0 || fb < 0) {
+        if (fa >= 0) close(fa);
+        if (fb >= 0) close(fb);
+        return 0;
+    }
+    eq = filelength(fa) == filelength(fb);
+    while (eq) {
+        na = read(fa, ba, sizeof(ba));
+        nb = read(fb, bb, sizeof(bb));
+        if (na != nb || na < 0 || (na > 0 && memcmp(ba, bb, na) != 0))
+            eq = 0;
+        if (na <= 0)
+            break;
+    }
+    close(fa); close(fb);
+    return eq;
+}
+
+int main(void) {
+    MsgLogTime t;
+    int p;
+    int f;
+    int crash;
+    int again;
+    unsigned long old_count;
+    int test;
+    int failed = 0;
+    static int stages[] = {2, 2, 5, 5, 5, 7, 7, 8, 10, 11, 12};
+    static int ops[] =    {1, 2, 1, 2, 3, 1, 2, 4,  4,  4,  5};
+    clean(); mkdir("PAIR");
+    msgsave_init();
+    printf("NEW %d\n", msgsave_start_new());
+    memset(&t, 0, sizeof(t)); t.year = 2026; t.month = 9; t.day = 6;
+    printf("AAPP %d\n", msglog_append_gap(&t));
+    printf("ASAVE %d\n", msgsave_write_pair("PAIR\\SAVE01.GAM"));
+    t.second = 1;
+    printf("BAPP %d\n", msglog_append_gap(&t));
+    printf("BSAVE %d\n", msgsave_write_pair("PAIR\\SAVE02.GAM"));
+    p = msgsave_prepare_load("PAIR\\SAVE01.GAM");
+    f = msgsave_finish_load(1);
+    printf("ALOAD prep=%d finish=%d count=%lu\n", p, f, msglog_event_count());
+    remove("PAIR\\SAVE02.GAM"); remove("PAIR\\SAVE02.MLG");
+    t.second = 2;
+    printf("CAPP %d\n", msglog_append_gap(&t));
+    f = msgsave_write_pair("PAIR\\SAVE03.GAM");
+    printf("CSAVE %d count=%lu err=%d newg=%d newm=%d txn=%d\n", f, msglog_event_count(),
+           g_msgsaveTestStage, access("PAIR\\MLGNEW.GAM", 0), access("PAIR\\MLGNEW.MLG", 0),
+           access("PAIR\\MLGTXN.DAT", 0));
+    remove("PAIR\\SAVE03.GAM"); remove("PAIR\\SAVE03.MLG");
+    /* Full-mode stage 9 (target MLG -> MLGOLD.MLG) rename fault. SAVE04.MLG is
+       not a valid prefix of the live timeline, so the overwrite cannot extend
+       it and takes the full path -- the only path that renames the target MLG
+       at stage 9. Placed here, after the earlier slots are freed, so the
+       synthetic GAM still fits the small build image. */
+    {
+        int jd = open("PAIR\\SAVE04.MLG", 0x8302, 0x0180);
+        write(jd, "not-an-mlg", 9);
+        close(jd);
+    }
+    fault_stage = 9; fault_op = 4; fault_hit = 0;
+    f = msgsave_write_pair("PAIR\\SAVE04.GAM");
+    fault_op = 0;
+    p = msgsave_recover_for("PAIR\\SAVE04.GAM");
+    again = msgsave_recover_for("PAIR\\SAVE04.GAM");
+    if (f || !fault_hit || !p || !again) failed++;
+    printf("FULL9 hit=%d save=%d recover=%d again=%d\n", fault_hit, f, p, again);
+    remove("PAIR\\SAVE04.GAM"); remove("PAIR\\SAVE04.MLG");
+    printf("AOVER %d\n", msgsave_write_pair("PAIR\\SAVE01.GAM"));
+    /* AOVER extended SAVE01 in place. A full snapshot of the same timeline bound
+       to the same GAM must be byte-for-byte identical. */
+    {
+        unsigned char far *sb;
+        unsigned long gl;
+        unsigned long gc;
+        int e1;
+        int e2;
+        int e3;
+        e1 = e2 = e3 = 0;
+        sb = (unsigned char far *)farmalloc(4096UL);
+        if (sb != (unsigned char far *)0) {
+            msglog_set_scratch(sb, 4096);
+            e1 = msglog_crc32_file("PAIR\\SAVE01.GAM", &gl, &gc) == 0;
+            e2 = e1 && msglog_prepare_snapshot("PAIR\\EQUIV.MLG", gl, gc) == 0;
+            msglog_set_scratch((unsigned char far *)0, 0);
+            farfree(sb);
+        }
+        e3 = files_equal("PAIR\\SAVE01.MLG", "PAIR\\EQUIV.MLG");
+        remove("PAIR\\EQUIV.MLG");
+        if (!e1 || !e2 || !e3) failed++;
+        printf("EQUIV crc=%d full=%d identical=%d\n", e1, e2, e3);
+    }
+    old_count = msglog_event_count();
+    for (crash = 7; crash <= 11; crash++) {
+        t.second++;
+        msglog_append_gap(&t);
+        g_msgsaveTestCrashAfter = crash;
+        f = msgsave_write_pair("PAIR\\SAVE01.GAM");
+        g_msgsaveTestCrashAfter = 0;
+        p = msgsave_recover_for("PAIR\\SAVE01.GAM");
+        again = msgsave_recover_for("PAIR\\SAVE01.GAM");
+        msgsave_prepare_load("PAIR\\SAVE01.GAM");
+        msgsave_finish_load(1);
+        if (crash == 11)
+            old_count++;
+        printf("CRASH step=%d save=%d recover=%d again=%d count=%lu expect=%lu\n", crash, f, p,
+               again, msglog_event_count(), old_count);
+    }
+    for (test = 0; test < sizeof(stages) / sizeof(stages[0]); test++) {
+        old_count = msglog_event_count();
+        msglog_append_gap(&t);
+        fault_stage = stages[test]; fault_op = ops[test]; fault_hit = 0;
+        f = msgsave_write_pair("PAIR\\SAVE01.GAM");
+        fault_op = 0;
+        p = msgsave_recover_for("PAIR\\SAVE01.GAM");
+        again = msgsave_recover_for("PAIR\\SAVE01.GAM");
+        if (stages[test] == 12) old_count++;
+        if (f || !fault_hit || !p || !again ||
+            !msgsave_prepare_load("PAIR\\SAVE01.GAM") || !msgsave_finish_load(1) ||
+            msglog_event_count() != old_count) failed++;
+        printf("IOFAULT stage=%d op=%d hit=%d save=%d recover=%d again=%d count=%lu expected=%lu\n",
+               stages[test], ops[test], fault_hit, f, p, again, msglog_event_count(), old_count);
+    }
+    /* A second save after failed recovery must preserve the only old GAM. */
+    msglog_append_gap(&t);
+    g_msgsaveTestCrashAfter = 10;
+    msgsave_write_pair("PAIR\\SAVE01.GAM");
+    g_msgsaveTestCrashAfter = 0;
+    fault_stage = g_msgsaveTestStage; fault_op = 4; fault_hit = 0;
+    f = msgsave_write_pair("PAIR\\SAVE01.GAM");
+    fault_op = 0;
+    if (f || !fault_hit || access("PAIR\\MLGOLD.GAM", 0) || access("PAIR\\MLGTXN.DAT", 0))
+        failed++;
+    p = msgsave_recover_for("PAIR\\SAVE01.GAM");
+    if (!p || !msgsave_recover_for("PAIR\\SAVE01.GAM") ||
+        !msgsave_prepare_load("PAIR\\SAVE01.GAM") || !msgsave_finish_load(1) ||
+        msglog_event_count() != old_count) failed++;
+    printf("RECOVERY_RETRY failures=%d\n", failed);
+    remove("PAIR\\SAVE01.MLG");
+    p = msgsave_prepare_load("PAIR\\SAVE01.GAM");
+    f = msgsave_finish_load(1);
+    printf("MISS prep=%d finish=%d count=%lu flags=%u\n", p, f, msglog_event_count(),
+           msglog_header_flags());
+    t.second++;
+    msglog_append_gap(&t);
+    g_msgsaveTestCrashAfter = 8;
+    f = msgsave_write_pair("PAIR\\SAVE01.GAM");
+    g_msgsaveTestCrashAfter = 0;
+    p = msgsave_recover_for("PAIR\\SAVE01.GAM");
+    printf("GAMONLY save=%d recover=%d gam=%d mlg=%d\n", f, p,
+           access("PAIR\\SAVE01.GAM", 0), access("PAIR\\SAVE01.MLG", 0));
+    {
+        unsigned char bad[5] = {'B', 'A', 'D', '!', 1};
+        int fd = open("PAIR\\MLGTXN.DAT", 0x8302, 0x0180);
+        write(fd, bad, sizeof(bad));
+        close(fd);
+    }
+    p = msgsave_recover_for("PAIR\\SAVE01.GAM");
+    printf("BADMARK recover=%d gam=%d mark=%d\n", p, access("PAIR\\SAVE01.GAM", 0),
+           access("PAIR\\MLGTXN.DAT", 0));
+    remove("PAIR\\MLGTXN.DAT");
+    msgsave_shutdown();
+    printf("FAULT_MATRIX failures=%d\n", failed);
+    return failed != 0;
+}
+
+#include "SRC/DIALOG/MSGLOG.C"
+#include "SRC/DIALOG/MSGSAVE.C"

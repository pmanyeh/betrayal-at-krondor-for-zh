diff --git a/bak/TOOLS/MLGBENCH.C b/bak/TOOLS/MLGBENCH.C
new file mode 100644
index 0000000000000000000000000000000000000000..acb95f70cbed5ee97bd574927b74a81ee489f801
--- /dev/null
+++ b/bak/TOOLS/MLGBENCH.C
@@ -0,0 +1,62 @@
+/* Standalone DOS capacity probe. Synthetic input only; never run in GAMES.
+   Reports core I/O costs, not game rendering or the GAM serializer. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <dos.h>
+#include <alloc.h>
+#include "SRC/DIALOG/MSGLOG.H"
+
+static unsigned long ticks(void) {
+    struct time t;
+    gettime(&t);
+    return ((unsigned long)t.ti_hour * 3600UL + (unsigned long)t.ti_min * 60UL +
+            t.ti_sec) * 100UL + t.ti_hund;
+}
+static unsigned long millis(unsigned long start) {
+    unsigned long end = ticks();
+    if (end < start) end += 8640000UL;
+    return (end - start) * 10UL;
+}
+
+int main(int argc, char **argv) {
+    unsigned char far *scratch;
+    unsigned char body[513], who[65], where[65];
+    MsgLogEvent ev;
+    unsigned long before, after, opened, read_ms, save_ms, load_ms;
+    unsigned long start;
+    long offset;
+    int rc, i;
+    if (argc != 2) return 2;
+    before = farcoreleft();
+    scratch = farmalloc(2048UL);
+    if (!scratch) return 3;
+    msglog_init(); msglog_set_scratch(scratch, 2048);
+    start = ticks();
+    rc = msglog_open_working(argv[1]);
+    opened = millis(start);
+    if (rc) { printf("OPEN_ERROR %d\n", rc); return 4; }
+    start = ticks();
+    msglog_last_offset(&offset);
+    for (i = 0; i < 30 && rc == MSGLOG_OK; i++) {
+        rc = msglog_read_event(offset, &ev, who, 64, where, 64, body, 512);
+        if (rc == MSGLOG_OK) rc = msglog_prev_offset(offset, &offset);
+    }
+    read_ms = millis(start);
+    if (rc) { printf("READ_ERROR %d\n", rc); return 5; }
+    start = ticks();
+    rc = msglog_prepare_snapshot("BENCH.MLG", 100UL, 123UL);
+    save_ms = millis(start);
+    if (rc) { printf("SAVE_ERROR %d\n", rc); return 6; }
+    start = ticks();
+    rc = msglog_load_candidate("BENCH.MLG", 100UL, 123UL);
+    load_ms = millis(start);
+    if (rc) { printf("LOAD_ERROR %d\n", rc); return 7; }
+    msglog_discard_candidate();
+    printf("BENCH %s events=%lu open_ms=%lu read30_ms=%lu snapshot_ms=%lu validate_ms=%lu scratch=2048 free_before=%lu\n",
+           argv[1], msglog_event_count(), opened, read_ms, save_ms, load_ms, before);
+    msglog_shutdown(); msglog_set_scratch(NULL, 0); farfree(scratch);
+    after = farcoreleft();
+    printf("FREE_AFTER %lu delta=%ld\n", after, (long)after - (long)before);
+    remove("BENCH.MLG");
+    return 0;
+}

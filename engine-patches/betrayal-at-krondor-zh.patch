+    glyph_ptr = (unsigned char far *)0L;
+    if (FP_SEG(g_pZhFontSmallBitmap) == 0) {
+        /* ZHSTAT currently fits within the four contiguous 16K EMS page-frame
+           slots mapped by ems_map_at_offset(), so all 22-byte records remain
+           directly searchable even when one straddles a logical page. */
+        entry = ems_map_at_offset(FP_OFF(g_pZhFontSmallBitmap), 0L);
+    } else {
+        entry = g_pZhFontSmallBitmap;
+    }
+    for (i = 0; i < g_nZhFontSmallCount; i++) {
+        entry_gid = *(unsigned short far *)entry;
+        if (entry_gid == gid) {
+            glyph_ptr = entry + 2;
+            break;
+        }
+        entry += 22;
+    }
+    if (glyph_ptr == (unsigned char far *)0L) {
+        return 10;
+    }
+
+    row = 0;
